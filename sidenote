#!/usr/bin/env bash
# Sidenote control script: the one command to remember. Run `./sidenote help`.
# The server runs in a container (docker compose); the screen/sound capture client is a
# Windows program, started from here through WSL interop. It runs windowless with a tray icon and
# is ended from that icon or with `./sidenote capture-stop`; with --console it stays in the
# terminal and Ctrl+C ends it.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

# Settings in .env apply here too (compose reads the same file); the environment wins. Read the
# way compose reads it: an "export " prefix, quotes, and a " # comment" after an unquoted value.
dotenv() {
  [ -f .env ] || return 0
  local v
  v="$(grep -E "^[[:space:]]*(export[[:space:]]+)?$1[[:space:]]*=" .env | tail -1 | tr -d '\r')" || true
  [ -n "$v" ] || return 0
  v="${v#*=}"; v="${v#"${v%%[![:space:]]*}"}"
  case "$v" in
    \"*) v="${v#\"}"; v="${v%%\"*}" ;;
    \'*) v="${v#\'}"; v="${v%%\'*}" ;;
    *) v="${v%%[[:space:]]#*}"; v="${v%"${v##*[![:space:]]}"}" ;;
  esac
  printf '%s' "$v"
}
setting() { local v="${!1:-}"; [ -n "$v" ] || v="$(dotenv "$1")"; printf '%s' "${v:-$2}"; }
PORT="$(setting SIDENOTE_PORT 8777)"
URL="http://127.0.0.1:${PORT}"
LOG_PATH="$(setting SIDENOTE_LOG_PATH "$HOME/.local/state/sidenote/logs")"
LOG_MAX_MB="$(setting SIDENOTE_LOG_MAX_MB 5)"    # same caps as the server's own logs (server/telemetry.py)
LOG_FILES="$(setting SIDENOTE_LOG_FILES 4)"
LOG_MAX_MB="${LOG_MAX_MB%%.*}"   # whole MB here (bash arithmetic); at least 1 file of 1 MB, like the server
[[ $LOG_MAX_MB =~ ^[0-9]+$ ]] || LOG_MAX_MB=5; (( LOG_MAX_MB >= 1 )) || LOG_MAX_MB=1
LOG_FILES="${LOG_FILES%%.*}"; [[ $LOG_FILES =~ ^[0-9]+$ ]] || LOG_FILES=4; (( LOG_FILES >= 1 )) || LOG_FILES=1
# Who solves, read the way the server reads it (server/config.py), so the two always agree on whether the local
# model's containers are needed: case and the spaces around it do not matter, "claude" means the API, and an empty
# or unknown value runs as "local" (the server says so in its log). Compared as it was typed,
# SIDENOTE_ANALYZER=Local ran the server in local mode while the "local" profile below stayed off, so the local
# model and its web search were never started and every answer said the local model did not respond.
ANALYZER="$(setting SIDENOTE_ANALYZER local | tr '[:upper:]' '[:lower:]')"
ANALYZER="${ANALYZER#"${ANALYZER%%[![:space:]]*}"}"   # the leading spaces off
ANALYZER="${ANALYZER%"${ANALYZER##*[![:space:]]}"}"   # and the trailing ones
case "$ANALYZER" in
  local|agent|cli|api|mock) ;;   # the ones the server knows ("cli" and "api" are the agent alone, as "agent" is)
  claude) ANALYZER=api ;;        # its old name for the API
  *) ANALYZER=local ;;           # anything else, as the server does
esac
# The cloud agent, read the way the server reads it (server/config.py): SIDENOTE_AGENT, else SIDENOTE_CLAUDE, its
# earlier name, else the one the analyzer mode implies.
AGENT="$(setting SIDENOTE_AGENT "$(setting SIDENOTE_CLAUDE "")" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
case "$AGENT" in
  claude-code|codex|anthropic-api|off|mock) ;;
  cli|claude|claude-cli) AGENT=claude-code ;;
  api) AGENT=anthropic-api ;;
  "") case "$ANALYZER" in api|claude) AGENT=anthropic-api ;; mock) AGENT=mock ;; *) AGENT=claude-code ;; esac ;;
  *) AGENT=claude-code ;;
esac
# The GPU the local model gets picks compose.yaml's companion file: compose.nvidia.yaml, compose.amd.yaml, or
# compose.cpu.yaml when there is neither (server/hardware.py finds it). docker compose reads COMPOSE_FILE itself, so one
# set in the environment or in .env stays as it is; otherwise the one found here is exported for every compose command.
gpu_vendor() {
  python3 - <<'PY' 2>/dev/null || echo cpu
import sys
sys.path.insert(0, "server")
import hardware
gpu = hardware.best(hardware.detect())
print(gpu.vendor if gpu and gpu.vendor in ("nvidia", "amd") else "cpu")
PY
}
COMPOSE_FILE="$(setting COMPOSE_FILE "")"
[ -n "$COMPOSE_FILE" ] || COMPOSE_FILE="compose.yaml:compose.$(gpu_vendor).yaml"
export COMPOSE_FILE
LOCAL_MODEL="$(setting SIDENOTE_LOCAL_MODEL auto)"            # auto: the largest measured model that fits the GPU
BUSY_MODEL="$(setting SIDENOTE_LOCAL_BUSY_MODEL auto)"         # for while the GPU is busy; auto: the model's smaller one
# The models `llm pull` fetches when none are named: the ones set, or for "auto" the largest measured model that fits
# this machine's GPU and its smaller one (server/models.py reads the profiles, server/hardware.py the GPU). Nothing
# when no NVIDIA or AMD GPU has room for the smallest: the cloud agent then solves every problem.
models_to_pull() {
  python3 - "$LOCAL_MODEL" "$BUSY_MODEL" <<'PY'
import sys
sys.path.insert(0, "server")
import hardware, models
main, busy = sys.argv[1], sys.argv[2]
if main == "auto":
    gpu = hardware.best(hardware.detect())
    fit = models.fits(gpu.memory_gb) if gpu else None
    main = fit.name if fit else ""
names = models.wanted(main)[:1] if main else []
if main and busy == "auto":
    names += models.wanted(main)[1:]
elif main and busy:
    names.append(busy)
print("\n".join(names))
PY
}
# The local LLM and its web search belong to the "local" compose profile: every compose command here
# (up, down, ps, logs) includes them in local mode, so down also frees the GPU.
if [ "$ANALYZER" = local ]; then export COMPOSE_PROFILES="${COMPOSE_PROFILES:+$COMPOSE_PROFILES,}local"; fi
CLIENT_WIN="$(wslpath -w "$PWD/client/capture.py" 2>/dev/null || true)"   # this checkout's client, by full path
# On WSL the capture program, the browser and the desktop shortcut are Windows' own, reached through interop. On a Linux
# desktop of its own (no WSL_DISTRO_NAME, which WSL sets in every session) they are this desktop's: the capture program
# runs here, with the packages of client/requirements.txt in a virtual environment of its own (CAPTURE_VENV).
if [ -n "${WSL_DISTRO_NAME:-}" ]; then ON_WSL=1; else ON_WSL=0; fi
CAPTURE_VENV="$PWD/.venv-capture"
# Docker refuses a CPU limit above the machine's cores, and the server would not start on a 6-core WSL: the defaults come
# down to what is there. What .env or the environment sets is left as it is.
CORES="$(nproc 2>/dev/null || echo 8)"
if [ "$CORES" -lt 8 ]; then
  export SIDENOTE_CPUS="$(setting SIDENOTE_CPUS "$CORES")" SIDENOTE_LLM_CPUS="$(setting SIDENOTE_LLM_CPUS "$CORES")"
fi

# The language of every word printed here: SIDENOTE_LANG (en or ko, from the environment or .env, as the server reads
# it), else Korean when the locale is Korean (the first of LC_ALL, LC_MESSAGES and LANG that is set, the order the C
# library reads them in), else English. A SIDENOTE_LANG that is set is handed on to the Windows programs started from
# here through WSLENV, so the capture program speaks it too (otherwise it follows Windows' own language).
UI_LANG="$(setting SIDENOTE_LANG "" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
case "$UI_LANG" in
  en|ko) export SIDENOTE_LANG="$UI_LANG" WSLENV="SIDENOTE_LANG${WSLENV:+:$WSLENV}" ;;
  *) case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in ko*|KO*) UI_LANG=ko ;; *) UI_LANG=en ;; esac ;;
esac
# Every message is written once in both languages, English first: `L "Server stopped." "서버를 멈췄습니다."` prints
# the one UI_LANG picks. Functions cut out of this file by the tests need it defined as well (tests/ci_gate.py).
L() { if [ "$UI_LANG" = ko ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

if [ -t 1 ]; then B=$'\e[1m'; G=$'\e[32m'; R=$'\e[31m'; Y=$'\e[33m'; D=$'\e[2m'; N=$'\e[0m'
else B='' G='' R='' Y='' D='' N=''; fi
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
FAILS=0   # ✗ lines printed so far (doctor fails when there is any)
bad()  { printf '  %s✗%s %s\n' "$R" "$N" "$*"; FAILS=$((FAILS + 1)); }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*"; }
die()  { printf '%s%s%s\n' "$R" "$*" "$N" >&2; exit 1; }
# The capture program can run in a terminal window of its own (--console, or `capture --up` from an older desktop
# shortcut, which opened one), and the title bar is all that window says about itself.
# An empty name puts the terminal's own title back. With no terminal (the shortcut now) it does nothing.
term_title() { [ -t 1 ] && printf '\033]0;%s\007' "$1"; return 0; }

# Windows side, through interop. cmd.exe complains when started from a WSL directory, so
# windows commands run with a Windows working directory.
win()  { (cd /mnt/c && cmd.exe /c "$@" 2>/dev/null | tr -d '\r'); }
winps() { (cd /mnt/c && powershell.exe -NoProfile -Command "$1" 2>/dev/null | tr -d '\r'); }
# A single quote inside a PowerShell single-quoted string has to be written twice. Paths come from
# Windows and can hold one (a user folder under a name with an apostrophe), and it ended the string.
ps_quote() { printf '%s' "${1//\'/\'\'}"; }

# Every curl here talks to this PC's own server: a proxy set in WSL would send 127.0.0.1 to the proxy, and up then waited
# four minutes to say the server was unreachable.
curl() { command curl --noproxy '*' "$@"; }
health() { curl -fsS --max-time 3 "$URL/health" 2>/dev/null; }
# The cloud agent signs in with this PC's own login: Claude Code's (~/.claude) or Codex's (~/.codex), each mounted
# into the container.
claude_login() { claude auth status --json 2>/dev/null | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('authMethod') or 'yes' if d.get('loggedIn') else '')" 2>/dev/null || true; }
# This PC's Claude Code version, or nothing when it has none. Claude Code is optional (next to the local model
# it only adds the agent), and this always succeeds: under `set -e` and pipefail a missing `claude`
# (status 127 through the pipe) made `local cv; cv="$(claude_version)"` end `up`, `install` and `capture --up`
# on the spot, with status 127 and not a word printed (measured with docker stood in for).
claude_version() {
  command -v claude >/dev/null 2>&1 || return 0                                # no Claude Code: no version
  claude --version 2>/dev/null | sed -n 's/^\([0-9][0-9.]*\).*/\1/p' | head -1 || true   # nor a broken one
}
# The same for Codex: its login ("ChatGPT", "API key") from `codex login status`, and its version ("codex-cli
# 0.165.0" prints as 0.165.0). Optional too, and always succeeds for the same reason.
codex_login() {
  command -v codex >/dev/null 2>&1 || return 0
  codex login status 2>&1 | sed -n 's/^Logged in using \(.*\)$/\1/p' | head -1 || true
}
codex_version() {
  command -v codex >/dev/null 2>&1 || return 0
  codex --version 2>/dev/null | sed -n 's/^codex-cli \([0-9][0-9.]*\).*/\1/p' | head -1 || true
}
json()   { python3 -c "import json,sys; d=json.load(sys.stdin); print($1)"; }
running() { docker ps --format '{{.Names}}' 2>/dev/null | grep -qx sidenote; }

# Monitoring runs inside the image too: in the running server, or a throwaway container
# that only reads the log folder (works while the server is down).
in_image() {
  docker_up
  # the report in this terminal's language: the container does not see the host's locale (server/i18n.py cli_lang)
  if running; then docker exec -e SIDENOTE_LANG="$UI_LANG" sidenote python -m server.report "$@"
  else
    docker image inspect sidenote:local >/dev/null 2>&1 || die "$(L "No image yet. Run ./sidenote up first" "이미지가 없습니다. 먼저 ./sidenote up")"
    docker run --rm -e TZ="${TZ:-Asia/Seoul}" -e SIDENOTE_LANG="$UI_LANG" -v "$LOG_PATH:/data/logs:ro" --entrypoint python sidenote:local -m server.report "$@"
  fi
}

ensure_dirs() { mkdir -p "$LOG_PATH" "$HOME/.claude" "$HOME/.codex"; }
# Who Claude Code is signed in as, for the panel's agent card: ~/.claude.json is not mounted in the server, and only its
# address comes out of it. Owner-only; a dot file, which the log tools pass over. Nothing to read: nothing kept.
note_account() {
  python3 - "$HOME/.claude.json" "$LOG_PATH/.account.json" <<'ACCOUNT' 2>/dev/null || true
import json, os, sys
try:
    a = json.load(open(sys.argv[1], encoding="utf-8")).get("oauthAccount") or {}
except (OSError, ValueError):
    a = {}
if not a.get("emailAddress"):   # signed out: the last address must not stay on the panel
    if os.path.exists(sys.argv[2]):
        os.remove(sys.argv[2])
else:
    fd = os.open(sys.argv[2], os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump({"email": a["emailAddress"]}, f)
ACCOUNT
}

# capture.log: the capture client's output, rotated by size like the server's logs
# (capture.log.1 .. .$LOG_FILES; older ones age out with the server's 14-day prune too).
rotate_capture_log() {
  local f="$LOG_PATH/capture.log" max=$((LOG_MAX_MB * 1024 * 1024)) i
  [ -f "$f" ] && [ "$(stat -c %s "$f")" -ge "$max" ] || return 0
  for ((i = LOG_FILES - 1; i >= 1; i--)); do [ -f "$f.$i" ] && mv -f "$f.$i" "$f.$((i + 1))"; done
  mv -f "$f" "$f.1"
}
log_capture() {   # stdin -> terminal and capture.log, checking the size every 100 lines
  local n=0 line
  while IFS= read -r line; do
    printf '%s\n' "$line"
    printf '%(%F %T)T %s\n' -1 "$line" >> "$LOG_PATH/capture.log"
    n=$((n + 1)); (( n % 100 )) || rotate_capture_log
  done
}

docker_up() { docker info >/dev/null 2>&1 || die "$(L "Cannot connect to Docker. Check that Docker is running." "Docker에 연결할 수 없습니다. Docker가 켜져 있는지 확인하세요.")"; }

clients() { health | json 'd["capture"]["clients"]' 2>/dev/null || echo 0; }

# "yes" while the server is being used (server/app.py activity()): something running (an analysis, a follow-up, a
# check, a run), an answer in the last 10 minutes (a restart drops the one a follow-up is asked about), or the screen
# watched and changing in the last 5 (not paused, a capture program connected). Nothing when it is not, or when it does
# not answer. A restart while it was in use solved the same problem twice.
in_use() {
  health | python3 -c '
import json, sys, time
d = json.load(sys.stdin)
a, c = d.get("activity") or {}, d.get("capture") or {}
now = c.get("now") or time.time()
recent = lambda t, sec: bool(t) and now - t < sec
used = (a.get("busy") or recent(a.get("last_answer"), 600)
        or (not d.get("paused") and (c.get("clients") or 0) > 0 and recent(c.get("last_frame"), 300)))
print("yes" if used else "")' 2>/dev/null
}

# The capture program runs this checkout's client/capture.py, read when it starts, so one started before a deploy
# runs the code from then (a fix to it waited for a restart by hand). When the code it
# reports in its hello is not the file here, it is asked to restart at a quiet moment (client/capture.py, Updater).
# One from before this was added reports nothing and ignores the request: a warning asks to restart it once.
capture_follow() {
  [ "$(clients)" -gt 0 ] 2>/dev/null || return 0
  local mine theirs
  mine="$(sha256sum "$PWD/client/capture.py" 2>/dev/null | cut -c1-12)"
  # (under set -e a /health that takes too long just after a deploy would otherwise end ./sidenote up, saying nothing)
  theirs="$(health | json '((d.get("capture") or {}).get("caps") or {}).get("code", "")' 2>/dev/null)" || return 0
  if [ -z "$theirs" ]; then
    warn "$(L "The capture program runs old code. Press Restart in its tray icon once ${D}(after that it restarts by itself on a deploy)${N}" \
              "캡처 프로그램이 예전 코드로 돌고 있습니다. 트레이 아이콘에서 다시 시작을 한 번 눌러 주세요 ${D}(그 뒤로는 배포 때 스스로 다시 시작합니다)${N}")"
  elif [ "$theirs" != "$mine" ]; then
    if curl -fsS --max-time 3 -X POST "$URL/capture/restart?quiet=1" >/dev/null 2>&1; then
      ok "$(L "The capture program restarts into the new code too, when the screen and the server are quiet" \
              "캡처 프로그램도 새 코드로, 화면과 서버가 쉬는 때에 다시 시작합니다")"
    else
      warn "$(L "Could not ask the capture program to restart. Ask again with ./sidenote capture-restart" \
                "캡처 프로그램에 다시 시작을 부탁하지 못했습니다. ./sidenote capture-restart 로 다시 부탁하세요")"
    fi
  fi
}

# Before a restart: wait while the server is in use, unless asked not to (--now). Polled every 15 s.
wait_idle() {
  [ "${UP_NOW:-0}" = 1 ] && return 0
  running && [ -n "$(in_use)" ] || return 0
  echo "  $(L "Sidenote is in use: it restarts once it is idle ${D}(--now to restart at once)${N}" \
              "Sidenote를 쓰는 중이라 쉴 때까지 기다렸다가 다시 시작합니다 ${D}(바로 하려면 --now)${N}")"
  local waited=0
  while [ -n "$(in_use)" ]; do
    sleep 15; waited=$((waited + 15))
    (( waited % 300 == 0 )) && echo "  ${D}$(L "waiting for $((waited / 60)) min" "$((waited / 60))분째 기다리는 중")${N}"
  done
  echo "  $(L "Idle: restarting" "쉬고 있어 다시 시작합니다")"
}

# What CI said of this commit: success, failure, running, or nothing when that cannot be known (no gh, not signed in, a commit not pushed yet).
ci_state() {
  command -v gh >/dev/null 2>&1 || return 0
  local sha; sha="$(git rev-parse HEAD 2>/dev/null)" || return 0
  gh run list --commit "$sha" --workflow ci --limit 1 --json status,conclusion \
    --jq 'if length == 0 then "" elif .[0].status != "completed" then "running" else .[0].conclusion end' 2>/dev/null || true
}

# The deploy's gate: a commit CI has failed does not go up unless asked (--no-ci). What CI has not seen goes up, and says so: uncommitted work, a commit still being
# checked, a PC with no gh. Waiting for the answer is for --when-green. Never prompts for input.
ci_gate() {
  [ "${UP_NO_CI:-0}" = 1 ] && return 0
  local dirty="" state waited=0 limit="${CI_WAIT_LIMIT:-2400}" every="${CI_WAIT_EVERY:-30}"
  if [ -n "$(git status --porcelain 2>/dev/null | grep -vE '^\?\?' | head -1)" ]; then
    dirty=1
    warn "$(L "Deploying uncommitted changes. CI has not checked this code." "커밋하지 않은 변경을 올립니다. CI를 거치지 않은 코드입니다.")"
  fi
  state="$(ci_state)"
  if [ "${UP_WHEN_GREEN:-0}" = 1 ] && [ -z "$dirty" ]; then   # what is not committed CI will never answer for
    until [ -n "$state" ] && [ "$state" != running ]; do
      (( waited >= limit )) && die "$(L "No CI result after $((limit / 60)) min. Not deployed. (--no-ci deploys anyway)" \
                                         "CI 결과를 $((limit / 60))분 기다렸지만 나오지 않았습니다. 올리지 않았습니다. (--no-ci로 그냥 올릴 수 있습니다)")"
      (( waited == 0 )) && echo "  $(L "Waiting for CI ${D}(this commit: $(git rev-parse --short HEAD))${N}" \
                                       "CI 결과를 기다립니다 ${D}(이 커밋: $(git rev-parse --short HEAD))${N}")"
      sleep "$every"; waited=$((waited + (every > 0 ? every : 1)))
      state="$(ci_state)"
    done
  fi
  case "$state" in
    success) ok "$(L "CI passed this commit" "CI 통과한 커밋입니다") ${D}($(git rev-parse --short HEAD))${N}" ;;
    running) warn "$(L "Deploying a commit CI is still checking ${D}(--when-green to wait)${N}" "CI가 아직 도는 중인 커밋을 올립니다 ${D}(기다리려면 --when-green)${N}")" ;;
    failure|cancelled|timed_out|startup_failure)
      # With changes on top too: they may mend it, and then a commit will say so; until then the failure stands
      die "$(L "This commit failed CI ($state). Fix it first, or deploy anyway with ./sidenote up --no-ci" \
               "이 커밋은 CI를 통과하지 못했습니다 ($state). 고친 뒤 올리거나, 그래도 올리려면 ./sidenote up --no-ci")" ;;
    *) if [ "${UP_WHEN_GREEN:-0}" = 1 ] && [ -z "$dirty" ]; then
         die "$(L "The CI result is unknown (check the gh login and that the commit is pushed)." "CI 결과를 알 수 없습니다 (gh 로그인, 푸시 여부 확인).")"
       fi
       warn "$(L "The CI result is unknown ${D}(no gh, not signed in, or a commit not pushed yet)${N}" \
                 "CI 결과를 알 수 없습니다 ${D}(gh가 없거나 로그인 전, 또는 아직 푸시하지 않은 커밋)${N}")" ;;
  esac
  return 0
}

# ./sidenote qa [server|panel]: the same suites CI runs, on this PC, with the interpreters tests/README.md sets up
cmd_qa() {
  local py="${PY:-.venv/bin/python}" pw="${PW:-.venv-panel/bin/python}"
  [ -x "$py" ] || die "$(L "No Python for the server suites: $py (the setup in tests/README.md)" "서버 묶음용 파이썬이 없습니다: $py (tests/README.md의 준비 절차)")"
  if [ "${1:-}" != server ]; then
    [ -x "$pw" ] || die "$(L "No Python for the panel suites: $pw (the setup in tests/README.md)" "패널 묶음용 파이썬이 없습니다: $pw (tests/README.md의 준비 절차)")"
  fi
  PY="$py" PW="$pw" tests/run.sh "$@"
}

cmd_up() {   # $1 = recreate: build and recreate even if nothing changed (./sidenote restart)
  command -v docker >/dev/null || die "$(L "docker is not installed." "docker가 없습니다.")"
  docker_up
  ensure_dirs
  note_account
  wait_idle   # not while it is in use
  # a capture program connected now reconnects by itself after the restart (asked only when the server
  # is up: here a closed local port hangs until curl's timeout instead of refusing)
  local before=0; running && before="$(clients)"
  # The container's Claude Code and Codex are built at this PC's versions: each shares its login folder with the PC's
  # own copy. Without one on this PC there is no version to pass, and compose.yaml's default is used instead.
  local cv; cv="$(claude_version)"
  [ -n "$cv" ] && export SIDENOTE_CLAUDE_VERSION="$cv"
  local xv; xv="$(codex_version)"
  [ -n "$xv" ] && export SIDENOTE_CODEX_VERSION="$xv"
  echo "$(L "${B}Starting the server${N} ${D}(the first time, and after an agent CLI update, building the image takes a while)${N}" \
            "${B}서버를 시작합니다${N} ${D}(처음이나 에이전트 CLI가 업데이트된 뒤에는 이미지를 만드느라 시간이 걸립니다)${N}")"
  local rc=0 out; out="$(mktemp)"
  # Built first, and the wait for a quiet server looked at once more: a build takes minutes, and a problem begun
  # during it had the container replaced under it, the very thing the wait is there to prevent.
  docker compose build 2>&1 | tee "$out" | { grep -vE "^\s*$" || true; } | uniq | sed 's/^/  /' || rc=$?
  if [ "$rc" = 0 ]; then
    wait_idle
    docker compose up -d --no-build --quiet-pull ${1:+--force-recreate} 2>&1 | tee "$out" | { grep -vE "^\s*$" || true; } | uniq | sed 's/^/  /' || rc=$?
  fi
  if [ "$rc" != 0 ]; then
    # A taken port leaves a created but never started server behind; the next up would start it
    # without its port. A server that was already running is left alone.
    [ "$(docker inspect -f '{{.State.Running}}' sidenote 2>/dev/null)" = false ] && docker rm -f sidenote >/dev/null 2>&1
    if grep -qiE "address already in use|port is already allocated" "$out"; then
      rm -f "$out"; die "$(L "Another program is using port ${PORT}. Close it, or set another port in .env (SIDENOTE_PORT=8778, say) and run ./sidenote up" \
                             "포트(${PORT})를 다른 프로그램이 쓰고 있습니다. 그 프로그램을 끄거나, .env에 SIDENOTE_PORT=8778 처럼 다른 포트를 적은 뒤 ./sidenote up")"
    fi
    rm -f "$out"; die "$(L "Could not start the server (docker compose exit code $rc). See the messages above." \
                           "서버를 띄우지 못했습니다 (docker compose 종료 코드 $rc). 위 메시지를 확인하세요.")"
  fi
  rm -f "$out"
  docker image prune -f --filter label=org.sidenote.image >/dev/null 2>&1 || true   # only this project's old builds
  printf '  %s' "$(L "Getting ready" "준비 중")"
  local t0=$SECONDS
  until health >/dev/null; do
    if ! running; then   # it stopped while starting (a crash): say so now, not after minutes
      echo; docker logs --tail 15 sidenote 2>&1 | sed 's/^/  /'
      die "$(L "The server stopped while starting. See the log above." "서버가 시작하다 멈췄습니다. 위 로그를 확인하세요.")"
    fi
    if (( SECONDS - t0 > 240 )); then   # the first start loads the speech model: well under four minutes
      echo
      [ "$(docker inspect -f '{{.State.Health.Status}}' sidenote 2>/dev/null)" = healthy ] \
        && die "$(L "The server is up, but this PC cannot reach $URL. Start it again with ./sidenote down and ./sidenote up." \
                    "서버는 켜졌는데 이 PC에서 $URL에 닿지 않습니다. ./sidenote down 후 ./sidenote up 으로 다시 띄우세요.")"
      die "$(L "The server does not answer. See ./sidenote logs." "서버가 응답하지 않습니다. ./sidenote logs 로 확인하세요.")"
    fi
    printf '.'; sleep 1
  done
  echo
  # a few seconds for what reconnects by itself, so status does not report it missing
  if [ "${before:-0}" -gt 0 ]; then
    for _ in $(seq 1 12); do [ "$(clients)" -gt 0 ] && break; sleep 0.5; done
  fi
  if [ "$(health | json 'd.get("runner", {}).get("configured", False)' 2>/dev/null)" = True ]; then
    for _ in $(seq 1 16); do [ "$(health | json 'd["runner"]["ok"]' 2>/dev/null)" = True ] && break; sleep 0.5; done
  fi
  capture_follow
  cmd_status
}

cmd_down() {
  cmd_capture_stop quiet || true   # first: it is outside docker, and docker being off is no reason to leave it running
  docker_up
  # Every profile, whatever .env says now: with the analyzer changed since up, the model's container was not looked at,
  # "already off" was said, and it kept the GPU
  if [ -z "$(docker compose --profile '*' ps -q 2>/dev/null)" ]; then ok "$(L "Already stopped." "이미 꺼져 있습니다.")"; return 0; fi
  docker compose --profile '*' down 2>&1 | { grep -vE "^\s*$" || true; } | uniq | sed 's/^/  /'
  ok "$(L "Server stopped." "서버를 멈췄습니다.")"
}

cmd_status() {
  local h; h="$(health || true)"
  echo
  if [ -z "$h" ]; then
    if running; then warn "$(L "Server: starting  ${D}(./sidenote status again in a moment)${N}" "서버: 시작하는 중  ${D}(잠시 뒤 다시 ./sidenote status)${N}")"
    else bad "$(L "Server: off (./sidenote up)" "서버: 꺼져 있음 (./sidenote up)")"; fi
    return 0
  fi
  ok "$(L "Server: running" "서버: 실행 중")  ${B}${URL}${N}"
  # What is running against what is here, and what CI said of this commit
  local built here state
  built="$(echo "$h" | json 'd.get("build") or ""' 2>/dev/null)"
  # the same sum as the server's panel_build(): the panel's own files and its translation tables
  here="$(python3 -c '
import hashlib, pathlib
here = pathlib.Path("panel")
h = hashlib.sha256()
files = [p for p in here.glob("*") if p.is_file()] + list((here / "i18n").glob("*.js"))
for p in sorted(files, key=lambda p: p.relative_to(here).as_posix()):
    h.update(p.relative_to(here).as_posix().encode()); h.update(p.read_bytes())
print(h.hexdigest()[:12])' 2>/dev/null)"
  if [ -n "$built" ] && [ -n "$here" ]; then
    if [ "$built" = "$here" ]; then ok "$(L "Deploy: the panel running is this code's" "배포: 지금 코드의 패널이 떠 있습니다") ${D}($built)${N}"
    else warn "$(L "Deploy: the panel running differs from this code" "배포: 떠 있는 패널이 지금 코드와 다릅니다") ${D}(./sidenote up)${N}"; fi
  fi
  state="$(ci_state)"
  case "$state" in
    success) ok "$(L "CI: this commit passed" "CI: 이 커밋 통과") ${D}($(git rev-parse --short HEAD))${N}" ;;
    running) warn "$(L "CI: this commit is being checked" "CI: 이 커밋 도는 중")" ;;
    "") ;;
    *) bad "$(L "CI: this commit failed ($state)" "CI: 이 커밋 실패 ($state)")" ;;
  esac
  # The two engines as "level|line" pairs: one engine down while the other answers is a warning. The program is read
  # from a quoted here-document (its English has apostrophes), the language comes as its argument, and stdin stays
  # the health JSON. read stops at the end of the document and says so with status 1: not a failure here.
  local level line engines
  IFS= read -r -d '' engines <<'ENGINES' || true
import json, sys
T = (lambda en, ko: ko) if sys.argv[1:] == ["ko"] else (lambda en, ko: en)   # the launcher's L
d = json.load(sys.stdin); e = d.get("engines") or {}
L, C, ready = e.get("local") or {}, e.get("agent") or e.get("claude") or {}, e.get("ready", False)
# the word in this terminal's language, not the server's label (that follows the panel's language)
product = C.get("product") or ""
name = (T("Agent (%s)", "에이전트(%s)") % product) if product else T("Agent", "에이전트")   # the one place it is named here
login = C.get("login") or "./sidenote login"
down = "warn" if ready else "bad"
if L.get("present"):
    g = L.get("loaded")
    gpu = (T("not on the GPU", "GPU에 올라가 있지 않음") if not g else "" if g.get("unknown")
           else T("on the GPU", "GPU에 올라가 있음") + (" %s GB" % g["vram_gb"] if g.get("vram_gb") else ""))
    B = L.get("busy")
    if not L.get("on"): print(T("warn|This PC's model: off (the panel's Solving settings)", "warn|이 PC의 모델: 꺼 둠 (패널의 풀이 설정)"))
    elif L.get("ok") and B: print(T("warn|This PC's model: solving with %s, short of GPU memory (%s is loaded again soon)",
                                    "warn|이 PC의 모델: GPU 메모리가 모자라 %s로 푸는 중 (%s는 곧 다시 올려 봄)") % (B.get("model", ""), L.get("model", "")))
    elif L.get("ok"): print(T("ok|This PC's model: connected (%s%s)", "ok|이 PC의 모델: 연결됨 (%s%s)") % (L.get("model", ""), ", " + gpu if gpu else ""))
    elif L.get("missing"): print(T("%s|This PC's model: model %s not downloaded (./sidenote llm pull)",
                                   "%s|이 PC의 모델: 모델 %s가 없음 (./sidenote llm pull)") % (down, L.get("model", "")))
    else: print(T("%s|This PC's model: not responding (./sidenote llm logs)", "%s|이 PC의 모델: 응답 없음 (./sidenote llm logs)") % down)
if C.get("present"):
    how = {"claude.ai": T("this PC's %s login", "이 PC의 %s 로그인") % (product or name),
           "chatgpt": T("this PC's %s login (ChatGPT)", "이 PC의 %s 로그인(ChatGPT)") % (product or name),
           "api-key": T("API key", "API 키"), "mock": T("mock, for tests", "목업, 시험용")}.get(C.get("method"), C.get("method") or "")
    what = {"hard": T("Hard problems of the chosen types", "고른 유형의 어려운 문제"), "verify": T("Checks this PC's model's answers", "이 PC의 모델이 푼 답 확인"),
            "all": T("Every problem found", "찾은 문제 모두")}.get(C.get("effective"), "")
    sent = {"crop": T("problem crop", "문제 부분 화면"), "text": T("problem text", "문제 글"), "screen": T("whole screen", "화면 전체")}.get(C.get("payload"), "")
    if C.get("mode") == "off": print(T("warn|%s: off (the panel's Solving settings)", "warn|%s: 꺼 둠 (패널의 풀이 설정)") % name)
    elif C.get("ok"): print(T("ok|%s: connected (%s). %s, sends: %s", "ok|%s: 연결됨 (%s). %s, 보내는 것: %s") % (name, how, what, sent))
    elif C.get("rejected"): print(T("%s|%s: login expired, rejected (%s)", "%s|%s: 로그인이 만료되어 거부됨 (%s)") % (down, name, login))
    else: print(T("%s|%s: sign-in needed (%s)", "%s|%s: 로그인 필요 (%s)") % (down, name, login))
if not ready: print(T("bad|No engine can answer (see above, or the panel's Solving settings)", "bad|풀 수 있는 엔진이 없습니다 (위 항목, 또는 패널의 풀이 설정)"))
ENGINES
  while IFS='|' read -r level line; do
    case "$level" in ok) ok "$line" ;; warn) warn "$line" ;; *) bad "$line" ;; esac
  done < <(echo "$h" | python3 -c "$engines" "$UI_LANG" 2>/dev/null)
  local n screen audio server_audio; n="$(echo "$h" | json 'd["capture"]["clients"]')"
  screen="$(echo "$h" | json 'd["capture"].get("screen_on", True)')"
  audio="$(echo "$h" | json 'd["capture"].get("audio_on", True)')"
  server_audio="$(echo "$h" | json 'd.get("audio", True)')"
  local sound; if [ "$server_audio" != True ]; then sound="$(L "off, server setting SIDENOTE_AUDIO" "꺼짐, 서버 설정 SIDENOTE_AUDIO")"
  elif [ "$audio" = True ]; then sound="$(L on 켜짐)"; else sound="$(L off "꺼 둠")"; fi
  local procs=0   # capture programs Windows lists: asked only when none is connected (it takes a second)
  [ "$n" -gt 0 ] || procs="$(capture_running)"
  if [ "$n" -gt 0 ]; then
    local shown; if [ "$screen" = True ]; then shown="$(L on 켜짐)"; else shown="$(L off "꺼 둠")"; fi
    ok "$(L "Capture program: connected (screen ${shown}, sound ${sound})" "캡처 프로그램: 연결됨 (화면 ${shown}, 소리 ${sound})")"
  elif [ "$procs" = "?" ]; then
    # Windows gave no process list. Nothing is connected, which is what the server knows; whether one is
    # running and reconnecting cannot be said, so it is not claimed.
    warn "$(L "Capture program: not connected (./sidenote capture)  ${D}(could not read the Windows process list)${N}" \
              "캡처 프로그램: 연결 안 됨 (./sidenote capture)  ${D}(Windows의 프로세스 목록은 읽지 못했습니다)${N}")"
  elif [ "$procs" != "0" ]; then
    warn "$(L "Capture program: reconnecting  ${D}(one that is running connects within seconds)${N}" \
              "캡처 프로그램: 다시 연결하는 중  ${D}(캡처 프로그램이 떠 있으면 몇 초 안에 붙습니다)${N}")"
  else
    warn "$(L "Capture program: not connected (./sidenote capture)" "캡처 프로그램: 연결 안 됨 (./sidenote capture)")"
  fi
  [ "$(echo "$h" | json 'd.get("paused", False)')" = True ] && warn "$(L "Automatic analysis: paused  ${D}(the panel's Continue button)${N}" "자동 분석: 일시정지 중  ${D}(패널의 계속하기 버튼)${N}")"
  if [ "$(echo "$h" | json 'd.get("runner", {}).get("configured", False)')" = True ]; then
    if [ "$(echo "$h" | json 'd["runner"]["ok"]')" = True ]; then ok "$(L "Code runner: ready" "코드 실행기: 준비됨")"
    elif [ "$(docker inspect -f '{{.State.Running}}' sidenote-runner 2>/dev/null)" = true ]; then
      bad "$(L "Code runner: not responding (./sidenote restart)" "코드 실행기: 응답 없음 (./sidenote restart)")"   # up leaves a running container alone
    else bad "$(L "Code runner: off (./sidenote up)" "코드 실행기: 꺼져 있음 (./sidenote up)")"; fi
  fi
  echo
  echo "  $(L "Open the panel" "패널 열기"): ${B}${URL}${N}   ${D}($(L "or ./sidenote open" "또는 ./sidenote open"))${N}"
}

cmd_logs() {
  docker_up
  running || die "$(L "The server is off. ./sidenote up (what happened while it was off: ./sidenote events)" "서버가 꺼져 있습니다. ./sidenote up (꺼진 동안의 기록은 ./sidenote events)")"
  docker compose logs -f --tail 60 server
}

cmd_login() {   # the cloud agent uses this PC's own login; this signs it in when it is not
  local which="${1:-$AGENT}"   # ./sidenote login codex, or the agent the server is set to use
  case "$which" in
    codex) login_codex ;;
    claude|claude-code|"") login_claude ;;
    anthropic-api) die "$(L "The Anthropic API uses ANTHROPIC_API_KEY in .env, not a login." "Anthropic API는 로그인 대신 .env의 ANTHROPIC_API_KEY를 씁니다.")" ;;
    *) die "$(L "Unknown agent: $which (claude-code or codex)" "모르는 에이전트입니다: $which (claude-code 또는 codex)")" ;;
  esac
  if health >/dev/null; then
    echo "  $(L "The server picks up the new login within 20 seconds. Now:" "서버가 20초 안에 새 로그인을 알아챕니다. 지금 상태:")"; cmd_status
  else
    echo "  $(L "Next: ./sidenote up" "이제 ./sidenote up")"
  fi
}

login_claude() {   # this only signs Claude Code in when it is not
  command -v claude >/dev/null || die "$(L "claude is not installed on this server. Install Claude Code first." "이 서버에 claude가 없습니다. Claude Code를 먼저 설치하세요.")"
  local how rejected; how="$(claude_login)"
  rejected="$(health | json 'd["auth"].get("rejected", False)' 2>/dev/null || true)"
  if [ -n "$how" ] && [ "$rejected" != True ]; then
    ok "$(L "This PC's Claude Code is signed in ($how). The server uses this login as it is." "이 PC의 Claude Code가 로그인되어 있습니다 ($how). 서버가 이 로그인을 그대로 씁니다.")"
  else
    [ "$rejected" = True ] && warn "$(L "The server rejected this login (expired). Signing in again." "서버에서 이 로그인이 거부됐습니다(만료). 다시 로그인합니다.")"
    [ -t 0 ] || die "$(L "Run the login in a terminal: ./sidenote login (one step signs in in a browser)" \
                         "로그인은 터미널에서 직접 실행하세요: ./sidenote login (브라우저에서 로그인하는 단계가 있습니다)")"
    echo "${B}$(L "Claude Code login" "Claude Code 로그인")${N} ${D}($(L "sign in in the browser, and the server uses this login too" "브라우저에서 로그인하면 서버도 이 로그인을 씁니다"))${N}"
    claude auth login || die "$(L "Could not sign in. Try ./sidenote login again" "로그인하지 못했습니다. 다시 ./sidenote login")"
    how="$(claude_login)"; [ -n "$how" ] || die "$(L "Not signed in yet. Try ./sidenote login again" "아직 로그인되지 않았습니다. 다시 ./sidenote login")"
    ok "$(L "Signed in ($how)." "로그인했습니다 ($how).")"
  fi
}

# Codex signs in on this PC when it has the codex CLI; without one, the server's own copy does it with a device code
# (a code typed at a web page, no browser callback into the container), and the login lands in the same ~/.codex
# that the container mounts.
login_codex() {
  local how; how="$(codex_login)"
  if [ -z "$how" ] && running; then
    how="$(docker exec sidenote codex login status 2>&1 | sed -n 's/^Logged in using \(.*\)$/\1/p' | head -1 || true)"
  fi
  if [ -n "$how" ]; then
    ok "$(L "This PC's Codex is signed in ($how). The server uses this login as it is." "이 PC의 Codex가 로그인되어 있습니다 ($how). 서버가 이 로그인을 그대로 씁니다.")"
    return 0
  fi
  [ -t 0 ] || die "$(L "Run the login in a terminal: ./sidenote login codex" "로그인은 터미널에서 직접 실행하세요: ./sidenote login codex")"
  if command -v codex >/dev/null 2>&1; then
    echo "${B}$(L "Codex login" "Codex 로그인")${N} ${D}($(L "sign in in the browser, and the server uses this login too" "브라우저에서 로그인하면 서버도 이 로그인을 씁니다"))${N}"
    codex login || die "$(L "Could not sign in. Try ./sidenote login codex again" "로그인하지 못했습니다. 다시 ./sidenote login codex")"
  elif running; then
    echo "${B}$(L "Codex login" "Codex 로그인")${N} ${D}($(L "no codex on this server, so the server's own Codex signs in: enter the code at the address it shows" \
                                                             "이 서버에 codex가 없어 서버 안의 Codex로 합니다: 보여 주는 주소에서 코드를 넣으세요"))${N}"
    docker exec -it sidenote codex login --device-auth || die "$(L "Could not sign in. Try ./sidenote login codex again" "로그인하지 못했습니다. 다시 ./sidenote login codex")"
  else
    die "$(L "No codex on this server, and the server is off. Run ./sidenote up, then ./sidenote login codex again" \
             "이 서버에 codex가 없고 서버도 꺼져 있습니다. ./sidenote up 뒤에 다시 ./sidenote login codex")"
  fi
  ok "$(L "Signed in." "로그인했습니다.")"
}

# This checkout's capture client on Windows, found by the full path of capture.py in the command line
# of the programs that run it: cmd.exe, the Python launchers py.exe and pyw.exe, and the interpreters
# python.exe and pythonw.exe they start (C:\Windows\py.exe and pyw.exe, C:\Python314\python.exe and
# pythonw.exe on this PC). The names are compared whole: the pattern py*.exe used before also matched
# pycharm64.exe, so an IDE opened on capture.py would have been ended with -Force by capture-stop, down
# or uninstall. An editor with capture.py open, or the client of another copy of sidenote, is never
# touched. A folder name's apostrophe would end the string, and its [ ] * ? would be wildcards, so the path is quoted and
# escaped for -like; the query's own powershell.exe is left out by its name, and -contains compares names without
# regard to case. Never used with no path: the pattern would then be '**', and that is every python on Windows.
CLIENT_LIKE="('*' + [System.Management.Automation.WildcardPattern]::Escape('$(ps_quote "$CLIENT_WIN")') + '*')"
CAPTURE_PROCS="\$_.CommandLine -like ${CLIENT_LIKE} -and @('cmd.exe', 'py.exe', 'pyw.exe', 'python.exe', 'pythonw.exe') -contains \$_.Name"
# How many of this checkout's capture programs are running: the interpreter itself, python.exe or
# pythonw.exe (py.exe and pyw.exe only start it). Always a number, or "?" when Windows could not be asked:
# a query that printed nothing (a WMI error, PowerShell not answering) used to count as one running, so
# capture refused to start ("already running") and status said a capture program was reconnecting.
capture_running() {
  local n
  if [ "$ON_WSL" = 0 ]; then         # this desktop's own: the processes running client/capture.py for a server
    n="$(pgrep -fc -- "[c]lient/capture[.]py --server" || true)"
    printf '%s' "${n:-0}"; return 0
  fi
  [ -n "$CLIENT_WIN" ] || { printf '?'; return 0; }
  n="$(winps "@(Get-CimInstance Win32_Process | Where-Object { \$_.CommandLine -like ${CLIENT_LIKE} -and @('python.exe', 'pythonw.exe') -contains \$_.Name }).Count" | tail -1)" || n=""
  if [[ $n =~ ^[0-9]+$ ]]; then printf '%s' "$n"; else printf '?'; fi
}

# The capture program restarts itself into the capture.py on disk now, as from its tray's Restart (after a deploy
# it does so by itself at a quiet moment: capture_follow; this is for now). Asked through the server, like capture-stop.
cmd_capture_restart() {
  health >/dev/null || die "$(L "The server is off, so the capture program cannot be asked. ./sidenote up" "서버가 꺼져 있어 캡처 프로그램에 부탁할 수 없습니다. ./sidenote up")"
  local n; n="$(curl -fsS --max-time 3 -X POST "$URL/capture/restart" 2>/dev/null | json 'd.get("asked", 0)' 2>/dev/null || echo 0)"
  if [ "${n:-0}" -gt 0 ]; then
    ok "$(L "Asked ${n} capture program$([ "$n" = 1 ] || echo s) to restart (it takes a few seconds)" "캡처 프로그램 ${n}개에 다시 시작을 부탁했습니다 (몇 초 걸립니다)")"
  else warn "$(L "No capture program is connected. Start one with ./sidenote capture" "연결된 캡처 프로그램이 없습니다. ./sidenote capture 로 켜세요")"; fi
}

cmd_capture_stop() {
  local was left; was="$(capture_running)"
  if [ "$was" != "0" ]; then   # one or more running, or not known ("?"): asking costs nothing either way
    # Ask through the server first: the capture program ends itself and takes its tray icon with it.
    # Killed outright, the icon stays in the notification area until something hovers over it.
    # (A window message does not do it: the tray library answers WM_CLOSE with nothing at all.)
    if ! health >/dev/null; then
      warn "$(L "The server is off, so the capture program cannot be asked. Ending it by force ${D}(its tray icon may stay for a moment)${N}" \
                "서버가 꺼져 있어 캡처 프로그램에 부탁할 수 없습니다. 강제로 끕니다 ${D}(트레이 아이콘이 잠깐 남아 있을 수 있습니다)${N}")"
    fi
    curl -fsS --max-time 3 -X POST "$URL/capture/quit" >/dev/null 2>&1 || true
    local n=0
    while [ "$n" -lt 10 ]; do          # the socket closes when it goes; about 3 s at most
      [ "$(clients)" = "0" ] && break
      n=$((n + 1)); sleep 0.3
    done
    sleep 0.4                          # and a moment for the process itself to be gone
  fi
  if [ "$ON_WSL" = 0 ]; then
    pkill -f -- "[c]lient/capture[.]py --server" 2>/dev/null || true; sleep 0.3
  else
    [ -z "$CLIENT_WIN" ] || winps "Get-CimInstance Win32_Process | Where-Object { ${CAPTURE_PROCS} } | ForEach-Object { Stop-Process -Id \$_.ProcessId -Force -ErrorAction SilentlyContinue }" >/dev/null || true
  fi
  left="$(capture_running)"
  if [ "$left" = "?" ]; then   # the stop went out, but whether it worked cannot be read
    bad "$(L "Could not read the Windows process list, so whether a capture program is left is not known. Look for python.exe and pythonw.exe in Task Manager." \
             "Windows의 프로세스 목록을 읽지 못해 캡처 프로그램이 남았는지 확인하지 못했습니다. 작업 관리자에서 python.exe와 pythonw.exe를 확인하세요.")"
    return 1
  fi
  if [ "$left" != "0" ]; then   # how many, as the user guide says it does
    bad "$(L "${left} capture program$([ "$left" = 1 ] || echo s) still running. End python.exe or pythonw.exe in Task Manager." \
             "캡처 프로그램 ${left}개가 아직 남아 있습니다. 작업 관리자에서 python.exe나 pythonw.exe를 끄세요.")"
    return 1
  fi
  [ "${1:-}" = quiet ] && return 0
  case "$was" in
    0) ok "$(L "No capture program is running." "실행 중인 캡처 프로그램이 없습니다.")" ;;
    \?) ok "$(L "No capture program is left." "남아 있는 캡처 프로그램이 없습니다.")" ;;   # none now; whether there was one before is not known
    *) ok "$(L "Capture stopped." "캡처를 멈췄습니다.")" ;;
  esac
}

# Characters cmd.exe acts on in the command line it is handed: & | < > start another command or redirect
# one, ^ escapes, % expands a variable, and a quote changes what the others mean. capture.py is started
# through cmd.exe (start /b for the windowless program, a plain call with --console), so an option holding
# one of them reached it cut short, or had the rest run as a command of its own. Measured:
# `R&rem after` left Python with `R`, and cmd.exe ran `rem after`. WSL quotes a value that has a space in
# it, and inside those quotes they would be harmless, but that is WSL's decision and not this script's, so
# an option holding any of them is refused, with a word on what to type instead. Only --audio-device takes
# free text, and a sound device is found by any part of its name.
WIN_UNSAFE='["%&|<>^]'
check_win_args() {
  local a
  for a in "$@"; do
    [[ $a =~ $WIN_UNSAFE ]] || continue
    die "$(L "An option holding a character the Windows command line acts on (\" % & | < > ^) cannot be passed: $a. For a device name, type a part of it without that character (any part of the name finds it)." \
             "Windows 명령줄이 따로 읽는 문자(\" % & | < > ^)가 든 옵션은 넘길 수 없습니다: $a. 장치 이름이면 그 문자가 없는 부분만 적으세요 (이름의 일부만 맞아도 찾습니다).")"
  done
}

# Whether the capture packages import in Windows Python, and whether the tray icon's package is there as
# well: prints "tray" or "notray", and fails when one of the five the program needs does not import.
# pystray is optional (without it the program runs with no icon), so it is looked up rather than required.
# Checking the five alone said "installed" on a setup made before pystray joined
# client/requirements.txt, so install never added it, and the windowless program then ran with
# neither a window nor an icon.
win_packages() {
  win py -3 -c "import mss, soundcard, numpy, PIL, websocket, importlib.util; print('tray' if importlib.util.find_spec('pystray') else 'notray')" | tail -1
}

# Whether a capture program started just now is there: the server has more capture programs connected than
# the $1 it had before the start (the program connects first thing, and asking takes milliseconds), or
# Windows lists one (a second per question, but true while it is still waiting for the server).
capture_started() {
  [ "$(clients)" -gt "${1:-0}" ] && return 0
  local p; p="$(capture_running)"
  [[ $p =~ ^[1-9] ]]
}

cmd_capture() {
  if [ "$ON_WSL" = 0 ]; then cmd_capture_here "$@"; return; fi
  [ -n "$CLIENT_WIN" ] || die "$(L "Could not find the Windows path (wslpath)." "Windows 경로를 찾지 못했습니다 (wslpath).")"
  # The options for capture.py, each one exactly the word that was typed, kept in an array so that a value
  # with spaces in it ("Realtek USB2.0 Audio", the way Windows names a sound device) stays one argument and
  # no quote character is added to any of them. The windowless start used to wrap every option
  # in quote characters of its own, which WSL hands on as part of the argument (Python received "--monitor"
  # with the quotes), so argparse refused every option and the program ended before it opened its log;
  # --console and --up rebuilt the list with `set -- $(...)`, which cut a value at every space.
  # --up and --console are this launcher's own: they are noted here and not passed on (capture.py would
  # refuse them). --once sends one screen and ends, so it runs in this terminal as with --console, where
  # what it did is printed; started windowless it could also be gone before the start was seen.
  local a up=0 console=0 opts=()
  for a in "$@"; do
    case "$a" in
      --up) up=1 ;;
      --console) console=1 ;;
      *) opts+=("$a")
         if [ "$a" = --once ]; then console=1; fi ;;
    esac
  done
  check_win_args "${opts[@]}"   # before cmd.exe sees any of them
  # Only listing the monitors, or the options: capture.py answers and ends, so it runs here and now.
  for a in "${opts[@]}"; do
    case "$a" in --list-monitors|--help|-h)
      (cd /mnt/c && cmd.exe /c py -3 -X utf8 -u "$CLIENT_WIN" "${opts[@]}" 2>&1 | sed -u 's/\r$//' | grep -vE "UNC paths|CMD.EXE|^$") || true
      return 0 ;;
    esac
  done
  if [ "$up" = 1 ]; then   # bring the server up first (the desktop shortcut does this, through client/launch.pyw)
    # The desktop shortcut runs this with no terminal at all: client/launch.pyw reads what it prints, and its
    # failing status, and shows the reason in a message box. There the title and the wait below do nothing.
    # They are for a terminal window that closes the moment this script ends, taking every word of why with it,
    # which an older shortcut opened (wsl.exe in a console window of its own): an end in failure
    # waits for Enter first (only when there is a terminal to read from), and the terminal gets its own title
    # back however this ends.
    term_title "Sidenote Capture"
    trap 'rc=$?; term_title ""; if [ "$rc" != 0 ] && [ -t 0 ]; then printf "\n  %s" "$(L "Press Enter to close this window " "Enter를 누르면 이 창을 닫습니다 ")"; read -r _ || true; fi' EXIT
    # In the output, not sent to /dev/null: after a reboot nothing is running, and when the server cannot start
    # (Docker off, the port taken) its reason is what has to be seen, in the terminal or in the shortcut's
    # message box (the last lines of this output). The first start also builds the image for minutes; in a
    # terminal, the dots `up` prints say that it is still going.
    health >/dev/null || cmd_up
  fi
  health >/dev/null || die "$(L "The server is off. Start it first with ./sidenote up, or start both with ./sidenote capture --up." \
                                  "서버가 꺼져 있습니다. ./sidenote up 으로 먼저 켜거나, ./sidenote capture --up 으로 함께 켜세요.")"
  win py -3 --version >/dev/null || die "$(L "No Python (py) on Windows. Install it from python.org, then ./sidenote setup-windows" \
                                              "Windows에 Python(py)이 없습니다. python.org에서 설치 후 ./sidenote setup-windows")"
  local packages
  packages="$(win_packages)" || die "$(L "The capture packages are not in Windows Python. ./sidenote setup-windows" "Windows Python에 캡처 패키지가 없습니다. ./sidenote setup-windows")"
  # Two capture programs would send every screen twice. Windows' process list says whether one is running;
  # when it cannot be read ("?"), the server says whether one is connected, which is the one that would send.
  local procs; procs="$(capture_running)"
  if [ "$procs" = "?" ]; then
    [ "$(clients)" -gt 0 ] && die "$(L "The capture is already running (connected to the server). Quit it from the tray icon or with ./sidenote capture-stop" \
                                         "캡처가 이미 실행 중입니다 (서버에 연결돼 있습니다). 트레이 아이콘에서 끝내거나 ./sidenote capture-stop")"
    warn "$(L "Could not read the Windows process list. No capture program is connected to the server, so one is started." \
              "Windows의 프로세스 목록을 읽지 못했습니다. 서버에 연결된 캡처 프로그램이 없어 시작합니다.")"
  elif [ "$procs" != "0" ]; then
    die "$(L "The capture is already running. Quit it from the tray icon or with ./sidenote capture-stop" "캡처가 이미 실행 중입니다. 트레이 아이콘에서 끝내거나 ./sidenote capture-stop")"
  fi
  ensure_dirs
  rotate_capture_log
  # Windowless by default: the program has a tray icon to open the panel and to end it, so a console
  # window of its own is one more thing on the taskbar for nothing. --console keeps it in this terminal.
  if [ "$console" = 0 ]; then
    # Without its tray icon (no pystray in Windows Python, or --no-tray) the program runs with neither a
    # window nor an icon. That is said before it starts, with the one way left to end it.
    local tray=1
    [ "$packages" = tray ] || tray=0
    for a in "${opts[@]}"; do if [ "$a" = --no-tray ]; then tray=0; fi; done
    if [ "$packages" != tray ]; then
      warn "$(L "Starting without a tray icon: pystray is not in Windows Python ${D}(install: ./sidenote setup-windows)${N}. To end it: ${B}./sidenote capture-stop${N}" \
                "트레이 아이콘 없이 시작합니다: Windows Python에 pystray가 없습니다 ${D}(설치: ./sidenote setup-windows)${N}. 끝낼 때는 ${B}./sidenote capture-stop${N}")"
    elif [ "$tray" = 0 ]; then
      warn "$(L "Starting without a tray icon (--no-tray). To end it: ${B}./sidenote capture-stop${N}" "트레이 아이콘 없이 시작합니다 (--no-tray). 끝낼 때는 ${B}./sidenote capture-stop${N}")"
    fi
    local logwin; logwin="$(wslpath -w "$LOG_PATH/capture.log")"
    local base; base="$(clients)"   # connected before the start, so one elsewhere is not taken for this one
    # setsid --fork, because WSL's interop helper returns only once every Windows process it
    # started has ended, `start /b` or not (measured: 3.1 s for a `start /b` of a 3 s
    # ping). Run plainly, this line sat here for the whole capture session, so the lines below never
    # printed and the shortcut's own console window stayed on the taskbar next to the tray icon.
    # --fork is the part that matters: plain `setsid`, and even `( ... & )`, leave the helper a
    # child of this shell, and a shell whose output is a pipe (`./sidenote capture | tail`) waits
    # for its background children before it exits (measured: 5 s either way, 0.003 s with --fork).
    # With --fork the child exits at once and the helper belongs to init, in a session of its own,
    # so closing the window cannot hang it up either.
    # </dev/null: there is no terminal left to read from once the launcher has moved on.
    # The capture program is a Windows process and outlives the helper regardless (measured: helper
    # killed, program still capturing), so nothing on this side holds it open.
    # "${opts[@]}": every option one argument, as typed (see the top of this function). WSL puts a value
    # with spaces in quotes for the Windows command line, and cmd.exe and start pass it on whole
    # (measured with a script that only writes down its arguments).
    (cd /mnt/c && setsid --fork cmd.exe /c start "" /b pyw -3 -X utf8 "$CLIENT_WIN" \
        --server "ws://127.0.0.1:${PORT}/ingest" --log "$logwin" "${opts[@]}" >/dev/null 2>&1 </dev/null) || true
    local n=0
    while [ "$n" -lt 20 ]; do          # about ten seconds at most
      capture_started "$base" && break
      n=$((n + 1)); sleep 0.5
    done
    if ! capture_started "$base"; then
      bad "$(L "The capture program did not start. See what stops it with ./sidenote capture --console." "캡처 프로그램이 뜨지 않았습니다. ./sidenote capture --console 로 무엇이 막는지 보세요.")"
      return 1
    fi
    if [ "$tray" = 1 ]; then
      ok "$(L "Screen and sound capture started ${D}(no window, a tray icon)${N}" "화면과 소리 캡처를 시작했습니다 ${D}(창 없이, 트레이 아이콘으로)${N}")"
      echo "  $(L "To end it: right-click the tray icon > Quit, or ${B}./sidenote capture-stop${N}" "끝내기: 트레이 아이콘 오른쪽 클릭 > 끝내기, 또는 ${B}./sidenote capture-stop${N}")"
    else
      ok "$(L "Screen and sound capture started ${D}(no window and no tray icon)${N}" "화면과 소리 캡처를 시작했습니다 ${D}(창도 트레이 아이콘도 없이)${N}")"
      echo "  $(L "To end it" "끝내기"): ${B}./sidenote capture-stop${N}"
    fi
    echo "  $(L "Panel" "패널"): ${B}${URL}${N}   $(L "Log" "기록"): $LOG_PATH/capture.log"
    return 0
  fi
  echo "$(L "${B}Starting screen and sound capture${N} ${D}(Ctrl+C ends it. The panel turns the screen and the sound on and off separately)${N}" \
            "${B}화면과 소리 캡처를 시작합니다${N} ${D}(끝내려면 Ctrl+C. 패널에서 화면과 소리를 따로 켜고 끌 수 있습니다)${N}")"
  echo "  $(L "Panel" "패널"): ${B}${URL}${N}   $(L "Log" "기록"): $LOG_PATH/capture.log"
  term_title "Sidenote Capture"
  trap 'cmd_capture_stop quiet || true; term_title ""; echo; echo "  $(L "Capture ended." "캡처를 끝냈습니다.")"' EXIT
  trap 'exit 0' INT TERM
  # -X utf8: Windows Python writes a pipe in the ANSI code page (cp949), which turns Korean
  # device names and error messages into mojibake here and in capture.log.
  # sed -u, not tr: tr holds about 4 KB before passing anything on, so lines showed up late and
  # Ctrl+C threw away what it held (also from capture.log).
  # "${opts[@]}": the options as typed, without --console (see the top of this function).
  (cd /mnt/c && cmd.exe /c py -3 -X utf8 -u "$CLIENT_WIN" --server "ws://127.0.0.1:${PORT}/ingest" "${opts[@]}" 2>&1 | sed -u 's/\r$//' \
    | grep --line-buffered -vE "DeprecationWarning|mss.mss\(\)|^\s*with mss|UNC paths|CMD.EXE|^$" | log_capture) || true
}

# A Linux desktop: the capture program runs here, from the virtual environment ./sidenote setup-windows makes on Linux,
# reading the X11 screen (mss) and the speaker sound through PulseAudio or PipeWire's PulseAudio (soundcard). The same
# options as on WSL; --up and --console are this launcher's own.
here_py() { printf '%s' "$CAPTURE_VENV/bin/python"; }
# "tray" or "notray" as win_packages prints them, failing when one of the five does not import. Looked up, not
# imported: importing soundcard and pystray connects to the sound server and the display.
here_packages() {
  [ -x "$(here_py)" ] || return 1
  "$(here_py)" -c "import importlib.util as u, sys
if any(u.find_spec(n) is None for n in ('mss', 'soundcard', 'numpy', 'PIL', 'websocket')): sys.exit(1)
print('tray' if u.find_spec('pystray') else 'notray')" 2>/dev/null
}
cmd_setup_capture() {
  echo "${B}$(L "Installing the capture packages" "캡처 패키지를 설치합니다")${N} ($CAPTURE_VENV)"
  [ -x "$(here_py)" ] || python3 -m venv "$CAPTURE_VENV" \
    || die "$(L "Could not make a virtual environment. Install python3-venv (on Ubuntu: sudo apt install python3-venv) and run this again." \
                "가상 환경을 만들지 못했습니다. python3-venv를 설치한 뒤 다시 실행하세요 (Ubuntu: sudo apt install python3-venv).")"
  "$(here_py)" -m pip install -q -r client/requirements.txt 2>&1 | tail -3
}
cmd_capture_here() {
  local a up=0 console=0 opts=() packages
  for a in "$@"; do
    case "$a" in
      --up) up=1 ;;
      --console) console=1 ;;
      *) opts+=("$a"); if [ "$a" = --once ]; then console=1; fi ;;
    esac
  done
  packages="$(here_packages)" || { cmd_setup_capture; packages="$(here_packages)"; } \
    || die "$(L "The capture packages did not install. ./sidenote setup-windows shows why." "캡처 패키지가 설치되지 않았습니다. ./sidenote setup-windows 로 이유를 보세요.")"
  for a in "${opts[@]}"; do
    case "$a" in --list-monitors|--help|-h) "$(here_py)" -X utf8 -u client/capture.py "${opts[@]}"; return 0 ;; esac
  done
  [ -n "${DISPLAY:-}" ] || die "$(L "No X11 display here (DISPLAY is not set). The capture program reads an X11 screen: run it in the desktop session." \
                                    "여기에는 X11 화면이 없습니다 (DISPLAY가 비어 있음). 캡처 프로그램은 X11 화면을 읽습니다: 데스크톱 세션에서 실행하세요.")"
  if [ "$up" = 1 ]; then health >/dev/null || cmd_up; fi
  health >/dev/null || die "$(L "The server is off. Start it first with ./sidenote up, or start both with ./sidenote capture --up." \
                                  "서버가 꺼져 있습니다. ./sidenote up 으로 먼저 켜거나, ./sidenote capture --up 으로 함께 켜세요.")"
  [ "$(capture_running)" = 0 ] || die "$(L "The capture is already running. Quit it from the tray icon or with ./sidenote capture-stop" \
                                            "캡처가 이미 실행 중입니다. 트레이 아이콘에서 끝내거나 ./sidenote capture-stop")"
  if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    warn "$(L "A Wayland session: the screen is read through X11 (XWayland), which may show only X11 windows. If the panel shows a blank screen, log in to an X11 session." \
              "Wayland 세션입니다: 화면을 X11(XWayland)로 읽어 X11 창만 보일 수 있습니다. 패널에 빈 화면이 보이면 X11 세션으로 로그인하세요.")"
  fi
  ensure_dirs
  rotate_capture_log
  local cmd=("$(here_py)" -X utf8 -u client/capture.py --server "ws://127.0.0.1:${PORT}/ingest")
  if [ "$console" = 1 ]; then
    echo "$(L "${B}Starting screen and sound capture${N} ${D}(Ctrl+C ends it)${N}" "${B}화면과 소리 캡처를 시작합니다${N} ${D}(끝내려면 Ctrl+C)${N}")"
    "${cmd[@]}" "${opts[@]}" 2>&1 | log_capture || true
    return 0
  fi
  local base; base="$(clients)"
  # setsid --fork: a session of its own, so closing this terminal does not end it (see the WSL start above)
  setsid --fork "${cmd[@]}" --log "$LOG_PATH/capture.log" "${opts[@]}" >/dev/null 2>&1 </dev/null || true
  local n=0
  while [ "$n" -lt 20 ]; do
    capture_started "$base" && break
    n=$((n + 1)); sleep 0.5
  done
  capture_started "$base" || { bad "$(L "The capture program did not start. See what stops it with ./sidenote capture --console." "캡처 프로그램이 뜨지 않았습니다. ./sidenote capture --console 로 무엇이 막는지 보세요.")"; return 1; }
  if [ "$packages" = tray ]; then
    ok "$(L "Screen and sound capture started ${D}(a tray icon, where the desktop shows them)${N}" "화면과 소리 캡처를 시작했습니다 ${D}(데스크톱이 보여 주는 곳에 트레이 아이콘)${N}")"
  else
    ok "$(L "Screen and sound capture started ${D}(no tray icon)${N}" "화면과 소리 캡처를 시작했습니다 ${D}(트레이 아이콘 없이)${N}")"
  fi
  echo "  $(L "To end it" "끝내기"): ${B}./sidenote capture-stop${N}   $(L "Panel" "패널"): ${B}${URL}${N}   $(L "Log" "기록"): $LOG_PATH/capture.log"
}

cmd_llm() {   # the local LLM: pull, list, logs
  docker_up
  case "${1:-}" in
    pull)
      shift; local models=("$@")
      if [ ${#models[@]} -eq 0 ]; then
        mapfile -t models < <(models_to_pull)
        if [ ${#models[@]} -eq 0 ] || [ -z "${models[0]}" ]; then
          warn "$(L "No model fits this PC's GPU ${D}(no NVIDIA or AMD GPU, or 6 GB of memory or less)${N}" \
                    "이 PC의 GPU에는 맞는 모델이 없습니다 ${D}(NVIDIA나 AMD GPU가 없거나 메모리가 6GB 이하)${N}")"
          echo "     $(L "The agent solves every problem. To download one anyway: ${B}./sidenote llm pull gemma4:e2b${N}" \
                       "에이전트가 모든 문제를 풉니다. 그래도 받으려면: ${B}./sidenote llm pull gemma4:e2b${N}")"
          return 0
        fi
      fi
      # sidenote-<model> is <model> with a larger batch (compose.yaml: llm-pull), made right after the pull.
      echo "$(L "${B}Downloading this PC's model${N}: ${models[*]} ${D}(tens of GB a model; only this download container uses the internet)${N}" \
                "${B}이 PC의 모델을 받습니다${N}: ${models[*]} ${D}(모델 하나에 수십 GB, 인터넷은 이 받기 컨테이너만 씁니다)${N}")"
      docker compose --profile tools run --rm --no-deps llm-pull "${models[@]}" 2>&1 | grep -vE "^\s*$|pulling [0-9a-f]{12}" | sed 's/^/  /'
      # an if, not &&: with the server down the pull still succeeded (set -e would end on the failed test)
      if health >/dev/null; then echo "  $(L "The server picks up the model within 20 seconds." "서버가 20초 안에 모델을 알아챕니다.")"; fi ;;
    list)
      if docker ps --format '{{.Names}}' | grep -qx sidenote-llm; then docker exec sidenote-llm ollama list
      else docker compose --profile tools run --rm --no-deps --entrypoint sh llm-pull -c 'ollama serve >/dev/null 2>&1 & i=0; until ollama list >/dev/null 2>&1; do i=$((i + 1)); [ "$i" -lt 120 ] || exit 1; sleep 0.5; done; ollama list'; fi ;;
    logs) docker compose logs -f --tail 60 llm ;;
    *) die "$(L "Usage: ./sidenote llm pull [model ...] | list | logs   (model now: $LOCAL_MODEL, while the GPU is busy: $BUSY_MODEL)" \
                "사용법: ./sidenote llm pull [모델 ...] | list | logs   (지금 모델: $LOCAL_MODEL, GPU 가 바쁠 때: $BUSY_MODEL)")" ;;
  esac
}

cmd_gpu() {   # give the GPU back while you need it yourself, and take it again
  running || die "$(L "The server is off. ./sidenote up" "서버가 꺼져 있습니다. ./sidenote up")"
  docker exec -e SIDENOTE_LANG="$UI_LANG" sidenote python -m server.control gpu "$1"
