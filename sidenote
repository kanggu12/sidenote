cmd_open() {
  health >/dev/null || die "$(L "The server is off. Run ./sidenote up first" "서버가 꺼져 있습니다. 먼저 ./sidenote up")"
  local opened=1
  if [ "$ON_WSL" = 0 ]; then xdg-open "$URL" >/dev/null 2>&1 || opened=0
  else (cd /mnt/c && cmd.exe /c start "" "$URL" >/dev/null 2>&1) || opened=0; fi
