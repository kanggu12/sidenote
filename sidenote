cmd_install() {   # everything a first run needs, in the order it needs it
  # One command instead of four in the right order. Every step is skipped when it is already done,
  # so running it again after a change is safe and says what it did rather than redoing it.
  # --with-models: pull the models too. Named apart from cmd_llm's own `models` list, which shellcheck
  # would otherwise take for this one.
  local with_models=0
  [ "${1:-}" = "--with-models" ] && with_models=1
  echo "$(L "${B}Installing Sidenote${N} ${D}(steps already done are skipped)${N}" "${B}Sidenote를 설치합니다${N} ${D}(이미 된 단계는 건너뜁니다)${N}")"
  echo
  echo "${B}1/4${N} $(L "Server" "서버")"
  if health >/dev/null; then ok "$(L "Already running" "이미 실행 중입니다")"; else cmd_up; fi
  echo
  if [ "$ON_WSL" = 0 ]; then echo "${B}2/4${N} $(L "Capture packages" "캡처 패키지")"
  else echo "${B}2/4${N} $(L "Windows capture packages" "Windows 캡처 패키지")"; fi
  # Done only when the tray icon's pystray is there too: it joined client/requirements.txt after the
  # first setups, and a check of the five capture packages alone skipped this step on those for good. pip
  # installs what is missing and leaves what is there as it is.
  local packages
  if [ "$ON_WSL" = 0 ]; then packages="$(here_packages)" || packages=""; else packages="$(win_packages 2>/dev/null)" || packages=""; fi
  if [ "$packages" = tray ]; then
    ok "$(L "Already installed" "이미 설치돼 있습니다")"
  else
    cmd_setup_windows
  fi
  echo
  echo "${B}3/4${N} $(L "This PC's model" "이 PC의 모델")"
  if [ "$ANALYZER" != local ]; then
    ok "$(L "This server uses the agent only (SIDENOTE_ANALYZER=$ANALYZER): no model to download" "이 서버는 에이전트만 씁니다 (SIDENOTE_ANALYZER=$ANALYZER): 받을 모델이 없습니다")"
  elif [ "$with_models" = 1 ]; then
    cmd_llm pull
  elif [ -n "$(cmd_llm list 2>/dev/null | grep -E "gemma4|${LOCAL_MODEL%%:*}" || true)" ]; then
    ok "$(L "Already downloaded" "이미 받아 뒀습니다")"
  else
    # Tens of gigabytes: never started without being asked for, only pointed at.
    local want; want="$(models_to_pull | head -1 || true)"
    warn "$(L "Not downloaded yet. ${B}./sidenote llm pull${N} ${D}(the model for this GPU: ${want}, a few GB to tens of GB)${N}" \
              "아직 안 받았습니다. ${B}./sidenote llm pull${N} ${D}(GPU에 맞는 모델: ${want}, 수 GB에서 수십 GB)${N}")"
    echo "     $(L "Until then the agent solves every problem." "받기 전까지는 에이전트가 모든 문제를 풉니다.")"
  fi
  echo
  echo "${B}4/4${N} $(L "Desktop shortcut" "바탕화면 바로가기")"
  if [ "$ON_WSL" = 0 ]; then ok "$(L "Not on Linux: ${B}./sidenote capture --up${N} starts the server and the capture together" "Linux에서는 없음: ${B}./sidenote capture --up${N} 이 서버와 캡처를 함께 시작합니다")"
  else cmd_shortcut; fi
  echo
  cmd_doctor
}

cmd_version() {   # what is actually installed and running, in one place
  # The question behind this is always the same: which of these were updated. Each line is read
  # from the thing itself, not from a file that says what it should be.
  # The labels are padded by hand: Korean letters take two columns in a terminal, which printf's
  # own width does not know, so %-14s would leave a ragged column.
  row() { printf '  %s%s %s\n' "$1" "$(printf '%*s' $(( 18 - $2 )) '')" "$2$3"; }
  say() { printf '  %s\n' "$1"; }
  echo "${B}Sidenote${N}"
  local commit; commit="$(git -C "$PWD" log -1 --format='%h %cd' --date=short 2>/dev/null || true)"
  # Each label as it prints, the padding included: English pads to 16 columns as the Korean does.
  printf '  %s%s\n' "$(L 'Source          ' '소스            ')" "${commit:-$(L "(not a git repository)" "(git 저장소 아님)")}"
  local img; img="$(docker image inspect sidenote:local --format '{{slice .Id 7 19}}  {{slice .Created 0 10}}' 2>/dev/null || true)"
  printf '  %s%s\n' "$(L 'Server image    ' '서버 이미지     ')" "${img:-$(L "not built yet" "아직 만들지 않음")}"
  printf '  %s%s\n' "$(L 'Panel build     ' '패널 빌드       ')" \
    "$(curl -fsS --max-time 3 "$URL/health" 2>/dev/null | json 'd.get("build") or "-"' 2>/dev/null || L "server off" "서버 꺼짐")"
  local cv; cv="$(claude_version)"   # empty when this PC has no Claude Code, shown as "-"
  printf "  Claude Code     %s $(L "(this PC) / %s (container)" "(이 PC) / %s (컨테이너)")\n" "${cv:--}" \
    "$(docker exec sidenote claude --version 2>/dev/null | awk '{print $1}' || echo '-')"
  local xv; xv="$(codex_version)"
  printf "  Codex           %s $(L "(this PC) / %s (container)" "(이 PC) / %s (컨테이너)")\n" "${xv:--}" \
    "$(docker exec sidenote codex --version 2>/dev/null | awk '{print $2}' || echo '-')"
  printf '  %s%s\n' "$(L 'Model server    ' '모델 서버       ')" "ollama/ollama:$(setting SIDENOTE_OLLAMA_VERSION 0.40.5)"
  printf '  %s%s\n' "$(L 'Search engine   ' '검색 엔진       ')" "searxng/searxng:$(setting SIDENOTE_SEARXNG_VERSION 2026.10.7-6671d89be)"
  # only from a model server that is up: asking with it down started a container, and could pull its image, for a version
  if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx sidenote-llm; then
    printf '  %s%s\n' "$(L 'Models pulled   ' '받아 둔 모델    ')" \
      "$(cmd_llm list 2>/dev/null | tail -n +2 | awk '$1 ~ /^sidenote-/ {print $1}' | paste -sd" " - || echo '-')"
  else
    printf '  %s%s\n' "$(L 'Models pulled   ' '받아 둔 모델    ')" "$(L "- (the model server is off, ./sidenote llm list)" "- (모델 서버가 꺼져 있음, ./sidenote llm list)")"
  fi
  printf '  %s%s\n' "$(L 'Log folder      ' '로그 폴더       ')" "$LOG_PATH"
}

cmd_uninstall() {   # take back everything this project put on the PC
  # Listed first, removed only on --yes: volumes hold the models (tens of GB) and the logs, and
  # nothing here is worth losing to a typed command.
  local purge=0
  [ "${1:-}" = "--yes" ] && purge=1
  echo "${B}$(L "What Sidenote made on this PC" "Sidenote가 이 PC에 만든 것")${N}"
  echo "  $(L "Containers: " "컨테이너: ")$(docker ps -a --filter name=sidenote --format '{{.Names}}' | paste -sd' ' - || true)"
  echo "  $(L "Images:     " "이미지:   ")sidenote:local, sidenote-runner:local"
  echo "  $(L "Volumes:    " "볼륨:     ")$(docker volume ls --format '{{.Name}}' | grep '^sidenote_' | paste -sd' ' - || true)"
  echo "  $(L "Shortcut:   Sidenote Capture.lnk on the desktop" "바로가기: 바탕화면 Sidenote Capture.lnk")"
  echo "  $(L "Logs:       " "로그:     ")$LOG_PATH"
  echo "  ${D}$(L "(the models are in the volume sidenote_llm-models: tens of GB, downloaded again once removed)" "(모델은 볼륨 sidenote_llm-models 안에 있습니다: 수십 GB, 지우면 다시 받아야 합니다)")${N}"
  if [ "$purge" != 1 ]; then
    echo
    warn "$(L "Nothing removed. To remove it all: ${B}./sidenote uninstall --yes${N}" "아무것도 지우지 않았습니다. 정말 지우려면 ${B}./sidenote uninstall --yes${N}")"
    return 0
  fi
  echo
  cmd_capture_stop quiet || true          # the Windows program first: it is the only thing outside docker
  cmd_shortcut --remove >/dev/null 2>&1 || true
  local rc=0
  docker compose --profile '*' down -v --remove-orphans 2>&1 | sed 's/^/  /' || rc=$?
  docker image rm -f sidenote:local sidenote-runner:local >/dev/null 2>&1 || true
  if [ "$rc" = 0 ]; then ok "$(L "Removed the containers, images, volumes and shortcut." "컨테이너, 이미지, 볼륨, 바로가기를 지웠습니다.")"
  else warn "$(L "Could not remove the containers and volumes (Docker may be off). Start Docker and run this again." \
                  "컨테이너와 볼륨을 지우지 못했습니다(Docker가 꺼져 있을 수 있습니다). Docker를 켠 뒤 다시 실행하세요.")"; fi
  echo "  $(L "Logs kept: $LOG_PATH ${D}(delete them yourself if they are not needed)${N}" "로그는 남겼습니다: $LOG_PATH ${D}(필요 없으면 직접 지우세요)${N}")"
}

cmd_shortcut() {   # a Desktop shortcut that starts the capture program, so it takes one click
  local distro="${WSL_DISTRO_NAME:-}"
  [ -n "$distro" ] || die "$(L "The WSL distribution's name is not known (WSL_DISTRO_NAME)." "WSL 배포판 이름을 알 수 없습니다 (WSL_DISTRO_NAME).")"
  local name="Sidenote Capture.lnk"
  local old_names=("Sidenote 캡처.lnk")   # names this command used before
  local desktop; desktop="$(winps "[Environment]::GetFolderPath('Desktop')" | tr -d '\r' | head -1)"
  [ -n "$desktop" ] || die "$(L "Could not find the Windows desktop folder." "Windows 바탕화면 경로를 찾지 못했습니다.")"
  desktop="$(ps_quote "$desktop")"   # a path can hold a quote; PowerShell wants it doubled
  local lnk="$desktop\\$name"
  if [ "${1:-}" = "--remove" ]; then
    local gone=0 f
    for f in "$name" "${old_names[@]}"; do
      if [ -n "$(winps "if (Test-Path -LiteralPath '$desktop\\$f') { 'y' }")" ]; then
        winps "Remove-Item -LiteralPath '$desktop\\$f' -ErrorAction SilentlyContinue" >/dev/null || true
        ok "$(L "Shortcut removed: $f" "바로가기를 지웠습니다: $f")"
        gone=$((gone + 1))
      fi
    done
    [ "$gone" = 0 ] && echo "  $(L "No shortcut on the desktop to remove." "바탕화면에 지울 바로가기가 없습니다.")"
    return 0
  fi
  # Nothing this shortcut starts has a window: pyw.exe, the Python launcher that opens no console, runs
  # client/launch.pyw, and that runs `./sidenote capture --up` here through wsl.exe without a console window
  # either (the top of launch.pyw says how). The shortcut used to start wsl.exe itself, and wsl.exe opens a
  # console window for the launcher: it came up on every start, though a start needs no terminal, and it was
  # where a failure was shown. launch.pyw shows a failure in a message box instead, with
  # the last lines the launcher printed, and says so when a second click comes while a start is still going.
  # --up starts the server first when it is not running: after a reboot nothing is.
  # pyw.exe by its full path: the shortcut runs with Explorer's PATH, which need not be the one seen here.
  local pyw; pyw="$(winps "(Get-Command pyw.exe -ErrorAction SilentlyContinue).Source" | head -1)"
  # Without it the shortcut would have nothing to run, and a double click would do nothing at all.
  [ -n "$pyw" ] || die "$(L "No Python launcher (pyw.exe) on Windows, so no shortcut can be made. Install Python for Windows from python.org, then ./sidenote setup-windows and ./sidenote shortcut" \
                             "Windows에 Python 런처(pyw.exe)가 없어 바로가기를 만들 수 없습니다. python.org에서 Windows용 Python을 설치한 뒤 ./sidenote setup-windows 와 ./sidenote shortcut")"
  local launch; launch="$(wslpath -w "$PWD/client/launch.pyw")"   # this checkout's copy, read from WSL's share
  # The two paths in double quotes for the Windows command line, so one with spaces stays one argument; the
  # distribution name has none (WSL allows letters, digits, '.', '_' and '-'). capture.py's path must not be in
  # here: capture and capture-stop find the capture program by it. The single quotes of PowerShell's own strings
  # below are doubled inside them (ps_quote).
  local args="-3 \"$launch\" --distro $distro --repo \"$PWD\""
  winps "\$s = (New-Object -ComObject WScript.Shell).CreateShortcut('$lnk');
         \$s.TargetPath = '$(ps_quote "$pyw")';
         \$s.Arguments = '$(ps_quote "$args")';
         \$s.Description = '$(L "Sidenote: start screen and sound capture (quit from the tray icon)" "Sidenote: 화면과 소리 캡처 시작 (트레이 아이콘에서 끕니다)")';
         \$s.IconLocation = \"\$env:SystemRoot\\System32\\shell32.dll,16\";
         \$s.Save()" >/dev/null
  if [ -n "$(winps "if (Test-Path -LiteralPath '$lnk') { 'y' }")" ]; then
    ok "$(L "Desktop shortcut made: $name" "바탕화면에 바로가기를 만들었습니다: $name")"
    local f
    for f in "${old_names[@]}"; do   # one left over from when this command used another name
      if [ -n "$(winps "if (Test-Path -LiteralPath '$desktop\\$f') { 'y' }")" ]; then
        winps "Remove-Item -LiteralPath '$desktop\\$f' -ErrorAction SilentlyContinue" >/dev/null || true
        ok "$(L "Removed the shortcut under its old name: $f" "옛 이름의 바로가기를 지웠습니다: $f")"
      fi
    done
    echo "  $(L "A double click starts the server and the capture with no window, and a tray icon appears in the notification area." \
                "두 번 누르면 창 없이 서버와 캡처가 함께 시작되고, 알림 영역에 트레이 아이콘이 나타납니다.")"
    echo "  ${D}$(L "(the first time and after an update, building the server image takes a few minutes. A start that fails says why in a message box)" \
                    "(처음이나 업데이트한 뒤에는 서버 이미지를 만드느라 몇 분 걸립니다. 시작하지 못하면 그 이유를 메시지 상자로 알려 줍니다)")${N}"
    echo "  $(L "Quit from the tray icon. To remove the shortcut: ./sidenote shortcut --remove" "끝낼 땐 트레이 아이콘에서 종료. 지울 땐 ./sidenote shortcut --remove")"
  else
    die "$(L "Could not make the shortcut." "바로가기를 만들지 못했습니다.")"
  fi
}

cmd_setup_windows() {
  if [ "$ON_WSL" = 0 ]; then cmd_setup_capture; return; fi
  local req; req="$(wslpath -w "$PWD/client/requirements.txt")"
  echo "${B}$(L "Installing the capture packages into Windows Python" "Windows Python에 캡처 패키지를 설치합니다")${N} ($req)"
  (cd /mnt/c && cmd.exe /c py -3 -m pip install --user -r "$req" 2>&1 | tr -d '\r' | tail -3)
}

cmd_doctor() {
  echo "${B}$(L "Checks" "점검")${N}"
  local v
  FAILS=0
  if ! command -v docker >/dev/null; then bad "$(L "docker not installed" "docker 없음")"
  elif v="$(docker version --format '{{.Server.Version}}' 2>/dev/null)" && [ -n "$v" ]; then ok "docker $v"
  else bad "$(L "Cannot connect to Docker (Docker is off)" "Docker에 연결할 수 없음 (Docker가 꺼져 있습니다)")"; fi
  docker image inspect sidenote:local >/dev/null 2>&1 && ok "$(L "Image sidenote:local" "이미지 sidenote:local")" \
    || warn "$(L "No image (./sidenote up builds it)" "이미지 없음 (./sidenote up 이 만듭니다)")"
  local how
  if [ "$ANALYZER" = local ]; then
    ok "$(L "Solving: this PC's model ($LOCAL_MODEL) and the agent ($AGENT)" "풀이: 이 PC의 모델 ($LOCAL_MODEL)과 에이전트 ($AGENT)")"
    local gpu; gpu="$(python3 - <<'PY' 2>/dev/null
import sys
sys.path.insert(0, "server")
import hardware
gpu = hardware.best(hardware.detect())
print(f"{gpu.name}, {gpu.memory_gb:.0f} GB ({gpu.vendor})" if gpu else "")
PY
)"
    if [ -n "$gpu" ]; then ok "GPU: $gpu ${D}(${COMPOSE_FILE#compose.yaml:})${N}"
    else warn "$(L "No NVIDIA or AMD GPU found: the local model runs on the CPU, slowly ${D}(${COMPOSE_FILE#compose.yaml:})${N}" \
                   "NVIDIA나 AMD GPU를 찾지 못함: 이 PC의 모델이 CPU에서 느리게 돕니다 ${D}(${COMPOSE_FILE#compose.yaml:})${N}")"; fi
  fi
  # With the local LLM, the agent is the second engine: without a login the local model solves everything.
  local nologin=bad; [ "$ANALYZER" = local ] && nologin=warn
  case "$AGENT" in
    codex)
      how="$(codex_login)"
      if [ -n "$how" ]; then ok "Codex $(codex_version): $(L "signed in ($how). The server uses this login" "로그인됨 ($how). 서버가 이 로그인을 씁니다")"
      else "$nologin" "$(L "Codex not signed in (./sidenote login codex)" "Codex 로그인 안 됨 (./sidenote login codex)")"; fi ;;
    claude-code)
      how="$(claude_login)"
      if ! command -v claude >/dev/null; then "$nologin" "$(L "Claude Code (claude) not installed (install it first)" "Claude Code(claude) 없음 (먼저 설치)")"
      elif [ -n "$how" ]; then ok "Claude Code $(claude_version): $(L "signed in ($how). The server uses this login" "로그인됨 ($how). 서버가 이 로그인을 씁니다")"
      else "$nologin" "$(L "Claude Code not signed in (./sidenote login)" "Claude Code 로그인 안 됨 (./sidenote login)")"; fi ;;
    anthropic-api)
      if [ -n "$(setting ANTHROPIC_API_KEY "")" ]; then ok "$(L "Anthropic API: key set (.env)" "Anthropic API: 키 있음 (.env)")"
      else "$nologin" "$(L "Anthropic API: no ANTHROPIC_API_KEY in .env" "Anthropic API: .env에 ANTHROPIC_API_KEY가 없음")"; fi ;;
    off) warn "$(L "Agent: off (SIDENOTE_AGENT=off): this PC's model solves alone" "에이전트: 꺼 둠 (SIDENOTE_AGENT=off): 이 PC의 모델만 풉니다")" ;;
  esac
  if [ "$ON_WSL" = 0 ]; then
    local here; here="$(here_packages)" || here=""
    case "$here" in
      tray|notray) ok "$(L "Capture packages installed" "캡처 패키지 설치됨") ${D}($CAPTURE_VENV)${N}" ;;
      *) bad "$(L "Capture packages missing (./sidenote setup-windows installs them here)" "캡처 패키지 없음 (./sidenote setup-windows 가 여기에 설치합니다)")" ;;
    esac
    [ -n "${DISPLAY:-}" ] || warn "$(L "No X11 display in this shell (DISPLAY): start the capture from the desktop session" "이 셸에는 X11 화면이 없음 (DISPLAY): 캡처는 데스크톱 세션에서 시작하세요")"
  elif win py -3 --version >/dev/null; then
    ok "Windows Python: $(win py -3 --version | tail -1)"
    local packages; packages="$(win_packages)" || packages=""   # "tray", "notray", or nothing when one is missing
    case "$packages" in
      tray) ok "$(L "Capture packages installed" "캡처 패키지 설치됨")" ;;
      # The program runs without pystray, only with no icon: windowless it then has neither a window nor an icon.
      notray) ok "$(L "Capture packages installed" "캡처 패키지 설치됨")"
              warn "$(L "No tray icon package (pystray): it runs without an icon (./sidenote setup-windows)" "트레이 아이콘 패키지(pystray) 없음: 아이콘 없이 돌아갑니다 (./sidenote setup-windows)")" ;;
      *) bad "$(L "Capture packages missing (./sidenote setup-windows)" "캡처 패키지 없음 (./sidenote setup-windows)")" ;;
    esac
  else
    bad "$(L "No Windows Python (py) (install Python for Windows from python.org, then ./sidenote setup-windows)" \
             "Windows Python(py) 없음 (python.org에서 Windows용 Python을 설치한 뒤 ./sidenote setup-windows)")"
  fi
  if [ -d "$LOG_PATH" ]; then
    local used days; used="$(du -sh "$LOG_PATH" 2>/dev/null | cut -f1)"; days="$(setting SIDENOTE_LOG_DAYS 14)"
    ok "$(L "Log folder: $LOG_PATH ($used, ${LOG_MAX_MB} MB × $((LOG_FILES + 1)) files, kept ${days} days)" \
            "로그 폴더: $LOG_PATH ($used, 파일당 ${LOG_MAX_MB} MB × $((LOG_FILES + 1))개, ${days}일 보관)")"
  fi
  cmd_status
  (( FAILS == 0 ))
}

cmd_help() {   # the same text in each language, English first
  if [ "$UI_LANG" != ko ]; then
    cat <<EOF
${B}Sidenote${N}: solves the problems on your screen and in its sound in real time, with this PC's model and a cloud agent (Claude Code, Codex), and writes the answers in a panel.

  ${B}Start and stop${N}
    ./sidenote install        First install: server, capture packages, shortcut, checks (--with-models adds the models)
    ./sidenote version        Versions of what is installed
    ./sidenote up             Start the server (builds the image the first time). In use, it waits until idle, then restarts
    ./sidenote up --now       Restart at once, without waiting
                              A commit that failed CI does not go up. --when-green: wait for CI and go up when it passes, --no-ci: go up anyway
    ./sidenote qa [server|panel]  Run the suites CI runs, on this PC (the results table: results.md in the output folder)
    ./sidenote capture        Start Windows screen and sound capture (runs windowless with a tray icon, and this command returns at once.
                              To end it: Quit in the tray icon, or ./sidenote capture-stop)
                              Options: --monitor 2   --list-monitors   --stitch (joins a long problem as you scroll;
                                    the monitor and scroll joining are also in the panel's Solving settings)
                                    --no-audio   --audio-device "part of the device name"
                                    --console (runs in this terminal, Ctrl+C ends it)   --once (sends one screen and ends)
                                    --no-auto-update (does not restart itself when new code is deployed)
    ./sidenote capture-restart  Restart the capture program now (into capture.py as it is now; after a deploy it does so by itself when quiet)
    ./sidenote open           Open the panel in the browser  ($URL)
    ./sidenote down           Stop everything
    ./sidenote restart        Restart the server (enough after changing .env or the code)

  ${B}First time${N}
    ./sidenote login [codex]  Check the agent's login (Claude Code, or Codex with codex. Uses this PC's own login)
    ./sidenote setup-windows  Install the capture packages on the Windows side
    ./sidenote shortcut       Make a desktop shortcut that starts the capture (--remove removes it)
    ./sidenote llm pull       Download the model that fits this PC's GPU, or the ones named (a few GB to tens of GB)
    ./sidenote llm list|logs  Downloaded models, the model server's log

  ${B}Status and records${N}
    ./sidenote status         Server, login, capture and code runner status
    ./sidenote stats          Answers, tokens, cost, response times and the last error since the server started (--json)
    ./sidenote events         Recent events (-n 50, --errors for errors and stalls only)
    ./sidenote report         Summary by day and for the whole period (first token by engine, agent cost, GPU busy, example checks) (--days 30, --json)
    ./sidenote logs           Follow the server log
    ./sidenote doctor         Check the install
    ./sidenote capture-stop   End a capture program that is left running
    ./sidenote uninstall      List what was made on this PC (--yes removes it)
    ./sidenote gpu off|on     Turn this PC's model off while the GPU does other work, and on again (while off the agent solves everything, and a limit does not load the model again)

  Log folder: $LOG_PATH
EOF
    return 0
  fi
  cat <<KOHELP
${B}Sidenote${N}: 화면과 소리 속 문제를 이 PC의 모델과 클라우드 에이전트(Claude Code, Codex)가 실시간으로 풀어 패널에 적어 줍니다.

  ${B}시작과 끝${N}
    ./sidenote install        처음 설치: 서버, 캡처 패키지, 바로가기, 점검 (--with-models면 모델까지)
    ./sidenote version        지금 깔려 있는 것들의 버전
    ./sidenote up             서버 시작 (처음엔 이미지를 만듭니다). 쓰는 중이면 쉴 때까지 기다렸다가 다시 시작
    ./sidenote up --now       기다리지 않고 바로 다시 시작
                              CI가 실패한 커밋은 올리지 않습니다. --when-green: CI 결과를 기다렸다가 통과하면 올림, --no-ci: 그냥 올림
    ./sidenote qa [server|panel]  CI가 돌리는 테스트 묶음을 이 PC에서 그대로 실행 (결과표: 출력 폴더의 results.md)
    ./sidenote capture        Windows 화면과 소리 캡처 시작 (창 없이 트레이 아이콘으로 돌고, 이 명령은 바로 끝납니다.
                              끝내기는 트레이 아이콘의 끝내기나 ./sidenote capture-stop)
                              옵션: --monitor 2   --list-monitors   --stitch (긴 문제를 스크롤로 모음,
                                    모니터와 스크롤 이어 붙이기는 패널의 풀이 설정에서도 바꿉니다)
                                    --no-audio   --audio-device "장치 이름 일부"
                                    --console (이 터미널에서 돌고 Ctrl+C로 끝)   --once (한 장만 보내고 끝)
                                    --no-auto-update (새 코드를 배포해도 스스로 다시 시작하지 않음)
    ./sidenote capture-restart  캡처 프로그램을 지금 다시 시작 (지금 capture.py로. 배포하면 쉬는 때에 스스로도 함)
    ./sidenote open           패널을 브라우저로 열기  ($URL)
    ./sidenote down           모두 멈추기
    ./sidenote restart        서버를 다시 시작 (.env나 코드를 바꾼 뒤에도 이것으로 충분)

  ${B}처음 한 번${N}
    ./sidenote login [codex]  에이전트 로그인 확인 (Claude Code, codex를 붙이면 Codex. 이 PC의 로그인을 그대로 씁니다)
    ./sidenote setup-windows  Windows 쪽 캡처 패키지 설치
    ./sidenote shortcut       바탕화면에 캡처 시작 바로가기 만들기 (--remove로 지움)
    ./sidenote llm pull       이 PC의 GPU에 맞는 모델 받기, 이름을 적으면 그 모델 (수 GB에서 수십 GB)
    ./sidenote llm list|logs  받아 둔 모델, 모델 서버 로그

  ${B}상태와 기록${N}
    ./sidenote status         서버, 로그인, 캡처, 코드 실행기 상태
    ./sidenote stats          서버를 켠 뒤의 답 수, 토큰, 비용, 응답 시간, 마지막 오류 (--json)
    ./sidenote events         최근 기록 (-n 50, --errors 오류와 멈춘 일만)
    ./sidenote report         날짜별 요약과 기간 전체(엔진별 첫 글자, 에이전트 비용, GPU 바쁨, 예제 검사) (--days 30, --json)
    ./sidenote logs           서버 로그 실시간 보기
    ./sidenote doctor         설치 점검
    ./sidenote capture-stop   남아 있는 캡처 프로그램 끄기
    ./sidenote uninstall      이 PC에서 만든 것 목록 (--yes를 붙여야 실제로 지웁니다)
    ./sidenote gpu off|on     GPU를 다른 작업에 쓰는 동안 이 PC 모델 끄기, 다시 켜기 (끈 동안은 에이전트가 모두 풀고, 한도에 닿아도 다시 올리지 않습니다)

  기록 폴더: $LOG_PATH
KOHELP
}

case "${1:-help}" in
  install) shift; cmd_install "$@" ;;
  version|--version) cmd_version ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  up|start) shift
    for a in "$@"; do
      case "$a" in
        --now) UP_NOW=1 ;;
        --no-ci) UP_NO_CI=1 ;;
        --when-green) UP_WHEN_GREEN=1 ;;
        *) die "$(L "Unknown option: $a (./sidenote up [--now] [--no-ci] [--when-green])" "모르는 옵션입니다: $a (./sidenote up [--now] [--no-ci] [--when-green])")" ;;
      esac
    done
    ci_gate     # asked of a deploy, before its build; a restart or an install has its own reasons and is not held up
    cmd_up ;;
  qa) shift; cmd_qa "$@" ;;
  down|stop) cmd_down ;;
  restart) running || die "$(L "The server is off. ./sidenote up" "서버가 꺼져 있습니다. ./sidenote up")"; [ "${2:-}" = --now ] && UP_NOW=1
    # Not held up: a restart has its own reasons. But it builds what is here, and says so if that has failed
    case "$(ci_state)" in
      failure|cancelled|timed_out|startup_failure)
        warn "$(L "This commit failed CI. Restarting with the code as it is." "이 커밋은 CI를 통과하지 못했습니다. 지금 코드로 다시 시작합니다.")" ;;
    esac
    cmd_up recreate ;;
  status) cmd_status ;;
  stats) shift
    running || die "$(L "The server is off. ./sidenote up (what happened while it was off: ./sidenote events)" "서버가 꺼져 있습니다. ./sidenote up (꺼진 동안의 기록은 ./sidenote events)")"
    in_image stats "$@" ;;
  events) shift; in_image events "$@" ;;
  report) shift; in_image report "$@" ;;
  logs) cmd_logs ;;
  login) cmd_login "${2:-}" ;;
  capture) shift; cmd_capture "$@" ;;
  capture-stop) cmd_capture_stop ;;
  capture-restart) cmd_capture_restart ;;
  open) cmd_open ;;
  llm) shift; cmd_llm "$@" ;;
  gpu) shift; cmd_gpu "${1:-status}" ;;
  doctor) cmd_doctor ;;
  setup-windows) cmd_setup_windows ;;
  shortcut) shift; cmd_shortcut "$@" ;;
  help|-h|--help) cmd_help ;;
  *) printf '%s%s: %s%s\n\n' "$R" "$(L "Unknown command" "알 수 없는 명령입니다")" "$1" "$N" >&2; cmd_help; exit 1 ;;
esac
