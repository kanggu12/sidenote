#!/usr/bin/env bash
# Sidenote control script: the one command to remember. Run `./sidenote help`.
# The server runs in a container (docker compose). The screen and sound capture program runs in Windows Python,
# started from here through WSL interop, or on a Linux desktop of its own. It runs windowless with a tray icon and
# is ended from that icon or with `./sidenote capture-stop`; with --console it stays in the
# terminal and Ctrl+C ends it.
set -euo pipefail
# This script's folder, through any links to it: by hand, as macOS before 12.3 has no readlink -f
self="$0"
while [ -L "$self" ]; do link="$(readlink "$self")"; case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac; done
# The folder this was started from, kept before the cd below: a file named on the command line (backup, restore) is
# read from it, and a backup made without a name is written there
CALLER_PWD="$PWD"
cd "$(dirname "$self")"

# Settings in .env apply here too (compose reads the same file); the environment wins. Read the
# way compose reads it: an "export " prefix, quotes, and a " # comment" after an unquoted value.
dotenv() {
  [ -f .env ] || return 0
  local v
  v="$(grep -E "^[[:space:]]*(export[[:space:]]+)?$1[[:space:]]*=" .env | tail -1 | tr -d '\r')" || true
  [ -n "$v" ] || return 0
  v="${v#*=}"; v="${v#"${v%%[![:space:]]*}"}"
  case "$v" in
    \"*) v="${v#\"}"; v="${v%%\"*}" ;;
    \'*) v="${v#\'}"; v="${v%%\'*}" ;;
    *) v="${v%%[[:space:]]#*}"; v="${v%"${v##*[![:space:]]}"}" ;;
  esac
  printf '%s' "$v"
}
setting() { local v="${!1:-}"; [ -n "$v" ] || v="$(dotenv "$1")"; printf '%s' "${v:-$2}"; }
PORT="$(setting SIDENOTE_PORT 8777)"
URL="http://127.0.0.1:${PORT}"
LOG_PATH="$(setting SIDENOTE_LOG_PATH "$HOME/.local/state/sidenote/logs")"
LOG_MAX_MB="$(setting SIDENOTE_LOG_MAX_MB 5)"    # same caps as the server's own logs (server/telemetry.py)
LOG_FILES="$(setting SIDENOTE_LOG_FILES 4)"
LOG_MAX_MB="${LOG_MAX_MB%%.*}"   # whole MB here (bash arithmetic); at least 1 file of 1 MB (the server, in bytes, allows 64 KB)
[[ $LOG_MAX_MB =~ ^[0-9]+$ ]] || LOG_MAX_MB=5; (( LOG_MAX_MB >= 1 )) || LOG_MAX_MB=1
LOG_FILES="${LOG_FILES%%.*}"; [[ $LOG_FILES =~ ^[0-9]+$ ]] || LOG_FILES=4; (( LOG_FILES >= 1 )) || LOG_FILES=1
# Who solves, read the way the server reads it (server/config.py), so the two always agree on whether the local
# model's containers are needed: case and the spaces around it do not matter, "claude" means the API, and an empty
# or unknown value runs as "local" (the server says so in its log). Compared as it was typed,
# SIDENOTE_ANALYZER=Local ran the server in local mode while the "local" profile below stayed off, so the local
# model and its web search were never started and every answer said the local model did not respond.
ANALYZER="$(setting SIDENOTE_ANALYZER local | tr '[:upper:]' '[:lower:]')"
ANALYZER="${ANALYZER#"${ANALYZER%%[![:space:]]*}"}"   # the leading spaces off
ANALYZER="${ANALYZER%"${ANALYZER##*[![:space:]]}"}"   # and the trailing ones
case "$ANALYZER" in
  local|agent|cli|api|mock) ;;   # the ones the server knows ("cli" and "api" are the agent alone, as "agent" is)
  claude) ANALYZER=api ;;        # its old name for the API
  *) ANALYZER=local ;;           # anything else, as the server does
esac
# The cloud agent, read the way the server reads it (server/config.py): SIDENOTE_AGENT, else SIDENOTE_CLAUDE, its
# earlier name, else the one the analyzer mode implies.
AGENT="$(setting SIDENOTE_AGENT "$(setting SIDENOTE_CLAUDE "")" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
case "$AGENT" in
  claude-code|codex|anthropic-api|off|mock) ;;
  cli|claude|claude-cli) AGENT=claude-code ;;
  api) AGENT=anthropic-api ;;
  "") case "$ANALYZER" in api|claude) AGENT=anthropic-api ;; mock) AGENT=mock ;; *) AGENT=claude-code ;; esac ;;
  *) AGENT=claude-code ;;
esac
# The GPU the local model gets picks compose.yaml's companion file: docker/compose.nvidia.yaml, docker/compose.amd.yaml,
# or docker/compose.cpu.yaml when there is neither (server/hardware.py finds it). docker compose reads COMPOSE_FILE itself,
# so one set in the environment or in .env stays as it is; otherwise the one found here is exported for every compose
# command.
# A GPU counts only when a model can run on it: one named in the settings (SIDENOTE_LOCAL_MODEL), or for "auto" one
# that fits its memory (server/models.py: fits). An integrated Radeon with 512 MB picked compose.amd.yaml, whose ROCm
# image is several GB and whose container does not start without /dev/kfd, for a GPU no model would be loaded on.
# And amd only where that device is: compose.amd.yaml hands /dev/kfd to the container, and Docker refuses to start
# one whose device is missing (no ROCm driver here). SIDENOTE_KFD stands in for the device in tests/launcher_args.sh.
KFD="${SIDENOTE_KFD:-/dev/kfd}"
gpu_vendor() {
  python3 - "$(setting SIDENOTE_LOCAL_MODEL auto)" "$KFD" <<'PY' 2>/dev/null || echo cpu
import os, sys
sys.path.insert(0, "server")
import hardware, models
named, kfd = sys.argv[1].strip().lower() not in ("", "auto"), sys.argv[2]
gpu = hardware.best(hardware.detect())
vendor = gpu.vendor if gpu and gpu.vendor in ("nvidia", "amd") else "cpu"
if vendor != "cpu" and not named and models.fits(gpu.memory_gb) is None:
    vendor = "cpu"   # too small for the smallest model, and none is named: nothing would be loaded on it
if vendor == "amd" and not os.path.exists(kfd):
    vendor = "cpu"   # no ROCm device node: the container could not be started with it
print(vendor)
PY
}
COMPOSE_FILE="$(setting COMPOSE_FILE "")"
[ -n "$COMPOSE_FILE" ] || COMPOSE_FILE="compose.yaml:docker/compose.$(gpu_vendor).yaml"
export COMPOSE_FILE
# AMD: the ROCm device nodes belong to the host's render group, whose number differs from one distribution to the next
# and which the Ollama image has no name for (Docker does not start a container given a group name its image lacks).
# The number of the group that owns /dev/kfd on this PC goes to compose.amd.yaml, unless the settings name one.
# stat -c is GNU's, and ROCm is Linux only; where it prints nothing the file's own default stands.
case "$COMPOSE_FILE" in
  *compose.amd.yaml*)
    if [ -z "$(setting SIDENOTE_RENDER_GID "")" ]; then
      render_gid="$(stat -c %g "$KFD" 2>/dev/null || true)"
      case "$render_gid" in ''|*[!0-9]*) ;; *) export SIDENOTE_RENDER_GID="$render_gid" ;; esac   # a number, or left alone
    fi ;;
esac
# A PC with no way to the internet (docs/air-gapped.md): SIDENOTE_OFFLINE=1 in .env. The images came with a bundle, so nothing is
# built or pulled, a build's apt and pip being the first things to fail there, and a model is brought, not downloaded.
offline() { case "$(setting SIDENOTE_OFFLINE "" | tr '[:upper:]' '[:lower:]')" in 1|true|yes|on) return 0 ;; esac; return 1; }

# The CI check before a deploy is for maintainers: only with SIDENOTE_CI_GATE=1 (the environment or .env) does `up`
# ask gh what CI said of the commit. Without it nothing here asks gh, and no command prints a CI line.
CI_GATE="$(setting SIDENOTE_CI_GATE 0 | tr -d '[:space:]')"
ci_gate_on() { [ "$CI_GATE" = 1 ]; }
LOCAL_MODEL="$(setting SIDENOTE_LOCAL_MODEL auto)"            # auto: the largest measured model that fits the GPU
BUSY_MODEL="$(setting SIDENOTE_LOCAL_BUSY_MODEL auto)"         # for while the GPU is busy; auto: the model's smaller one
# The models `llm pull` fetches when none are named: the ones set, or for "auto" the largest measured model that fits
# this machine's GPU and its smaller one (server/models.py reads the profiles, server/hardware.py the GPU). Nothing
# when no NVIDIA or AMD GPU has room for the smallest: the cloud agent then solves every problem. A Mac's own GPU is out
# of a container's reach: with Docker on a Mac the model runs in Ollama for Mac, named in .env (README).
models_to_pull() {
  python3 - "$LOCAL_MODEL" "$BUSY_MODEL" <<'PY'
import sys
sys.path.insert(0, "server")
import hardware, models
main, busy = sys.argv[1], sys.argv[2]
if main == "auto":
    gpu = hardware.best([g for g in hardware.detect() if g.vendor != "apple"])
    fit = models.fits(gpu.memory_gb) if gpu else None
    main = fit.name if fit else ""
names = models.wanted(main)[:1] if main else []
if main and busy == "auto":
    names += models.wanted(main)[1:]
elif main and busy:
    names.append(busy)
print("\n".join(names))
PY
}
# The local model's server is the llm container (Ollama) unless SIDENOTE_LOCAL_URL names another: an OpenAI-compatible
# one already running, such as vLLM, llama.cpp's server or LM Studio. That one has its models, and the container would sit idle.
LOCAL_URL="$(setting SIDENOTE_LOCAL_URL "")"
own_llm() { case "$LOCAL_URL" in ""|http://llm:11434|http://llm:11434/*) return 0 ;; esac; return 1; }
# The local LLM and its web search belong to the "local" compose profile: every compose command here
# (up, down, ps, logs) includes them in local mode, so down also frees the GPU.
if [ "$ANALYZER" = local ]; then export COMPOSE_PROFILES="${COMPOSE_PROFILES:+$COMPOSE_PROFILES,}local"; fi
CLIENT_WIN="$(wslpath -w "$PWD/client/capture.py" 2>/dev/null || true)"   # this checkout's client, by full path
# On WSL the capture program, the browser and the desktop shortcut are Windows' own, reached through interop. On a Linux
# desktop of its own (no WSL_DISTRO_NAME, which WSL sets in every session) they are this desktop's: the capture program
# runs here, with the packages of client/requirements.txt in a virtual environment of its own (CAPTURE_VENV).
# sudo takes WSL_DISTRO_NAME out of the environment, and WSL was then taken for a Linux desktop: under sudo the kernel's
# release says whether this is WSL, and the Windows path of / (\\wsl.localhost\<name>\) names the distribution
DISTRO="${WSL_DISTRO_NAME:-}"
if [ -z "$DISTRO" ] && [ -n "${SUDO_USER:-}" ]; then
  case "$(uname -r)" in *[Mm]icrosoft*) DISTRO="$(wslpath -w / 2>/dev/null | sed -n 's|^\\\\[^\\]*\\\([^\\]*\)\\*$|\1|p')" ;; esac
fi
if [ -n "$DISTRO" ]; then ON_WSL=1; else ON_WSL=0; fi
if [ "$(uname -s)" = Darwin ]; then ON_MAC=1; else ON_MAC=0; fi   # a Mac reads its own screen, with no X11 display to check
CAPTURE_VENV="$PWD/.venv-capture"
# Docker refuses a CPU limit above the machine's cores, and the server would not start on a 6-core WSL: the defaults come
# down to what is there. What .env or the environment sets is left as it is.
# nproc is Linux's. A Mac has none, and there Docker runs in a VM with fewer CPUs than the Mac has (Docker Desktop's
# setting): Docker itself says how many it has. With neither answering, the limits stay as compose.yaml has them
CORES="$(nproc 2>/dev/null || docker info --format '{{.NCPU}}' 2>/dev/null || true)"
case "$CORES" in ''|*[!0-9]*) CORES=8 ;; esac
if [ "$CORES" -gt 0 ] && [ "$CORES" -lt 8 ]; then
  export SIDENOTE_CPUS="$(setting SIDENOTE_CPUS "$CORES")" SIDENOTE_LLM_CPUS="$(setting SIDENOTE_LLM_CPUS "$CORES")"
fi

# The language of every word printed here: SIDENOTE_LANG (en or ko, from the environment or .env, as the server reads
# it), else Korean when the locale is Korean (the first of LC_ALL, LC_MESSAGES and LANG that is set, the order the C
# library reads them in), else English. A SIDENOTE_LANG that is set is handed on to the Windows programs started from
# here through WSLENV, so the capture program speaks it too (otherwise it speaks English: it reads no system's language).
UI_LANG="$(setting SIDENOTE_LANG "" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
case "$UI_LANG" in
  en|ko) export SIDENOTE_LANG="$UI_LANG" WSLENV="SIDENOTE_LANG${WSLENV:+:$WSLENV}" ;;
  *) case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in ko*|KO*) UI_LANG=ko ;; *) UI_LANG=en ;; esac ;;
esac
# Every message is written once in both languages, English first: `L "Server stopped." "서버를 멈췄습니다."` prints
# the one UI_LANG picks. Functions cut out of this file by the tests need it defined as well (tests/ci_gate.py).
L() { if [ "$UI_LANG" = ko ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

# With no NVIDIA or AMD GPU that has room for the smallest measured model, the same line wherever it comes up (llm pull,
# install, doctor, status), and in full once in one command's output: the agent solves, the local model is not used,
# and the smallest model can still run on the CPU, slowly (README, "What it runs on"). $1 is the level to print it at.
NOFIT_SAID=0
no_fit() {
  if [ "$NOFIT_SAID" = 1 ]; then   # said already in this output: its first words only
    "$1" "$(L "Local model: not used, no GPU fits it" "이 PC의 모델: 쓰지 않음, 맞는 GPU 없음")"; return 0
  fi
  NOFIT_SAID=1
  if [ "$AGENT" = off ]; then      # and no agent either: then nothing solves, which is not a choice to leave quiet
    "$1" "$(L "Local model: no GPU fits it, and the agent is off (SIDENOTE_AGENT=off), so nothing solves. ./sidenote llm pull gemma4:e2b runs it on the CPU, slowly" \
              "이 PC의 모델: 맞는 GPU 없음, 에이전트도 꺼 둠 (SIDENOTE_AGENT=off): 풀 엔진 없음. ./sidenote llm pull gemma4:e2b로 CPU에서 느리게 실행 가능")"
  else
    "$1" "$(L "Local model: not used, no GPU fits it (no NVIDIA or AMD GPU with more than 6 GB). A signed-in agent solves every problem. Optional: ./sidenote llm pull gemma4:e2b, on the CPU, slowly" \
              "이 PC의 모델: 쓰지 않음, 맞는 GPU 없음 (6GB를 넘는 NVIDIA나 AMD GPU 없음). 로그인한 에이전트가 모든 문제를 풂. 원하면 ./sidenote llm pull gemma4:e2b (CPU에서 느리게)")"
  fi
}

if [ -t 1 ]; then B=$'\e[1m'; G=$'\e[32m'; R=$'\e[31m'; Y=$'\e[33m'; D=$'\e[2m'; N=$'\e[0m'
else B='' G='' R='' Y='' D='' N=''; fi
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
FAILS=0   # ✗ lines printed so far (doctor fails when there is any)
# Set by install alone. Right after a first install no model is downloaded and no agent need be signed in yet: those are
# the next steps it names, not a failed install, whereas doctor asked later has every reason to fail on them.
ENGINE_SOFT=0
bad()  { printf '  %s✗%s %s\n' "$R" "$N" "$*"; FAILS=$((FAILS + 1)); }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*"; }
die()  { printf '%s%s%s\n' "$R" "$*" "$N" >&2; exit 1; }
# A yes asked at the terminal before what is not undone (restore, llm rm): y or yes goes on, anything else does not,
# Enter alone and the end of input included. The callers ask only where there is a terminal to answer at.
ask_yes() {
  local answer=""
  printf '  %s [y/N] ' "$1"
  read -r answer || true   # Ctrl+D: no answer, which is a no
  case "$answer" in y|Y|yes|Yes|YES) return 0 ;; esac
  return 1
}
# Reading /health, the GPU and the model list all go through python3. Without it the GPU above silently counted as none
# and `up` ended in the middle of its status with status 127 and no word of why, so it is said first. help needs nothing.
if ! command -v python3 >/dev/null 2>&1; then
  case "${1:-help}" in
    help|-h|--help) ;;
    *) die "$(L "python3 is not installed, and ./sidenote needs it to read the server's state and the GPU. Install it (on Ubuntu or Debian: sudo apt install python3) and run this again." \
                "python3가 설치되어 있지 않습니다. ./sidenote가 서버 상태와 GPU를 읽는 데 필요합니다. 설치한 뒤(Ubuntu, Debian: sudo apt install python3) 다시 실행하세요.")" ;;
  esac
fi
# The capture program can run in a terminal window of its own (--console, or `capture --up` from an older desktop
# shortcut, which opened one), and the title bar is all that window says about itself.
# An empty name puts the terminal's own title back. With no terminal (the shortcut now) it does nothing.
term_title() { [ -t 1 ] && printf '\033]0;%s\007' "$1"; return 0; }

# Windows' own programs, by their full path when the PATH does not have them. With [interop] appendWindowsPath=false in
# /etc/wsl.conf the Windows folders are left off WSL's PATH, and `cmd.exe` by name was "command not found": capture did
# not start, and install and doctor said Windows Python was missing when it was there. Interop still runs a Windows
# program named by its path, and cmd.exe finds py on Windows' own PATH. The drive that holds Windows is read from the
# mount table, wherever [automount] root puts it (/mnt/c by default). SIDENOTE_MOUNTS and SIDENOTE_BINFMT stand in for
# the two /proc files in tests/launcher_args.sh.
WIN_DRIVE=""                                     # the WSL folder of the drive with Windows on it, such as /mnt/c
if [ "$ON_WSL" = 1 ]; then
  while read -r _ mnt fstype _; do
    case "$fstype" in 9p|drvfs|virtiofs) ;; *) continue ;; esac   # Windows drives only (virtiofs on newer WSL): no Linux file system is looked into
    mnt="$(printf '%b' "$mnt")"                            # the table writes a space in a folder name as \040
    if [ -f "$mnt/Windows/System32/cmd.exe" ]; then WIN_DRIVE="$mnt"; break; fi
  done 2>/dev/null < "${SIDENOTE_MOUNTS:-/proc/mounts}"
fi
# cmd.exe complains when started from a WSL directory, so Windows commands run with a Windows working directory
WIN_CWD="${WIN_DRIVE:-/mnt/c}"
# The program from the PATH when it is there (the tests' stand-ins are), else from the Windows drive, else its bare name
# (which then fails as it always did, and win_problem says why before that matters)
win_exe() {
  command -v "$1" 2>/dev/null && return 0
  if [ -n "$WIN_DRIVE" ] && [ -f "$WIN_DRIVE/$2" ]; then printf '%s\n' "$WIN_DRIVE/$2"; else printf '%s\n' "$1"; fi
}
CMD_EXE="$(win_exe cmd.exe Windows/System32/cmd.exe)"
PS_EXE="$(win_exe powershell.exe Windows/System32/WindowsPowerShell/v1.0/powershell.exe)"
# Why Windows cannot be reached from here, or nothing when it can: what is said instead of cmd.exe's "command not found",
# or of "no Windows Python" when Python is there. [interop] enabled=false takes away the entry that starts Windows
# programs (WSLInterop, WSLInterop-late on newer WSL), and then no path helps. Either way the capture can be set up from
# Windows itself, with the command printed (win_setup_command), and the desktop shortcut then starts it from there. Only
# a real Windows program is held to that (a PE file starts with MZ): the tests' stand-ins are scripts.
# The first line is the reason (status and install print its words before the colon alone), and the command to type is
# on a line of its own with nothing after it: copied out of the middle of a sentence it took the sentence's next words
# along, and launch.pyw refused them as arguments.
win_problem() {
  [ "$ON_WSL" = 1 ] || return 0
  local nl=$'\n' setup
  if [ ! -f "$CMD_EXE" ]; then
    setup="$(win_setup_command)"
    L "Windows cannot be found from WSL: cmd.exe is neither on the PATH nor in Windows\\System32 on a drive WSL mounted.${nl}    Check [automount] in /etc/wsl.conf (enabled must not be false), or set the capture up from Windows once, in a Windows terminal:${nl}      ${setup}" \
      "WSL에서 Windows를 찾지 못했습니다: cmd.exe가 PATH에도, WSL에 연결된 드라이브의 Windows\\System32에도 없습니다.${nl}    /etc/wsl.conf의 [automount]를 확인하거나 (enabled=false가 아니어야 합니다), Windows 터미널에서 한 번 실행해 캡처를 Windows 쪽에서 설정하세요:${nl}      ${setup}"
    return 0
  fi
  [ "$(head -c 2 "$CMD_EXE" 2>/dev/null)" = MZ ] || return 0
  # WSL 1 (its kernel release ends in -Microsoft) starts Windows programs without binfmt_misc, so there is no entry to
  # read: whether they start is known by starting one. cmd.exe that is not executable, or that the kernel refuses to
  # run (exit code 126), is Windows out of reach ([interop] enabled=false); it used to be said as "no Windows Python".
  # WSL 2 starts them through an entry in binfmt_misc, and with interop off binfmt_misc need not be mounted at all (no
  # systemd to mount it), so a missing register file is no sign of WSL 1. SIDENOTE_KERNEL stands in for uname -r in the tests
  case "${SIDENOTE_KERNEL:-$(uname -r)}" in
    *-Microsoft)
      local ran=0
      if [ -x "$CMD_EXE" ]; then (cd "$WIN_CWD" && "$CMD_EXE" /c ver) >/dev/null 2>&1 || ran=$?; else ran=126; fi
      [ "$ran" = 126 ] || return 0   # it ran (whatever cmd.exe then answered): Windows is in reach
      L "WSL 1 cannot start Windows programs here: cmd.exe does not run (exit code 126)." \
        "여기서는 WSL 1이 Windows 프로그램을 실행할 수 없습니다: cmd.exe가 실행되지 않습니다(종료 코드 126)."
      win_ways_on
      return 0 ;;
  esac
  local f bin="${SIDENOTE_BINFMT:-/proc/sys/fs/binfmt_misc}"
  for f in "$bin"/WSLInterop*; do
    [ -f "$f" ] && [ "$(head -1 "$f" 2>/dev/null)" = enabled ] && return 0
  done
  L "WSL cannot start Windows programs here: interop is off (no WSLInterop entry in /proc/sys/fs/binfmt_misc)." \
    "여기서는 WSL이 Windows 프로그램을 실행할 수 없습니다: interop이 꺼져 있습니다(/proc/sys/fs/binfmt_misc에 WSLInterop 없음)."
  win_ways_on
}
# What win_problem says after its reason, whichever it is: the two ways on, set the capture up from Windows once, or turn
# interop on. One wording for both reasons, which had a copy each in both languages
win_ways_on() {
  local setup nl=$'\n'
  setup="$(win_setup_command)"
  L "${nl}    Set the capture up from Windows once, in a Windows terminal (it installs the capture packages and makes the desktop shortcut, which then starts the server and the capture):${nl}      ${setup}${nl}    Or turn interop on: remove [interop] enabled=false from /etc/wsl.conf or set it to true, run wsl --shutdown in Windows and open WSL again." "${nl}    Windows 터미널에서 한 번 실행해 캡처를 Windows 쪽에서 설정하세요 (캡처 패키지를 설치하고 바탕화면 바로가기를 만듭니다. 그 뒤로는 바로가기가 서버와 캡처를 함께 시작합니다):${nl}      ${setup}${nl}    또는 interop을 켜세요: /etc/wsl.conf의 [interop] enabled=false를 지우거나 true로 바꾸고, Windows에서 wsl --shutdown을 실행한 뒤 WSL을 다시 여세요."
}
# The command that sets the capture up from Windows, for a WSL that cannot start Windows programs: client/launch.pyw
# --setup installs the capture packages into Windows Python and makes the desktop shortcut, as setup-capture and shortcut
# do from here, and the shortcut then brings the server up here and starts the capture program there (windows_starts).
# With SIDENOTE_WHEELS (no internet here: docs/air-gapped.md) the packages come from that folder, as setup-capture takes them
win_setup_command() {
  local launch wheels="" w; launch="$(wslpath -w "$PWD/client/launch.pyw" 2>/dev/null)" || launch="$PWD/client/launch.pyw"
  w="$(setting SIDENOTE_WHEELS "")"
  [ -z "$w" ] || wheels=" --wheels \"$(wslpath -w "$w" 2>/dev/null || printf '%s' "$w")\""
  printf 'py -3 "%s" --setup --distro %s --repo "%s" --port %s%s' "$launch" "$DISTRO" "$PWD" "$PORT" "$wheels"
}
# A command that cannot go on without Windows stops with the reason
need_win() { local p; p="$(win_problem)"; [ -z "$p" ] || die "$p"; }
win()  { (cd "$WIN_CWD" && "$CMD_EXE" /c "$@" 2>/dev/null | tr -d '\r'); }
# PowerShell 5.1 writes a pipe in the console's code page (cp949 on Korean Windows, '?' for what the page lacks), so a path
# read here with Korean in it (a user folder, OneDrive's 바탕 화면) came back as bytes that are no longer that path once
# they are handed to PowerShell again. Asked for UTF-8 first, what it prints is what this script speaks. With no console to
# set, that one statement fails on stderr and the command still runs.
winps() { (cd "$WIN_CWD" && "$PS_EXE" -NoProfile -Command "[Console]::OutputEncoding = [Text.Encoding]::UTF8; $1" 2>/dev/null | tr -d '\r'); }
# A single quote inside a PowerShell single-quoted string has to be written twice. Paths come from
# Windows and can hold one (a user folder under a name with an apostrophe), and it ended the string.
ps_quote() { printf '%s' "${1//\'/\'\'}"; }

# Every curl here talks to this PC's own server: a proxy set in WSL would send 127.0.0.1 to the proxy, and up then waited
# four minutes to say the server was unreachable.
# By its path, not `command curl`: bash 3.2 (macOS's /bin/bash) ends the whole script when a program run through the
# `command` builtin fails inside a function called from `||`, `if` or `until`, as health is while the server starts
CURL_BIN="$(command -v curl 2>/dev/null || echo curl)"
curl() { "$CURL_BIN" --noproxy '*' "$@"; }
health() { curl -fsS --max-time 3 "$URL/health" 2>/dev/null; }
# The cloud agent signs in with this PC's own login: Claude Code's (~/.claude) or Codex's (~/.codex), each mounted
# into the container. Claude Code on a Mac keeps its login in the Keychain, which the container cannot read: there the
# server signs in with a token in .env (CLAUDE_CODE_OAUTH_TOKEN, from `claude setup-token`), so that token is the login.
claude_login() {
  # .env alone: compose hands the server that file, not this shell's environment
  if [ "$ON_MAC" = 1 ]; then [ -z "$(dotenv CLAUDE_CODE_OAUTH_TOKEN)" ] || L "token in .env" ".env의 토큰"; return 0; fi
  claude auth status --json 2>/dev/null | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('authMethod') or 'yes' if d.get('loggedIn') else '')" 2>/dev/null || true
}
# This PC's Claude Code version, or nothing when it has none. Claude Code is optional (next to the local model
# it only adds the agent), and this always succeeds: under `set -e` and pipefail a missing `claude`
# (status 127 through the pipe) made `local cv; cv="$(claude_version)"` end `up`, `install` and `capture --up`
# on the spot, with status 127 and not a word printed (measured with docker stood in for).
claude_version() {
  command -v claude >/dev/null 2>&1 || return 0                                # no Claude Code: no version
  claude --version 2>/dev/null | sed -n 's/^\([0-9][0-9.]*\).*/\1/p' | head -1 || true   # nor a broken one
}
# The same for Codex: its login ("ChatGPT", "API key") from `codex login status`, and its version ("codex-cli
# 0.165.0" prints as 0.165.0). Optional too, and always succeeds for the same reason.
codex_login() {
  command -v codex >/dev/null 2>&1 || return 0
  codex login status 2>&1 | sed -n 's/^Logged in using \(.*\)$/\1/p' | head -1 || true
}
codex_version() {
  command -v codex >/dev/null 2>&1 || return 0
  codex --version 2>/dev/null | sed -n 's/^codex-cli \([0-9][0-9.]*\).*/\1/p' | head -1 || true
}
# A value of the server's JSON, printed with no control character but tab and newline: a setting's name or an error the
# server repeats could hold a carriage return (a line of its own to the shortcut's starter, which acts on marked lines)
# or a terminal's escape codes, and these are printed to the terminal and read by the starter
json()   { python3 -c "import json,re,sys; d=json.load(sys.stdin); print(re.sub(r'[\x00-\x08\x0b-\x1f\x7f-\x9f]', '', str($1)))"; }
running() { docker ps --format '{{.Names}}' 2>/dev/null | grep -qx sidenote; }

# Monitoring runs inside the image too: in the running server, or a throwaway container
# that only reads the log folder (works while the server is down).
in_image() {
  docker_up
  # the report in this terminal's language: the container does not see the host's locale (server/i18n.py cli_lang)
  if running; then docker exec -e SIDENOTE_LANG="$UI_LANG" sidenote python -m server.report "$@"
  else
    docker image inspect sidenote:local >/dev/null 2>&1 || die "$(L "No image yet. Run ./sidenote up first" "이미지가 없습니다. 먼저 ./sidenote up을 실행하세요")"
    docker run --rm -e TZ="$(host_tz)" -e SIDENOTE_LANG="$UI_LANG" -v "$LOG_PATH:/data/logs:ro" --entrypoint python sidenote:local -m server.report "$@"
  fi
}

# The folders the server's container mounts. Docker, which runs as root, makes a mount's missing folder as root, and then
# this PC's own Claude Code could not write to its own backups or sessions, so each is made here first, as this user. The
# log folder holds the answers and what was heard: when it is made here, it is this user's alone.
ensure_dirs() {
  mkdir -p "$HOME/.claude/backups" "$HOME/.claude/sessions" "$HOME/.codex"
  [ -d "$LOG_PATH" ] || mkdir -p -m 700 "$LOG_PATH"
}

# Who the server runs as: this user, so it can read the 600 login files in ~/.claude and ~/.codex, and a token it refreshes
# stays this user's file. Root with more capabilities could read them too, but it would leave the refreshed login owned by
# root, out of reach of this PC's own CLI. Under rootless Docker the container's root already is this user, and uid 1000
# in there would be a stranger, so it stays 0. compose.yaml's default of 0 is for `docker compose` run by hand.
server_user() {
  if docker info --format '{{json .SecurityOptions}}' 2>/dev/null | grep -q rootless; then
    SIDENOTE_UID="$(setting SIDENOTE_UID 0)" SIDENOTE_GID="$(setting SIDENOTE_GID 0)"
  else
    SIDENOTE_UID="$(setting SIDENOTE_UID "$(id -u)")" SIDENOTE_GID="$(setting SIDENOTE_GID "$(id -g)")"
  fi
  export SIDENOTE_UID SIDENOTE_GID
}

# The time zone the containers keep their log times and days in: the one this PC is in, which a container cannot see. TZ
# in the environment or .env first, then what the system says, in the order that is most to least sure of itself. $1 is the
# folder to read in place of /etc, for tests/launcher_args.sh. Only a zone's name passes: TZ=:/etc/localtime names a file
# no container has, and "n/a" is timedatectl with nothing to say. UTC when nothing says.
host_tz() {
  local etc="${1:-/etc}" tz found
  for tz in "$(setting TZ "")" "$(timeout 3 timedatectl show -p Timezone --value 2>/dev/null || true)" \
            "$(head -1 "$etc/timezone" 2>/dev/null || true)" "$(readlink "$etc/localtime" 2>/dev/null || true)"; do
    case "$tz" in */zoneinfo/*) tz="${tz##*/zoneinfo/}" ;; esac
    if [ "$tz" != n/a ] && [[ $tz =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ ]]; then found="$tz"; break; fi
  done
  printf '%s' "${found:-UTC}"
}
# Who Claude Code is signed in as, for the panel's agent card: ~/.claude.json is not mounted in the server, and only its
# address comes out of it. Owner-only; a dot file, which the log tools pass over. Nothing to read: nothing kept.
note_account() {
  python3 - "$HOME/.claude.json" "$LOG_PATH/.account.json" <<'ACCOUNT' 2>/dev/null || true
import json, os, sys
try:
    a = json.load(open(sys.argv[1], encoding="utf-8")).get("oauthAccount") or {}
except (OSError, ValueError):
    a = {}
if not a.get("emailAddress"):   # signed out: the last address must not stay on the panel
    if os.path.exists(sys.argv[2]):
        os.remove(sys.argv[2])
else:
    fd = os.open(sys.argv[2], os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump({"email": a["emailAddress"]}, f)
ACCOUNT
}

# capture.log: the capture client's output, rotated by size like the server's logs
# (capture.log.1 .. .$LOG_FILES; older ones age out with the server's 14-day prune too).
rotate_capture_log() {
  local f="$LOG_PATH/capture.log" max=$((LOG_MAX_MB * 1024 * 1024)) i
  [ -f "$f" ] && [ "$(wc -c < "$f" | tr -d ' ')" -ge "$max" ] || return 0   # wc, not stat -c: the BSD stat has no -c
  for ((i = LOG_FILES - 1; i >= 1; i--)); do [ -f "$f.$i" ] && mv -f "$f.$i" "$f.$((i + 1))"; done
  mv -f "$f" "$f.1"
}
# printf's %(...)T came with bash 4.2: macOS's bash 3.2 refused it on every line, and nothing reached capture.log
if (( BASH_VERSINFO[0] * 100 + BASH_VERSINFO[1] >= 402 )); then stamped() { printf '%(%F %T)T %s\n' -1 "$1"; }
else stamped() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1"; }; fi
log_capture() {   # stdin -> terminal and capture.log, checking the size every 100 lines
  local n=0 line
  while IFS= read -r line; do
    printf '%s\n' "$line"
    stamped "$line" >> "$LOG_PATH/capture.log"
    n=$((n + 1)); (( n % 100 )) || rotate_capture_log
  done
}

# What compose.yaml needs of Docker Compose: the plugin itself, which a distribution's own Docker package (Ubuntu's
# docker.io, Debian 12's) comes without, and 2.24 or newer, the first to read `env_file` with `required: false`.
# Without the plugin every command ended on Docker's "Run 'docker --help' for more information", and an older one on a
# complaint about env_file. Prints the reason and what to install and fails; prints nothing when it will do. A version
# that does not read as numbers (a build of one's own) is let through.
COMPOSE_MIN="2.24"
compose_why() {
  local v major minor
  if ! v="$(docker compose version --short 2>/dev/null)"; then
    L "Docker has no Compose here (docker compose). Install the Compose plugin, ${COMPOSE_MIN} or newer: the docker-compose-plugin package from Docker's own repository, or Docker Desktop, which has it." \
      "Docker에 Compose가 없습니다 (docker compose). Compose 플러그인 ${COMPOSE_MIN} 이상을 설치하세요: Docker 저장소의 docker-compose-plugin 패키지, 또는 Compose가 들어 있는 Docker Desktop."
    return 1
  fi
  v="${v#v}"                                                           # early 2.x printed it with a "v" in front
  case "$v" in *.*) ;; *) return 0 ;; esac                             # no dot in it: not a version to compare
  major="${v%%.*}"; minor="${v#*.}"; minor="${minor%%[!0-9]*}"         # 2.24.0-desktop.1 -> 2 and 24
  case "$major" in ''|*[!0-9]*) return 0 ;; esac
  case "$minor" in '') return 0 ;; esac
  # 10#: a number with a zero in front is not read as octal
  if (( 10#$major < ${COMPOSE_MIN%%.*} || (10#$major == ${COMPOSE_MIN%%.*} && 10#$minor < ${COMPOSE_MIN#*.}) )); then
    L "Docker Compose is older than ${COMPOSE_MIN} (it is $v), and compose.yaml cannot be read by it. Update the docker-compose-plugin package from Docker's own repository, or Docker Desktop." \
      "Docker Compose가 ${COMPOSE_MIN}보다 오래되어 (지금 $v) compose.yaml을 읽지 못합니다. Docker 저장소의 docker-compose-plugin 패키지나 Docker Desktop을 업데이트하세요."
    return 1
  fi
}

# Why Docker cannot be used, as one line in this terminal's language, read from what `docker info` writes to stderr:
# a user outside the docker group gets "permission denied" on the socket, which no restart of Docker mends; anything
# else is said with Docker's own first line. With Docker answering, Compose is asked for too (compose_why): nearly
# every command here is a `docker compose` one. Prints nothing and succeeds when both will do.
docker_why() {
  local err
  if err="$(docker info 2>&1 >/dev/null)"; then                        # stdout is the client's own details: not wanted
    compose_why || return 1
    return 0
  fi
  if grep -qi "permission denied" <<<"$err"; then
    L "Docker refuses this user (permission denied on its socket). Add it to the docker group: sudo usermod -aG docker \$USER, then log out and in again." \
      "Docker가 이 사용자를 거부합니다 (소켓 권한 없음). 이 사용자를 docker 그룹에 추가하고(sudo usermod -aG docker \$USER) 로그아웃했다가 다시 로그인하세요."
  else
    L "Cannot connect to Docker. Check that Docker is running." "Docker에 연결할 수 없습니다. Docker가 켜져 있는지 확인하세요."
    err="$(grep -m1 -v '^[[:space:]]*$' <<<"$err" | cut -c1-200 || true)"   # Docker's first line, cut to fit a line
    [ -z "$err" ] || printf ' (%s)' "$err"
  fi
  return 1
}
docker_up() { local why; why="$(docker_why)" || die "$why"; }

clients() { health | json 'd["capture"]["clients"]' 2>/dev/null || echo 0; }

# "yes" while the server is being used (server/app.py activity()): something running (an analysis, a follow-up, a
# check, a run), an answer in the last 10 minutes (a restart drops the one a follow-up is asked about), or the screen
# watched and changing in the last 5 (not paused, a capture program connected). Nothing when it is not, or when it does
# not answer. A restart while it was in use solved the same problem twice.
in_use() {
  health | python3 -c '
import json, sys, time
d = json.load(sys.stdin)
a, c = d.get("activity") or {}, d.get("capture") or {}
now = c.get("now") or time.time()
recent = lambda t, sec: bool(t) and now - t < sec
used = (a.get("busy") or recent(a.get("last_answer"), 600)
        or (not d.get("paused") and (c.get("clients") or 0) > 0 and recent(c.get("last_frame"), 300)))
print("yes" if used else "")' 2>/dev/null
}

# The capture program runs this checkout's client/capture.py, read when it starts, so one started before a deploy
# runs the code from then (a fix to it waited for a restart by hand). When the code it
# reports in its hello is not the file here, it is asked to restart at a quiet moment (client/capture.py, Updater).
# One from before this was added reports nothing and ignores the request: a warning asks to restart it once.
capture_follow() {
  [ "$(clients)" -gt 0 ] 2>/dev/null || return 0
  local mine theirs
  mine="$({ sha256sum "$PWD/client/capture.py" 2>/dev/null || shasum -a 256 "$PWD/client/capture.py" 2>/dev/null; } | cut -c1-12)"
  # (under set -e a /health that takes too long just after a deploy would otherwise end ./sidenote up, saying nothing)
  theirs="$(health | json '((d.get("capture") or {}).get("caps") or {}).get("code", "")' 2>/dev/null)" || return 0
  if [ -z "$theirs" ]; then
    warn "$(L "The capture program runs old code. Press Restart capture in its tray icon once ${D}(after that it restarts by itself on a deploy)${N}" \
              "캡처 프로그램이 예전 코드로 실행 중입니다. 트레이 아이콘에서 캡처 다시 시작을 한 번 누르세요 ${D}(그 뒤로는 배포 때 자동으로 다시 시작합니다)${N}")"
  elif [ "$theirs" != "$mine" ]; then
    if curl -fsS --max-time 3 -X POST "$URL/capture/restart?quiet=1" >/dev/null 2>&1; then
      ok "$(L "The capture program restarts into the new code too, when the screen and the server are quiet" \
              "캡처 프로그램도 화면과 서버가 한가할 때 새 코드로 다시 시작합니다")"
    else
      warn "$(L "Could not ask the capture program to restart. Ask again with ./sidenote capture-restart" \
                "캡처 프로그램에 다시 시작을 요청하지 못했습니다. ./sidenote capture-restart로 다시 요청하세요")"
    fi
  fi
}

# Before a restart: wait while the server is in use, unless asked not to (--now). Polled every 15 s.
wait_idle() {
  [ "${UP_NOW:-0}" = 1 ] && return 0
  running && [ -n "$(in_use)" ] || return 0
  echo "  $(L "Sidenote is in use: it restarts once it is idle ${D}(--now to restart at once)${N}" \
              "Sidenote를 사용 중이라 쉴 때까지 기다린 뒤 다시 시작합니다 ${D}(바로 하려면 --now)${N}")"
  local waited=0
  while [ -n "$(in_use)" ]; do
    sleep 15; waited=$((waited + 15))
    (( waited % 300 == 0 )) && echo "  ${D}$(L "waiting for $((waited / 60)) min" "$((waited / 60))분째 기다리는 중")${N}"
  done
  echo "  $(L "Idle: restarting" "쉬는 중이라 다시 시작합니다")"
}

# What CI said of this commit: success, failure, running, or nothing when that cannot be known (no gh, not signed in, a commit not pushed yet).
# Asked only with the gate on (ci_gate_on); tests/ci_gate.py runs it and ci_gate on their own, with a stand-in gh.
ci_state() {
  command -v gh >/dev/null 2>&1 || return 0
  local sha; sha="$(git rev-parse HEAD 2>/dev/null)" || return 0
  gh run list --commit "$sha" --workflow ci --limit 1 --json status,conclusion \
    --jq 'if length == 0 then "" elif .[0].status != "completed" then "running" else .[0].conclusion end' 2>/dev/null || true
}

# The deploy's gate, with SIDENOTE_CI_GATE=1: a commit CI has failed does not go up unless asked (--no-ci). What CI has
# not seen goes up, and says so: uncommitted work, a commit still being checked, a PC with no gh. Waiting for the
# answer is for --when-green. Never prompts for input.
ci_gate() {
  [ "${UP_NO_CI:-0}" = 1 ] && return 0
  local dirty="" state waited=0 limit="${CI_WAIT_LIMIT:-2400}" every="${CI_WAIT_EVERY:-30}"
  if [ -n "$(git status --porcelain 2>/dev/null | grep -vE '^\?\?' | head -1)" ]; then
    dirty=1
    warn "$(L "Deploying uncommitted changes. CI has not checked this code." "커밋하지 않은 변경을 배포합니다. CI를 거치지 않은 코드입니다.")"
  fi
  state="$(ci_state)"
  if [ "${UP_WHEN_GREEN:-0}" = 1 ] && [ -z "$dirty" ]; then   # what is not committed CI will never answer for
    until [ -n "$state" ] && [ "$state" != running ]; do
      (( waited >= limit )) && die "$(L "No CI result after $((limit / 60)) min. Not deployed. (--no-ci deploys anyway)" \
                                         "CI 결과가 $((limit / 60))분 동안 나오지 않아 배포하지 않았습니다 (--no-ci면 그대로 배포)")"
      (( waited == 0 )) && echo "  $(L "Waiting for CI ${D}(this commit: $(git rev-parse --short HEAD))${N}" \
                                       "CI 결과를 기다립니다 ${D}(이 커밋: $(git rev-parse --short HEAD))${N}")"
      sleep "$every"; waited=$((waited + (every > 0 ? every : 1)))
      state="$(ci_state)"
    done
  fi
  case "$state" in
    success) ok "$(L "CI passed this commit" "CI를 통과한 커밋입니다") ${D}($(git rev-parse --short HEAD))${N}" ;;
    running) warn "$(L "Deploying a commit CI is still checking ${D}(--when-green to wait)${N}" "CI가 아직 검사 중인 커밋을 배포합니다 ${D}(기다리려면 --when-green)${N}")" ;;
    failure|cancelled|timed_out|startup_failure)
      # With changes on top too: they may mend it, and then a commit will say so; until then the failure stands
      die "$(L "This commit failed CI ($state). Fix it first, or deploy anyway with ./sidenote up --no-ci" \
               "이 커밋은 CI를 통과하지 못했습니다($state). 고친 뒤 배포하거나, 그대로 배포하려면 ./sidenote up --no-ci")" ;;
    *) if [ "${UP_WHEN_GREEN:-0}" = 1 ] && [ -z "$dirty" ]; then
         die "$(L "The CI result is unknown (check the gh login and that the commit is pushed)." "CI 결과를 알 수 없습니다 (gh 로그인과 푸시 여부를 확인하세요).")"
       fi
       warn "$(L "The CI result is unknown ${D}(no gh, not signed in, or a commit not pushed yet)${N}" \
                 "CI 결과를 알 수 없습니다 ${D}(gh가 없거나 로그인 전, 또는 아직 푸시하지 않은 커밋)${N}")" ;;
  esac
  return 0
}

# ./sidenote qa [server|panel]: the same suites CI runs, on this PC, with the interpreters tests/README.md sets up
cmd_qa() {
  local py="${PY:-.venv/bin/python}" pw="${PW:-.venv-panel/bin/python}"
  [ -x "$py" ] || die "$(L "No Python for the server suites: $py (the setup in tests/README.md)" "서버 테스트 묶음용 Python이 없습니다: $py (준비 방법은 tests/README.md)")"
  if [ "${1:-}" != server ]; then
    [ -x "$pw" ] || die "$(L "No Python for the panel suites: $pw (the setup in tests/README.md)" "패널 테스트 묶음용 Python이 없습니다: $pw (준비 방법은 tests/README.md)")"
  fi
  PY="$py" PW="$pw" tests/run.sh "$@"
}

cmd_up() {   # $1 = recreate: build and recreate even if nothing changed (./sidenote restart)
  command -v docker >/dev/null || die "$(L "docker is not installed." "docker가 설치되어 있지 않습니다.")"
  docker_up
  ensure_dirs
  note_account
  server_user
  TZ="$(host_tz)"; export TZ   # compose.yaml reads it from here
  wait_idle   # not while it is in use
  # a capture program connected now reconnects by itself after the restart (asked only when the server
  # is up: here a closed local port hangs until curl's timeout instead of refusing)
  local before=0; running && before="$(clients)"
  # The container's Claude Code and Codex are built at this PC's versions: each shares its login folder with the PC's
  # own copy. Without one on this PC there is no version to pass, and compose.yaml's default is used instead.
  local cv; cv="$(claude_version)"
  [ -n "$cv" ] && export SIDENOTE_CLAUDE_VERSION="$cv"
  local xv; xv="$(codex_version)"
  [ -n "$xv" ] && export SIDENOTE_CODEX_VERSION="$xv"
  echo "$(L "${B}Starting the server${N} ${D}(the first time, and after an agent CLI update, building the image takes a while)${N}" \
            "${B}서버를 시작합니다${N} ${D}(처음과 에이전트 CLI 업데이트 뒤에는 이미지 빌드에 시간이 걸립니다)${N}")"
  local rc=0 out; out="$(mktemp)"
  local nopull=() services=()
  if offline; then
    # Said here, in words that name the way out: compose would stop on a pull it was told not to make, or on a build's base image
    local image
    for image in sidenote:local sidenote-runner:local; do
      docker image inspect "$image" >/dev/null 2>&1 || die "$(L "$image is not on this PC, and with SIDENOTE_OFFLINE=1 it is neither built nor pulled. Load the bundle: docs/air-gapped.md" \
                                                                "$image 이미지가 이 PC에 없고, SIDENOTE_OFFLINE=1이면 빌드도 내려받기도 하지 않습니다. 묶음을 불러오세요: docs/air-gapped.md")"
    done
    nopull=(--pull never)
    # Named one by one to leave the search engine out: it only asks the internet, and its image need not come along
    services=(server runner)
    if [ "$ANALYZER" = local ] && own_llm; then services+=(llm); fi
  else
    # Built first, and the wait for a quiet server looked at once more: a build takes minutes, and a problem begun
    # during it had the container replaced under it, the very thing the wait is there to prevent.
    docker compose build 2>&1 | tee "$out" | { grep -vE "^\s*$" || true; } | uniq | sed 's/^/  /' || rc=$?
    # With another model server the services are named, the llm one left out (a named one starts whatever its profile)
    if [ "$ANALYZER" = local ] && ! own_llm; then services=(server runner searxng); fi
  fi
  if [ "$rc" = 0 ]; then
    wait_idle
    docker compose up -d --no-build ${nopull[@]+"${nopull[@]}"} --quiet-pull ${1:+--force-recreate} ${services[@]+"${services[@]}"} 2>&1 | tee "$out" | { grep -vE "^\s*$" || true; } | uniq | sed 's/^/  /' || rc=$?
  fi
  if [ "$rc" != 0 ]; then
    # A taken port leaves a created but never started server behind; the next up would start it
    # without its port. A server that was already running is left alone.
    [ "$(docker inspect -f '{{.State.Running}}' sidenote 2>/dev/null)" = false ] && docker rm -f sidenote >/dev/null 2>&1
    if grep -qiE "address already in use|port is already allocated" "$out"; then
      # The second line is what a new port leaves behind: a capture program started before the change holds the old
      # address in its command line and asks it every 2 s for good, while status counted it as "reconnecting" and capture
      # refused a second one as "already running". The desktop shortcut holds the port too (for the window that waits
      # on the server), so on WSL it is made again; a Linux or macOS desktop has no shortcut to name.
      local moved
      moved="$(L "A capture program started before the port changed keeps asking the old one: ./sidenote capture-stop, then ./sidenote capture." \
                 "포트를 바꾸기 전에 시작한 캡처 프로그램은 옛 포트로만 연결합니다: ./sidenote capture-stop 뒤 ./sidenote capture를 실행하세요.")"
      [ "$ON_WSL" = 0 ] || moved="$moved $(L "The desktop shortcut holds the port as well: ./sidenote shortcut makes it again." \
                                             "바탕화면 바로가기에도 포트가 들어 있습니다: ./sidenote shortcut으로 다시 만드세요.")"
      rm -f "$out"; die "$(L "Another program is using port ${PORT}. Close it, or set another port in .env (SIDENOTE_PORT=8778, say) and run ./sidenote up" \
                             "다른 프로그램이 포트(${PORT})를 쓰고 있습니다. 그 프로그램을 끄거나, .env에 다른 포트를 적은 뒤(예: SIDENOTE_PORT=8778) ./sidenote up을 실행하세요")
$moved"
    fi
    # The local model's container asks for the NVIDIA GPU (docker/compose.nvidia.yaml), and Docker on Linux reaches it
    # only through the NVIDIA Container Toolkit: without it compose says only this, and exits 1
    if grep -q "could not select device driver" "$out"; then
      rm -f "$out"; die "$(L "Docker cannot reach the NVIDIA GPU: install the NVIDIA Container Toolkit (https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/install-guide.html), or run without the GPU: COMPOSE_FILE=compose.yaml:docker/compose.cpu.yaml in .env" \
                             "Docker가 NVIDIA GPU를 쓸 수 없습니다: NVIDIA Container Toolkit을 설치하거나(https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/install-guide.html), GPU 없이 실행하려면 .env에 COMPOSE_FILE=compose.yaml:docker/compose.cpu.yaml")"
    fi
    rm -f "$out"; die "$(L "Could not start the server (docker compose exit code $rc). See the messages above." \
                           "서버를 시작하지 못했습니다 (docker compose 종료 코드 $rc). 위 메시지를 확인하세요.")"
  fi
  rm -f "$out"
  docker image prune -f --filter label=org.sidenote.image >/dev/null 2>&1 || true   # only this project's old builds
  printf '  %s' "$(L "Getting ready" "준비 중")"
  local t0=$SECONDS
  until health >/dev/null; do
    if ! running; then   # it stopped while starting (a crash): say so now, not after minutes
      echo; docker logs --tail 15 sidenote 2>&1 | sed 's/^/  /'
      die "$(L "The server stopped while starting. See the log above." "서버가 시작 중에 멈췄습니다. 위 로그를 확인하세요.")"
    fi
    # /health answers as soon as the server listens: the speech model is fetched and loaded in the background after
    # that, so this wait is for the container and the app alone, seconds on a PC that is not swapping. Four minutes is
    # the limit of patience, not a measure of the start.
    if (( SECONDS - t0 > 240 )); then
      echo
      [ "$(docker inspect -f '{{.State.Health.Status}}' sidenote 2>/dev/null)" = healthy ] \
        && die "$(L "The server is up, but this PC cannot reach $URL. Start it again with ./sidenote down and ./sidenote up." \
                    "서버는 켜졌지만 이 PC에서 $URL에 연결되지 않습니다. ./sidenote down 뒤 ./sidenote up으로 다시 시작하세요.")"
      die "$(L "The server does not answer. See ./sidenote logs." "서버가 응답하지 않습니다. ./sidenote logs로 확인하세요.")"
    fi
    printf '.'; sleep 1
  done
  echo
  # a few seconds for what reconnects by itself, so status does not report it missing
  if [ "${before:-0}" -gt 0 ]; then
    for _ in $(seq 1 12); do [ "$(clients)" -gt 0 ] && break; sleep 0.5; done
  fi
  if [ "$(health | json 'd.get("runner", {}).get("configured", False)' 2>/dev/null)" = True ]; then
    for _ in $(seq 1 16); do [ "$(health | json 'd["runner"]["ok"]' 2>/dev/null)" = True ] && break; sleep 0.5; done
  fi
  # The local model's server starts beside this one and the server looks at it every 2 s until it answers: a moment
  # for that, so the status says how it stands and not how it stood at its start. It has answered once it lists its
  # models, whether or not the model is among them ("missing"), and with no local model there is nothing to wait for.
  local llm_starting='(lambda L: bool(L.get("present") and L.get("on") and not L.get("ok") and not L.get("missing")))((d.get("engines") or {}).get("local") or {})'
  for _ in $(seq 1 24); do
    [ "$(health | json "$llm_starting" 2>/dev/null)" = True ] || break
    sleep 0.5
  done
  capture_follow
  cmd_status
}

# A down on its way holds this lock until it ends, and a start with --up waits for it (wait_down). The tray's Quit Sidenote
# runs a down: a shortcut clicked again right after found the server still up, started a capture program that brought
# nothing up, and the down then ended that program and the server under it. Where flock is missing (macOS) nothing waits.
down_lock() { printf '%s' "$LOG_PATH/.down.lock"; }
wait_down() {
  command -v flock >/dev/null || return 0
  ensure_dirs
  flock -w 120 "$(down_lock)" true 2>/dev/null || true
}

cmd_down() {
  if command -v flock >/dev/null; then ensure_dirs; exec 9>"$(down_lock)"; flock -x 9 || true; fi   # held until this ends
  cmd_capture_stop quiet || true   # first: it is outside docker, and docker being off is no reason to leave it running
  docker_up
  # (docker_up has said by now a Docker that does not answer, one without the compose plugin and a Compose too old)
  # Every profile, whatever .env says now: with the analyzer changed since up, the model's container was not looked at,
  # "already off" was said, and it kept the GPU.
  # compose's own failure (no compose file, a COMPOSE_FILE in .env that is not there) is said: it was hidden, and "already
  # stopped" was said with the containers running.
  # Its stderr apart: a warning compose prints there (a variable .env leaves unset) is no container, and read as one it said
  # "stopped" with nothing running. Of a failure the first line that is neither such a warning nor Docker's own "Run
  # 'docker --help'" hint is said: the error comes before the hint, and the last line alone was the hint. Only when every
  # line is one of those two is the last line said as it is.
  local ids err why; err="$(mktemp)"
  if ! ids="$(docker compose --profile '*' ps -q 2>"$err")"; then
    why="$(grep -v '^[[:space:]]*$' "$err" | grep -viE '^(WARN\[|time=.*level=warning)|docker --help' | head -1)"
    [ -n "$why" ] || why="$(grep -v '^[[:space:]]*$' "$err" | tail -1)"; rm -f "$err"
    die "$(L "docker compose failed: $why" "docker compose 실행 실패: $why")"
  fi
  rm -f "$err"
  if [ -z "$ids" ]; then ok "$(L "Already stopped." "이미 꺼져 있습니다.")"; return 0; fi
  docker compose --profile '*' down 2>&1 | { grep -vE "^\s*$" || true; } | uniq | sed 's/^/  /'
  ok "$(L "Server stopped." "서버를 멈췄습니다.")"
}

# Why a container that is still there is not running, in a few words, or nothing: one that was never made, one that runs
# and one that ended with exit code 0 (asked to: `docker stop`, Docker closing down) have no reason to give. Docker is
# asked, because only Docker knows that a container went over its memory limit. The three values come on one line, and a
# Docker that answers something else (or nothing) is read as "no reason".
ended_why() {
  local st code oom
  read -r st code oom <<<"$(docker inspect -f '{{.State.Status}} {{.State.ExitCode}} {{.State.OOMKilled}}' "$1" 2>/dev/null </dev/null || true)" || true
  case "$st" in exited|dead) ;; *) return 0 ;; esac   # created, running, restarting, paused: it did not end
  if [ "$oom" = true ]; then L "it went over its memory limit and Docker ended it" "메모리 한도를 넘어 Docker가 끝냈습니다"
  elif [[ $code =~ ^[1-9][0-9]*$ ]]; then L "its container ended (exit code $code)" "컨테이너가 끝났습니다 (종료 코드 $code)"; fi
}

# What the server's own restart loop last wrote (docker/entrypoint.sh): a server that ended by itself is started again
# inside its container, up to 5 times in 10 minutes, and each time one line goes to .ended in the log folder:
#   <when, seconds since 1970> <exit code> <starts in the last 10 minutes> <restarted|stopped> <stall|->
# The loop removes the file when a container starts, so a line here is about the container that is there now. Prints the
# five fields when the line is whole, and nothing for a file that is missing or holds anything else.
ended_note() {
  local when="" code="" n="" what="" stall=""
  [ -r "$LOG_PATH/.ended" ] || return 0   # no note: the server never ended by itself in this container
  read -r when code n what stall < "$LOG_PATH/.ended" || true   # a line without its newline is still read
  [[ $when =~ ^[0-9]+$ ]] && [[ $code =~ ^[0-9]+$ ]] && [[ $n =~ ^[0-9]+$ ]] || return 0
  case "$what" in restarted|stopped) printf '%s %s %s %s %s' "$when" "$code" "$n" "$what" "${stall:--}" ;; esac
}

# The words after "Server: off" when there is a reason to give, or nothing. The loop's own note first: it says more than
# Docker's exit code does (how often it tried, and that the watchdog ended a server that had stopped answering, whose
# stacks are in stall.txt). Without a note that says it gave up, what Docker says of the container.
server_ended_why() {
  local when code n what stall why
  read -r when code n what stall <<<"$(ended_note)" || true
  if [ "$what" = stopped ]; then
    why="$(L "it ended $n times within 10 minutes and was not started again (last exit code $code)" \
             "10분 안에 ${n}번 끝나 다시 켜지 않았습니다 (마지막 종료 코드 $code)")"
    [ "$stall" != stall ] || why="$why$(L ", it had stopped answering: the stacks are in $LOG_PATH/stall.txt" ", 응답이 멈춰 있었습니다: 스택은 $LOG_PATH/stall.txt")"
    printf '%s' "$why"; return 0
  fi
  ended_why sidenote
}

# The local model's line when the model server does not answer. With the container that serves it off, "not responding"
# sent the reader to its log and nowhere else, and nothing started it again: this says the container is off, why when
# Docker knows, and that up starts it (compose starts a service that ended, with the server left running). A model
# server of one's own (SIDENOTE_LOCAL_URL) and a container that runs keep the old line. $1 is the level to print it at.
llm_down() {
  local why=""
  if own_llm && [ "$(docker inspect -f '{{.State.Running}}' sidenote-llm 2>/dev/null </dev/null || true)" != true ]; then
    why="$(ended_why sidenote-llm)"
    "$1" "$(L "Local model: its container is off${why:+: $why}  ${D}(./sidenote up starts it, ./sidenote llm logs shows its last lines)${N}" \
              "이 PC의 모델: 컨테이너가 꺼져 있습니다${why:+: $why}  ${D}(./sidenote up으로 켜고, 마지막 로그는 ./sidenote llm logs)${N}")"
    return 0
  fi
  "$1" "$(L "Local model: not responding (./sidenote llm logs)" "이 PC의 모델: 응답 없음 (./sidenote llm logs)")"
}

cmd_status() {
  local h; h="$(health || true)"
  echo
  if [ -z "$h" ]; then
    if running; then warn "$(L "Server: starting  ${D}(./sidenote status again in a moment)${N}" "서버: 시작 중  ${D}(잠시 뒤 다시 ./sidenote status)${N}")"
    else
      # Off, and why when that can be known: a server that ended by itself looked the same as one never started, and
      # the one line there was pointed at `up` with no word about what had happened
      local why; why="$(server_ended_why)"
      if [ -n "$why" ]; then
        bad "$(L "Server: off: $why  ${D}(./sidenote logs shows its last lines, ./sidenote up starts it)${N}" \
                 "서버: 꺼짐: $why  ${D}(마지막 로그는 ./sidenote logs, 켜기는 ./sidenote up)${N}")"
      else bad "$(L "Server: off (./sidenote up)" "서버: 꺼짐 (./sidenote up)")"; fi
    fi
    return 0
  fi
  ok "$(L "Server: running" "서버: 실행 중")  ${B}${URL}${N}"
  # A server that ended and was started again by its own loop in the last 10 minutes: it answers now, and what it was
  # solving when it ended was cut short, so the fact and where to read why are said once here
  local e_when e_code e_n e_what e_stall e_ago e_said
  read -r e_when e_code e_n e_what e_stall <<<"$(ended_note)" || true
  if [ "$e_what" = restarted ]; then
    e_ago=$(( ($(date +%s) - e_when) / 60 ))   # whole minutes: the note's time is the container's clock, which is this PC's
    if [ "$e_ago" -ge 0 ] && [ "$e_ago" -lt 10 ]; then
      if [ "$e_ago" = 0 ]; then e_said="$(L "just now" "방금")"; else e_said="$(L "$e_ago min ago" "${e_ago}분 전에")"; fi
      if [ "$e_stall" = stall ]; then
        warn "$(L "Server: it had stopped answering and was started again $e_said  ${D}(the stacks are in $LOG_PATH/stall.txt)${N}" \
                  "서버: 응답이 멈춰 $e_said 다시 켜졌습니다  ${D}(스택은 $LOG_PATH/stall.txt)${N}")"
      else
        warn "$(L "Server: it ended by itself (exit code $e_code) and was started again $e_said  ${D}(./sidenote logs)${N}" \
                  "서버: 스스로 끝나(종료 코드 $e_code) $e_said 다시 켜졌습니다  ${D}(./sidenote logs)${N}")"
      fi
    fi
  fi
  # What is running against what is here
  local built here
  built="$(echo "$h" | json 'd.get("build") or ""' 2>/dev/null)"
  # the same sum as the server's panel_build(): the panel's own files and its translation tables
  here="$(python3 -c '
import hashlib, pathlib
here = pathlib.Path("panel")
h = hashlib.sha256()
files = [p for p in here.glob("*") if p.is_file()] + list((here / "i18n").glob("*.js"))
for p in sorted(files, key=lambda p: p.relative_to(here).as_posix()):
    h.update(p.relative_to(here).as_posix().encode()); h.update(p.read_bytes())
print(h.hexdigest()[:12])' 2>/dev/null)"
  if [ -n "$built" ] && [ -n "$here" ]; then
    if [ "$built" = "$here" ]; then ok "$(L "Deploy: the running panel is this code's" "배포: 실행 중인 패널이 지금 코드와 같음") ${D}($built)${N}"
    else warn "$(L "Deploy: the running panel differs from this code" "배포: 실행 중인 패널이 지금 코드와 다름") ${D}(./sidenote up)${N}"; fi
  fi
  # What CI said of this commit, only for a maintainer who turned the check on. Never a ✗: doctor's verdict is about
  # this PC's setup, and a commit's CI is not part of it.
  if ci_gate_on; then
    local state; state="$(ci_state)"
    case "$state" in
      success) ok "$(L "CI: this commit passed" "CI: 이 커밋 통과") ${D}($(git rev-parse --short HEAD))${N}" ;;
      running) warn "$(L "CI: this commit is being checked" "CI: 이 커밋 검사 중")" ;;
      "") ;;
      *) warn "$(L "CI: this commit failed ($state), so up refuses it ${D}(--no-ci deploys anyway)${N}" \
                   "CI: 이 커밋 실패($state), up이 배포하지 않음 ${D}(--no-ci면 그대로 배포)${N}")" ;;
    esac
  fi
  # The two engines as "level|line" pairs: one engine down while the other answers is a warning. The program is read
  # from a quoted here-document (its English has apostrophes), the language comes as its argument, and stdin stays
  # the health JSON. read stops at the end of the document and says so with status 1: not a failure here.
  local level line engines
  IFS= read -r -d '' engines <<'ENGINES' || true
import json, sys
T = (lambda en, ko: ko) if sys.argv[1:] == ["ko"] else (lambda en, ko: en)   # the launcher's L
d = json.load(sys.stdin); e = d.get("engines") or {}
L, C, ready = e.get("local") or {}, e.get("agent") or e.get("claude") or {}, e.get("ready", False)
# the word in this terminal's language, not the server's label (that follows the panel's language)
product = C.get("product") or ""
name = (T("Agent (%s)", "에이전트(%s)") % product) if product else T("Agent", "에이전트")   # the one place it is named here
login = C.get("login") or "./sidenote login"
down = "warn" if ready else "bad"
if L.get("present"):
    model, g, B = L.get("model", ""), L.get("loaded"), L.get("busy")
    # where the model is, in the panel's words: idle (off the GPU, it loads by itself with the next problem), on the
    # GPU with the memory it holds, or only connected when the model server does not say (not Ollama)
    where = ((T("idle", "대기 중"), model) if not g else (T("connected", "연결됨"), model) if g.get("unknown")
             else (T("on GPU", "GPU에 올라감"), model + (", %s GB" % g["vram_gb"] if g.get("vram_gb") else "")))
    if not L.get("on"): print(T("warn|Local model: off (Solver settings in the panel)", "warn|이 PC의 모델: 꺼 둠 (패널의 풀이 설정)"))
    elif L.get("ok") and B: print(T("warn|Local model: GPU busy, a smaller model solves (now %s, %s again soon)",
                                    "warn|이 PC의 모델: GPU 바쁨, 작은 모델로 푸는 중 (지금 %s, 곧 다시 %s)") % (B.get("model", ""), model))
    elif L.get("ok"): print(T("ok|Local model: %s (%s)", "ok|이 PC의 모델: %s (%s)") % where)
    # no GPU has room for it: the launcher's no_fit says so, in the words llm pull, install and doctor use
    elif L.get("missing") and L.get("fits") is False: print("%s|NOFIT" % down)
    elif L.get("missing"): print(T("%s|Local model: %s not downloaded (./sidenote llm pull)",
                                   "%s|이 PC의 모델: %s 없음 (./sidenote llm pull)") % (down, model))
    # the model server does not answer: the launcher's llm_down says whether its container is off, which only Docker knows
    else: print("%s|LLMDOWN" % down)
if C.get("present"):
    how = {"claude.ai": T("this PC's %s login", "이 PC의 %s 로그인") % (product or name),
           "chatgpt": T("this PC's %s login (ChatGPT)", "이 PC의 %s 로그인(ChatGPT)") % (product or name),
           "api-key": T("API key", "API 키"), "mock": T("mock, for tests", "테스트용 목업")}.get(C.get("method"), C.get("method") or "")
    # what it takes and what leaves this PC, as the panel's agent card says them: the cut-out problem and the
    # written-out text both come from the local model, so with it off or down the whole screen goes (payloadNow)
    what = {"hard": T("hard problems of the chosen types", "고른 유형의 어려운 문제"),
            "verify": T("a check of the local model's answers", "이 PC의 모델이 푼 답 확인"),
            "all": T("every problem", "모든 문제")}.get(C.get("effective"), "")
    pay = (C.get("payload") or "crop") if L.get("present") and L.get("on") and L.get("ok") else "screen"
    sent = {"crop": T("the problem area only", "문제 부분만"), "text": T("the problem text only", "문제 글만"),
            "screen": T("the whole screen", "화면 전체")}.get(pay, "")
    jobs = ", ".join(p for p in ((T("takes %s", "맡기는 문제: %s") % what) if what else "",
                                 (T("sends %s", "보내는 것: %s") % sent) if sent else "") if p)
    if C.get("mode") == "off": print(T("warn|%s: off (Solver settings in the panel)", "warn|%s: 꺼 둠 (패널의 풀이 설정)") % name)
    elif C.get("ok"): print(T("ok|%s: connected (%s)", "ok|%s: 연결됨 (%s)") % (name, how) + (", " + jobs if jobs else ""))
    elif C.get("rejected"): print(T("%s|%s: login expired (%s)", "%s|%s: 로그인 만료 (%s)") % (down, name, login))
    else: print(T("%s|%s: login needed (%s)", "%s|%s: 로그인 필요 (%s)") % (down, name, login))
if not ready: print(T("bad|No engine can answer (see above, or Solver settings in the panel)", "bad|풀 수 있는 엔진 없음 (위 항목, 또는 패널의 풀이 설정)"))
ENGINES
  while IFS='|' read -r level line; do
    if [ "$ENGINE_SOFT" = 1 ] && [ "$level" = bad ]; then level=warn; fi   # install: what is left to do next, not a failure
    if [ "$line" = NOFIT ]; then no_fit "$level"; continue; fi   # the one no-GPU line, at the level the server's state calls for
    if [ "$line" = LLMDOWN ]; then llm_down "$level"; continue; fi   # not answering: off (and why), or only silent
    case "$level" in ok) ok "$line" ;; warn) warn "$line" ;; *) bad "$line" ;; esac
  done < <(echo "$h" | python3 -c "$engines" "$UI_LANG" 2>/dev/null)
  local n screen audio server_audio; n="$(echo "$h" | json 'd["capture"]["clients"]')"
  screen="$(echo "$h" | json 'd["capture"].get("screen_on", True)')"
  audio="$(echo "$h" | json 'd["capture"].get("audio_on", True)')"
  server_audio="$(echo "$h" | json 'd.get("audio", True)')"
  local sound; if [ "$server_audio" != True ]; then sound="$(L "off, server setting SIDENOTE_AUDIO" "꺼짐, 서버 설정 SIDENOTE_AUDIO")"
  elif [ "$audio" = True ]; then sound="$(L on 켜짐)"; else sound="$(L off "꺼 둠")"; fi
  local procs=0   # capture programs Windows lists: asked only when none is connected (it takes a second)
  [ "$n" -gt 0 ] || procs="$(capture_running)"
  if [ "$n" -gt 0 ]; then
    local shown; if [ "$screen" = True ]; then shown="$(L on 켜짐)"; else shown="$(L off "꺼 둠")"; fi
    # Which PC, its system and the program's release, as the panel's Capture connection says them (the program's hello, who)
    local who; who="$(echo "$h" | json '", ".join(x for x in [str(w.get("host") or ""), str(w.get("system") or ""), ("v" + str(w["version"])) if w.get("version") else ""] if x) if isinstance(w := d["capture"].get("who"), dict) else ""' 2>/dev/null)"
    ok "$(L "Capture program: connected${who:+, $who} (screen ${shown}, sound ${sound})" "캡처 프로그램: 연결됨${who:+, $who} (화면 ${shown}, 소리 ${sound})")"
  elif [ "$procs" = "?" ]; then
    # Windows gave no process list. Nothing is connected, which is what the server knows; whether one is
    # running and reconnecting cannot be said, so it is not claimed.
    local winp; winp="$(win_problem)"
    if [ -n "$winp" ]; then   # Windows out of reach is why: that is said, not the process list
      warn "$(L "Capture program: not connected (the desktop shortcut starts it)" "캡처 프로그램: 연결 안 됨 (바탕화면 바로가기로 시작)")  ${D}(${winp%%:*})${N}"   # the reason's first clause: the whole of it is said once, elsewhere
    else
      warn "$(L "Capture program: not connected (./sidenote capture)  ${D}(could not read the Windows process list)${N}" \
                "캡처 프로그램: 연결 안 됨 (./sidenote capture)  ${D}(Windows 프로세스 목록을 읽지 못함)${N}")"
    fi
  elif [ "$procs" != "0" ]; then
    warn "$(L "Capture program: reconnecting  ${D}(one that is running connects within seconds)${N}" \
              "캡처 프로그램: 다시 연결 중  ${D}(실행 중이면 몇 초 안에 연결됨)${N}")"
  else
    warn "$(L "Capture program: not connected (./sidenote capture)" "캡처 프로그램: 연결 안 됨 (./sidenote capture)")"
  fi
  [ "$(echo "$h" | json 'd.get("paused", False)')" = True ] && warn "$(L "Automatic analysis: paused  ${D}(the panel's Continue button)${N}" "자동 분석: 일시정지 중  ${D}(패널의 계속하기 버튼)${N}")"
  if [ "$(echo "$h" | json 'd.get("runner", {}).get("configured", False)')" = True ]; then
    if [ "$(echo "$h" | json 'd["runner"]["ok"]')" = True ]; then ok "$(L "Code runner: ready" "코드 실행기: 준비됨")"
    elif [ "$(docker inspect -f '{{.State.Running}}' sidenote-runner 2>/dev/null)" = true ]; then
      bad "$(L "Code runner: not responding (./sidenote restart)" "코드 실행기: 응답 없음 (./sidenote restart)")"   # up leaves a running container alone
    else bad "$(L "Code runner: off (./sidenote up)" "코드 실행기: 꺼짐 (./sidenote up)")"; fi
  fi
  echo
  echo "  $(L "Open the panel" "패널 열기"): ${B}${URL}${N}   ${D}($(L "or ./sidenote open" "또는 ./sidenote open"))${N}"
}

cmd_logs() {
  docker_up
  if ! running; then
    # A server that ended by itself left its container, and the container its last lines: they are what says why it
    # ended, and status points here for them. Shown without -f (nothing more will come), then the same end as before.
    case "$(docker inspect -f '{{.State.Status}}' sidenote 2>/dev/null </dev/null || true)" in
      exited|dead) docker compose logs --tail 60 server || true ;;
    esac
    die "$(L "The server is off. ./sidenote up (what happened while it was off: ./sidenote events)" "서버가 꺼져 있습니다. ./sidenote up (꺼져 있던 동안의 이벤트는 ./sidenote events)")"
  fi
  docker compose logs -f --tail 60 server
}

cmd_login() {   # the cloud agent uses this PC's own login; this signs it in when it is not
  local which="${1:-$AGENT}"   # ./sidenote login codex, or the agent the server is set to use
  case "$which" in
    codex) login_codex ;;
    claude|claude-code|"") if [ "$ON_MAC" = 1 ]; then login_claude_token; return 0; fi; login_claude ;;
    anthropic-api) die "$(L "The Anthropic API uses ANTHROPIC_API_KEY in .env, not a login." "Anthropic API는 로그인 대신 .env의 ANTHROPIC_API_KEY를 씁니다.")" ;;
    *) die "$(L "Unknown agent: $which (claude-code or codex)" "알 수 없는 에이전트입니다: $which (claude-code 또는 codex)")" ;;
  esac
  if health >/dev/null; then
    echo "  $(L "The server picks up the new login within 20 seconds. Now:" "서버가 20초 안에 새 로그인을 반영합니다. 지금 상태:")"; cmd_status
  else
    echo "  $(L "Next: ./sidenote up" "다음: ./sidenote up")"
  fi
}

login_claude() {   # this only signs Claude Code in when it is not
  command -v claude >/dev/null || die "$(L "Claude Code (claude) is not installed on this PC. Install Claude Code first." "이 PC에 Claude Code(claude)가 설치되어 있지 않습니다. 먼저 Claude Code를 설치하세요.")"
  local how rejected; how="$(claude_login)"
  rejected="$(health | json 'd["auth"].get("rejected", False)' 2>/dev/null || true)"
  if [ -n "$how" ] && [ "$rejected" != True ]; then
    ok "$(L "This PC's Claude Code is signed in ($how). The server uses this login as it is." "이 PC의 Claude Code가 로그인되어 있습니다 ($how). 서버가 이 로그인을 그대로 씁니다.")"
  else
    [ "$rejected" = True ] && warn "$(L "The server rejected this login (expired). Signing in again." "서버에서 이 로그인이 거부됐습니다(만료). 다시 로그인합니다.")"
    [ -t 0 ] || die "$(L "Run the login in a terminal: ./sidenote login (one step signs in in a browser)" \
                         "로그인은 터미널에서 직접 실행하세요: ./sidenote login (브라우저에서 로그인하는 단계가 있습니다)")"
    echo "${B}$(L "Claude Code login" "Claude Code 로그인")${N} ${D}($(L "sign in in the browser, and the server uses this login too" "브라우저에서 로그인하면 서버도 이 로그인을 씁니다"))${N}"
    claude auth login || die "$(L "Could not sign in. Try ./sidenote login again" "로그인하지 못했습니다. ./sidenote login을 다시 실행하세요")"
    how="$(claude_login)"; [ -n "$how" ] || die "$(L "Not signed in yet. Try ./sidenote login again" "아직 로그인되지 않았습니다. ./sidenote login을 다시 실행하세요")"
    ok "$(L "Signed in ($how)." "로그인했습니다 ($how).")"
  fi
}

# On a Mac the server in Docker cannot read Claude Code's login from the Keychain, so it signs in with a long-lived token:
# `claude setup-token` makes one in the browser, and it is kept in .env, which compose.yaml hands to the server.
login_claude_token() {
  if [ -n "$(dotenv CLAUDE_CODE_OAUTH_TOKEN)" ]; then
    if ! running; then
      ok "$(L "The server signs in with the token in .env when it starts." "서버가 시작할 때 .env의 토큰으로 로그인합니다.")"
      echo "  $(L "Next: ./sidenote up" "다음: ./sidenote up")"
      return 0
    fi
    if ! token_served; then   # a server made before this token came into .env runs without it, or with an old one
      echo "  $(L "The server started before this token: starting it again" "서버가 이 토큰보다 먼저 시작돼 다시 시작합니다")"
      UP_NOW=1 cmd_up
      return 0
    fi
    if [ "$(health | json 'd["auth"].get("rejected", False)' 2>/dev/null || true)" != True ]; then
      ok "$(L "The server signs in with the token in .env (CLAUDE_CODE_OAUTH_TOKEN)." "서버가 .env의 토큰(CLAUDE_CODE_OAUTH_TOKEN)으로 로그인합니다.")"
      return 0
    fi
    warn "$(L "The server rejected the token in .env (expired). Making a new one." "서버에서 .env의 토큰이 거부됐습니다(만료). 새로 만듭니다.")"
  fi
  command -v claude >/dev/null || die "$(L "Claude Code (claude) is not installed on this PC. Install Claude Code first." "이 PC에 Claude Code(claude)가 설치되어 있지 않습니다. 먼저 Claude Code를 설치하세요.")"
  [ -t 0 ] || die "$(L "Run the login in a terminal: ./sidenote login (one step signs in in a browser)" \
                       "로그인은 터미널에서 직접 실행하세요: ./sidenote login (브라우저에서 로그인하는 단계가 있습니다)")"
  echo "${B}$(L "Claude Code token" "Claude Code 토큰")${N} ${D}($(L "the Mac keeps Claude Code's login in the Keychain, where Docker cannot read it" "맥은 Claude Code 로그인을 Docker가 못 읽는 키체인에 둡니다"))${N}"
  claude setup-token || die "$(L "Could not make a token. Try ./sidenote login again" "토큰을 만들지 못했습니다. ./sidenote login을 다시 실행하세요")"
  local token; token="$(read_pasted "$(L "Paste the token it printed: " "출력된 토큰을 붙여 넣으세요: ")")"
  [ -n "$token" ] || die "$(L "No token was pasted. Try ./sidenote login again" "붙여 넣은 토큰이 없습니다. ./sidenote login을 다시 실행하세요")"
  local shape='^sk-ant-[A-Za-z0-9_-]{20,}$'   # in a variable: bash 3.2 reads a quoted pattern as plain text
  [[ $token =~ $shape ]] || die "$(L "That is not the token claude setup-token printed (it starts with sk-ant-). Try ./sidenote login again" \
                                      "claude setup-token이 출력한 토큰이 아닙니다(sk-ant-로 시작). ./sidenote login을 다시 실행하세요")"
  # The new token replaces an old one in .env, and the rest of the file stays as it was
  local rest=""; [ -f .env ] && rest="$(grep -vE '^[[:space:]]*(export[[:space:]]+)?CLAUDE_CODE_OAUTH_TOKEN[[:space:]]*=' .env || true)"
  [ -f .env ] || (umask 077; : > .env)
  { [ -n "$rest" ] && printf '%s\n' "$rest"; printf 'CLAUDE_CODE_OAUTH_TOKEN=%s\n' "$token"; } > .env
  chmod 600 .env   # a token good for a year: this user's alone (compose reads the file as this user)
  ok "$(L "Token saved in .env." "토큰을 .env에 저장했습니다.")"
  # compose makes the server again when .env has changed, and the new one starts with the token. At once: without the
  # token the agent answers nothing, and an answer the restart cuts is solved again
  if running; then UP_NOW=1 cmd_up; else echo "  $(L "Next: ./sidenote up" "다음: ./sidenote up")"; fi
}

# The running server holds the token in .env: one made before it came into .env holds none, or the one it replaced.
token_served() { [ "$(docker exec sidenote printenv CLAUDE_CODE_OAUTH_TOKEN 2>/dev/null || true)" = "$(dotenv CLAUDE_CODE_OAUTH_TOKEN)" ]; }

# A token pasted at the terminal, with nothing shown. Read as every byte comes (no line at a time): a token wider than the
# window is copied as two lines or more, and read a line at a time its rest stayed for the shell once this ended, which
# ran it as a command. Done once a line has ended and nothing more has come for half a second, or at Ctrl+D. Printed: the
# token from the line that holds sk-ant-, with the lines after it that hold nothing else (a wrapped token's rest), or
# else all of it without spaces, for the check that follows to refuse.
read_pasted() {
  python3 -c '
import os, re, select, sys, termios
got, ended = b"", False
old = termios.tcgetattr(0)
raw = termios.tcgetattr(0)
raw[3] &= ~(termios.ICANON | termios.ECHO)
raw[6][termios.VMIN], raw[6][termios.VTIME] = 1, 0
try:
    termios.tcsetattr(0, termios.TCSANOW, raw)
    sys.stderr.write(sys.argv[1])
    sys.stderr.flush()
    while select.select([0], [], [], 0.5 if ended else None)[0]:
        chunk = os.read(0, 4096)
        got += chunk.split(b"\x04")[0]
        if not chunk or b"\x04" in chunk:
            break
        ended = ended or b"\n" in chunk or b"\r" in chunk
except KeyboardInterrupt:
    sys.exit(130)
finally:
    termios.tcsetattr(0, termios.TCSANOW, old)
    sys.stderr.write("\n")
lines = [line.strip() for line in re.split(r"\r\n|\r|\n", got.decode("utf-8", "replace"))]
for i, line in enumerate(lines):
    at = line.find("sk-ant-")
    if at >= 0:
        token = re.match(r"[A-Za-z0-9_-]*", line[at:]).group(0)
        if len(token) == len(line) - at:
            for rest in lines[i + 1:]:
                if not re.fullmatch(r"[A-Za-z0-9_-]+", rest):
                    break
                token += rest
        print(token)
        break
else:
    print("".join("".join(lines).split()))
' "$1"
}

# Codex signs in on this PC when it has the codex CLI; without one, the server's own copy does it with a device code
# (a code typed at a web page, no browser callback into the container), and the login lands in the same ~/.codex
# that the container mounts.
login_codex() {
  local how; how="$(codex_login)"
  if [ -z "$how" ] && running; then
    how="$(docker exec sidenote codex login status 2>&1 | sed -n 's/^Logged in using \(.*\)$/\1/p' | head -1 || true)"
  fi
  if [ -n "$how" ]; then
    ok "$(L "This PC's Codex is signed in ($how). The server uses this login as it is." "이 PC의 Codex가 로그인되어 있습니다 ($how). 서버가 이 로그인을 그대로 씁니다.")"
    return 0
  fi
  [ -t 0 ] || die "$(L "Run the login in a terminal: ./sidenote login codex" "로그인은 터미널에서 직접 실행하세요: ./sidenote login codex")"
  if command -v codex >/dev/null 2>&1; then
    echo "${B}$(L "Codex login" "Codex 로그인")${N} ${D}($(L "sign in in the browser, and the server uses this login too" "브라우저에서 로그인하면 서버도 이 로그인을 씁니다"))${N}"
    codex login || die "$(L "Could not sign in. Try ./sidenote login codex again" "로그인하지 못했습니다. ./sidenote login codex를 다시 실행하세요")"
  elif running; then
    echo "${B}$(L "Codex login" "Codex 로그인")${N} ${D}($(L "no codex on this PC, so the server's own Codex signs in: enter the code at the address it shows" \
                                                             "이 PC에 codex가 없어 서버 안의 Codex로 로그인합니다: 보여 주는 주소에서 코드를 입력하세요"))${N}"
    docker exec -it sidenote codex login --device-auth || die "$(L "Could not sign in. Try ./sidenote login codex again" "로그인하지 못했습니다. ./sidenote login codex를 다시 실행하세요")"
  else
    die "$(L "No codex on this PC, and the server is off. Run ./sidenote up, then ./sidenote login codex again" \
             "이 PC에 codex가 없고 서버도 꺼져 있습니다. ./sidenote up 뒤에 ./sidenote login codex를 다시 실행하세요")"
  fi
  ok "$(L "Signed in." "로그인했습니다.")"
}

# This checkout's capture client on Windows, found by the full path of capture.py in the command line
# of the programs that run it: cmd.exe, the Python launchers py.exe and pyw.exe, and the interpreters
# python.exe and pythonw.exe they start (C:\Windows\py.exe and pyw.exe, C:\Python314\python.exe and
# pythonw.exe on this PC). The names are compared whole: the pattern py*.exe used before also matched
# pycharm64.exe, so an IDE opened on capture.py would have been ended with -Force by capture-stop, down
# or uninstall. An editor with capture.py open, or the client of another copy of sidenote, is never
# touched. A folder name's apostrophe would end the string, and its [ ] * ? would be wildcards, so the path is quoted and
# escaped for -like; the query's own powershell.exe is left out by its name, and -contains compares names without
# regard to case. Never used with no path: the pattern would then be '**', and that is every python on Windows.
CLIENT_LIKE="('*' + [System.Management.Automation.WildcardPattern]::Escape('$(ps_quote "$CLIENT_WIN")') + '*')"
CAPTURE_PROCS="\$_.CommandLine -like ${CLIENT_LIKE} -and @('cmd.exe', 'py.exe', 'pyw.exe', 'python.exe', 'pythonw.exe') -contains \$_.Name"
# How many of this checkout's capture programs are running: the interpreter itself, python.exe or
# pythonw.exe (py.exe and pyw.exe only start it). Always a number, or "?" when Windows could not be asked:
# a query that printed nothing (a WMI error, PowerShell not answering) used to count as one running, so
# capture refused to start ("already running") and status said a capture program was reconnecting.
capture_running() {
  local n
  if [ "$ON_WSL" = 0 ]; then         # this desktop's own: the processes running client/capture.py for a server
    n="$(pgrep -f -- "[c]lient/capture[.]py --server" | wc -l | tr -d ' ')"   # counted by wc: macOS's pgrep has no -c
    printf '%s' "${n:-0}"; return 0
  fi
  [ -n "$CLIENT_WIN" ] || { printf '?'; return 0; }
  n="$(winps "@(Get-CimInstance Win32_Process | Where-Object { \$_.CommandLine -like ${CLIENT_LIKE} -and @('python.exe', 'pythonw.exe') -contains \$_.Name }).Count" | tail -1)" || n=""
  if [[ $n =~ ^[0-9]+$ ]]; then printf '%s' "$n"; else printf '?'; fi
}

# The capture program restarts itself into the capture.py on disk now, as from its tray's Restart (after a deploy
# it does so by itself at a quiet moment: capture_follow; this is for now). Asked through the server, like capture-stop.
cmd_capture_restart() {
  health >/dev/null || die "$(L "The server is off, so the capture program cannot be asked. ./sidenote up" "서버가 꺼져 있어 캡처 프로그램에 요청할 수 없습니다. ./sidenote up")"
  local n; n="$(curl -fsS --max-time 3 -X POST "$URL/capture/restart" 2>/dev/null | json 'd.get("asked", 0)' 2>/dev/null || echo 0)"
  if [ "${n:-0}" -gt 0 ]; then
    ok "$(L "Asked ${n} capture program$([ "$n" = 1 ] || echo s) to restart (it takes a few seconds)" "캡처 프로그램 ${n}개에 다시 시작을 요청했습니다 (몇 초 걸립니다)")"
  else warn "$(L "No capture program is connected. Start one with ./sidenote capture" "연결된 캡처 프로그램이 없습니다. ./sidenote capture로 시작하세요")"; fi
}

# How a user ends a capture program this launcher could not end, the same words wherever that is said: its tray icon
# first (the program closes its connection and takes the icon with it), and Task Manager for one that has no icon
# (--no-tray, or no pystray in Windows Python) or does not answer its menu.
tray_quit() {
  L "Right-click its tray icon > Quit. With no icon, end python.exe or pythonw.exe in Task Manager." \
    "트레이 아이콘을 오른쪽 클릭해 끝내기를 누르세요. 아이콘이 없으면 작업 관리자에서 python.exe나 pythonw.exe를 끄세요."
}

cmd_capture_stop() {
  local was left had=0; was="$(capture_running)"
  if [ "$was" != "0" ]; then   # one or more running, or not known ("?"): asking costs nothing either way
    # Ask through the server first: the capture program ends itself and takes its tray icon with it.
    # Killed outright, the icon stays in the notification area until something hovers over it.
    # (A window message does not do it: the tray library answers WM_CLOSE with nothing at all.)
    if ! health >/dev/null && [ -z "$(win_problem)" ]; then   # (with Windows out of reach there is no force either: said below)
      warn "$(L "The server is off, so the capture program cannot be asked. Ending it by force ${D}(its tray icon may stay for a moment)${N}" \
                "서버가 꺼져 있어 캡처 프로그램에 요청할 수 없습니다. 강제로 끕니다 ${D}(트레이 아이콘이 잠깐 남아 있을 수 있습니다)${N}")"
    fi
    had="$(clients)"                   # connected before the stop: what the server's count says afterwards is read against it
    curl -fsS --max-time 3 -X POST "$URL/capture/quit" >/dev/null 2>&1 || true
    local n=0
    while [ "$n" -lt 10 ]; do          # the socket closes when it goes; about 3 s at most
      [ "$(clients)" = "0" ] && break
      n=$((n + 1)); sleep 0.3
    done
    sleep 0.4                          # and a moment for the process itself to be gone
  fi
  if [ "$ON_WSL" = 0 ]; then
    pkill -f -- "[c]lient/capture[.]py --server" 2>/dev/null || true; sleep 0.3
  else
    # (not tried with Windows out of reach: nothing there can be ended from here, and that is said below)
    [ -z "$CLIENT_WIN" ] || [ -n "$(win_problem)" ] || winps "Get-CimInstance Win32_Process | Where-Object { ${CAPTURE_PROCS} } | ForEach-Object { Stop-Process -Id \$_.ProcessId -Force -ErrorAction SilentlyContinue }" >/dev/null || true
  fi
  left="$(capture_running)"
  if [ "$left" = "?" ] && [ -n "$(win_problem)" ]; then
    # Windows out of reach: its process list cannot be read, but the server's count can, and a capture program started
    # from Windows (client/launch.pyw, windows_starts) ends itself when the server asks it to, as above
    if health >/dev/null && [ "$(clients)" = 0 ]; then
      [ "${1:-}" = quiet ] && return 0
      if [ "$had" -gt 0 ] 2>/dev/null; then ok "$(L "Capture stopped." "캡처를 멈췄습니다.")"
      else ok "$(L "No capture program is connected." "연결된 캡처 프로그램이 없습니다.")"; fi
      return 0
    fi
    local why
    if health >/dev/null; then   # one is still connected, and nothing here can end a Windows program
      why="$(L "A capture program is still connected, and WSL cannot end Windows programs here." \
               "캡처 프로그램이 아직 연결되어 있는데, 여기서는 WSL이 Windows 프로그램을 끌 수 없습니다.") $(tray_quit)"
    else                         # the server is off: whether one is left cannot be told from here at all
      # Within down or uninstall this is one dim line, no mark: with the server off already every down came here, and
      # the "!" said each time that something was wrong when most often nothing was left at all.
      if [ "${1:-}" = quiet ]; then
        echo "  ${D}$(L "(with the server off and Windows out of reach, a capture program that is left cannot be seen from here: its tray icon > Quit ends it)" \
                        "(서버가 꺼져 있고 Windows에 닿지 못해 남은 캡처 프로그램을 여기서 볼 수 없습니다: 남아 있으면 트레이 아이콘 > 끝내기로 끕니다)")${N}"
        return 0
      fi
      why="$(L "The server is off and WSL cannot reach Windows programs here, so whether a capture program is left is not known. If one is:" \
               "서버가 꺼져 있고 여기서는 WSL이 Windows 프로그램에 닿을 수 없어, 캡처 프로그램이 남았는지 알 수 없습니다. 남아 있으면:") $(tray_quit)"
    fi
    if [ "${1:-}" = quiet ]; then warn "$why"; return 0; fi   # within down or uninstall: said, and they go on
    bad "$why"
    return 1
  fi
  if [ "$left" = "?" ]; then   # the stop went out, but whether it worked cannot be read
    bad "$(L "Could not read the Windows process list, so whether a capture program is left is not known. If one is:" \
             "Windows 프로세스 목록을 읽지 못해 캡처 프로그램이 남았는지 확인하지 못했습니다. 남아 있으면:") $(tray_quit)"
    return 1
  fi
  if [ "$left" != "0" ]; then   # how many, as the user guide says it does
    if [ "$ON_WSL" = 1 ]; then   # Windows processes: the tray icon's Quit, then Task Manager, are where a user ends them
      bad "$(L "${left} capture program$([ "$left" = 1 ] || echo s) still running." \
               "캡처 프로그램 ${left}개가 아직 남아 있습니다.") $(tray_quit)"
    else                         # this desktop's own: the command line that names them
      bad "$(L "${left} capture program$([ "$left" = 1 ] || echo s) still running. End it with: pkill -9 -f 'client/capture.py --server'" \
               "캡처 프로그램 ${left}개가 아직 남아 있습니다. 끄려면: pkill -9 -f 'client/capture.py --server'")"
    fi
    return 1
  fi
  [ "${1:-}" = quiet ] && return 0
  case "$was" in
    0) ok "$(L "No capture program is running." "실행 중인 캡처 프로그램이 없습니다.")" ;;
    \?) ok "$(L "No capture program is left." "남아 있는 캡처 프로그램이 없습니다.")" ;;   # none now; whether there was one before is not known
    *) ok "$(L "Capture stopped." "캡처를 멈췄습니다.")" ;;
  esac
}

# Characters cmd.exe acts on in the command line it is handed: & | < > start another command or redirect
# one, ^ escapes, % expands a variable, and a quote changes what the others mean. capture.py is started
# through cmd.exe (start /b for the windowless program, a plain call with --console), so an option holding
# one of them reached it cut short, or had the rest run as a command of its own. Measured:
# `R&rem after` left Python with `R`, and cmd.exe ran `rem after`. WSL quotes a value that has a space in
# it, and inside those quotes they would be harmless, but that is WSL's decision and not this script's, so
# an option holding any of them is refused, with a word on what to type instead. Only --audio-device takes
# free text, and a sound device is found by any part of its name.
WIN_UNSAFE='["%&|<>^]'
check_win_args() {
  local a
  for a in "$@"; do
    [[ $a =~ $WIN_UNSAFE ]] || continue
    die "$(L "An option holding a character the Windows command line acts on (\" % & | < > ^) cannot be passed: $a. For a device name, type a part of it without that character (any part of the name finds it)." \
             "Windows 명령줄이 특수하게 처리하는 문자(\" % & | < > ^)가 든 옵션은 넘길 수 없습니다: $a. 장치 이름이면 그 문자가 없는 부분만 적으세요 (이름의 일부만 맞아도 찾습니다).")"
  done
}

# Whether the capture packages import in Windows Python, and whether the tray icon's package is there as
# well: prints "tray" or "notray", and fails when one of the five the program needs does not import.
# pystray is optional (without it the program runs with no icon), so it is looked up rather than required.
# Checking the five alone said "installed" on a setup made before pystray joined
# client/requirements.txt, so install never added it, and the windowless program then ran with
# neither a window nor an icon.
win_packages() {
  win py -3 -c "import mss, soundcard, numpy, PIL, websocket, importlib.util; print('tray' if importlib.util.find_spec('pystray') else 'notray')" | tail -1
}

# Whether a capture program started just now is there: the server has more capture programs connected than
# the $1 it had before the start (the program connects first thing, and asking takes milliseconds), or
# Windows lists one (a second per question, but true while it is still waiting for the server).
capture_started() {
  [ "$(clients)" -gt "${1:-0}" ] && return 0
  local p; p="$(capture_running)"
  [[ $p =~ ^[1-9] ]]
}

# For client/launch.pyw when WSL cannot start Windows programs: the server brought up here, then one line for the starter to
# act on, tab-separated, last in the output. SIDENOTE-OPEN and the panel's address: a capture program is connected
# already, so the panel opens, as a second click does. SIDENOTE-START and the capture program with its arguments: the
# starter runs it with its own Windows Python, windowless, and waits for it to connect.
# SIDENOTE-LANG and the language go before that line when SIDENOTE_LANG is set (the environment or .env): WSLENV
# carries it to a program WSL starts, and this one Windows starts, so the starter puts it in the program's environment.
# SIDENOTE-SETUP and the command that sets the Windows side up go before it too, for the starter to show when its
# Python lacks the capture packages: worded here it has the wheels folder of a PC without internet (SIDENOTE_WHEELS)
# and the port set now, which the starter's own wording of it cannot know.
# A capture program that runs and is not connected yet (the server came up a moment ago, and it connects again within
# seconds) cannot be seen from here, Windows' process list being out of reach: the starter looks for it on its own
# side before it starts another (client/launch.pyw, capture_alive), and the program refuses to be the second one for
# a server (client/capture.py, OneCapture).
# A start with --up: the server brought up when it does not answer, and whether this start is what brought it up. That
# is read from Docker, before: a server that is busy (a model loading, a long answer) can let /health wait past its 3 s,
# and taken for one that is off, the session would have claimed a server someone else started, and its Quit ended it.
brought_up() {
  health >/dev/null && return 1
  local was=0
  running && was=1
  cmd_up
  [ "$was" = 0 ]
}

# The capture program's --stop-server-on-quit on WSL: this checkout as Windows sees it, the only form the program takes
# (client/capture.py, server_down_command). A checkout on a Windows drive (/mnt/c) has no such form, and hands nothing on.
quit_ends() {
  local w; w="$(wslpath -w "$PWD" 2>/dev/null)"
  case "$w" in '\\wsl'*) printf '%s\n' --stop-server-on-quit "$w" ;; esac
}

windows_starts() {
  local up="$1" ends=(); shift
  # whoever starts the server stops it: a start that brought it up hands its checkout on (see cmd_capture)
  if [ "$up" = 1 ]; then wait_down; brought_up && ends=($(quit_ends)); fi
  health >/dev/null || die "$(L "The server is off. Start it first with ./sidenote up, or start both with ./sidenote capture --up." \
                                  "서버가 꺼져 있습니다. ./sidenote up으로 먼저 켜거나 ./sidenote capture --up으로 함께 켜세요.")"
  if [ "$(clients)" -gt 0 ]; then
    ok "$(L "The capture is already running" "캡처가 이미 실행 중입니다")"
    printf 'SIDENOTE-OPEN\t%s\n' "$URL"
    return 0
  fi
  ensure_dirs
  rotate_capture_log
  local logwin; logwin="$(wslpath -w "$LOG_PATH/capture.log")"
  ok "$(L "WSL cannot start Windows programs here: Windows starts the capture program" "여기서는 WSL이 Windows 프로그램을 실행할 수 없어 Windows 쪽에서 캡처 프로그램을 시작합니다")"
  case "${SIDENOTE_LANG:-}" in en|ko) printf 'SIDENOTE-LANG\t%s\n' "$SIDENOTE_LANG" ;; esac   # one that is set, never the locale's pick
  printf 'SIDENOTE-SETUP\t%s\n' "$(win_setup_command)"   # one line, no tab in it: the starter reads the first field
  printf 'SIDENOTE-START\t%s' "$CLIENT_WIN"
  printf '\t%s' --server "ws://127.0.0.1:${PORT}/ingest" --log "$logwin" --started shortcut ${@+"$@"} ${ends[@]+"${ends[@]}"}
  printf '\n'
}

# A capture program already running. From the desktop shortcut (--up) the panel opens, as a second click on a running
# app's shortcut shows that app: it used to end in a failure box saying the capture was running. A terminal's
# ./sidenote capture is told, as before ($2), and ends in failure.
already_capturing() {
  if [ "$1" = 1 ]; then
    ok "$(L "The capture is already running" "캡처가 이미 실행 중입니다")"
    cmd_open
    exit 0
  fi
  die "$2"
}

cmd_capture() {
  if [ "$ON_WSL" = 0 ]; then cmd_capture_here "$@"; return; fi
  [ -n "$CLIENT_WIN" ] || die "$(L "Could not find the Windows path (wslpath)." "Windows 경로를 찾지 못했습니다 (wslpath).")"
  # The options for capture.py, each one exactly the word that was typed, kept in an array so that a value
  # with spaces in it ("Realtek USB2.0 Audio", the way Windows names a sound device) stays one argument and
  # no quote character is added to any of them. The windowless start used to wrap every option
  # in quote characters of its own, which WSL hands on as part of the argument (Python received "--monitor"
  # with the quotes), so argparse refused every option and the program ended before it opened its log;
  # --console and --up rebuilt the list with `set -- $(...)`, which cut a value at every space.
  # --up, --console and --from-windows are this launcher's own: they are noted here and not passed on (capture.py
  # would refuse them). --once sends one screen and ends, so it runs in this terminal as with --console, where
  # what it did is printed; started windowless it could also be gone before the start was seen.
  local a up=0 console=0 from_win=0 opts=() started=0
  for a in "$@"; do
    case "$a" in
      --up) up=1 ;;
      --console) console=1 ;;
      --from-windows) from_win=1 ;;   # client/launch.pyw, which can start the capture program itself (windows_starts)
      *) opts+=("$a")
         if [ "$a" = --once ]; then console=1; fi ;;
    esac
  done
  check_win_args ${opts[@]+"${opts[@]}"}   # before cmd.exe, or the starter on Windows, sees any of them
  # WSL out of reach of Windows ([interop] enabled=false, no Windows drive): from the desktop shortcut the server comes up
  # here and the starter on Windows starts the capture program, as starting a Windows program from Windows asks nothing
  # of WSL's interop; from a terminal it is said as such, before anything is asked of Windows (not as a missing Python)
  if [ "$from_win" = 1 ] && [ "$console" = 0 ] && [ -n "$(win_problem)" ]; then
    windows_starts "$up" ${opts[@]+"${opts[@]}"}
    return
  fi
  need_win
  # before the monitor list or the help is asked of it too: without Python cmd.exe's own English line was all, with status 0
  win py -3 --version >/dev/null || die "$(L "No Python (py) on Windows. Install it from python.org, then ./sidenote setup-capture" \
                                              "Windows에 Python(py)이 없습니다. python.org에서 설치한 뒤 ./sidenote setup-capture를 실행하세요")"
  # Only listing the monitors, or the options: capture.py answers and ends, so it runs here and now.
  for a in ${opts[@]+"${opts[@]}"}; do
    case "$a" in --list-monitors|--help|-h)
      (cd "$WIN_CWD" && "$CMD_EXE" /c py -3 -X utf8 -u "$CLIENT_WIN" ${opts[@]+"${opts[@]}"} 2>&1 | sed -u 's/\r$//' | grep -vE "UNC paths|CMD.EXE|^$") || true
      return 0 ;;
    esac
  done
  if [ "$up" = 1 ]; then   # bring the server up first (the desktop shortcut does this, through client/launch.pyw)
    # The desktop shortcut runs this with no terminal at all: client/launch.pyw reads what it prints, and its
    # failing status, and shows the reason in a message box. There the title and the wait below do nothing.
    # They are for a terminal window that closes the moment this script ends, taking every word of why with it,
    # which an older shortcut opened (wsl.exe in a console window of its own): an end in failure
    # waits for Enter first (only when there is a terminal to read from), and the terminal gets its own title
    # back however this ends.
    term_title "Sidenote Capture"
    trap 'rc=$?; term_title ""; if [ "$rc" != 0 ] && [ -t 0 ]; then printf "\n  %s" "$(L "Press Enter to close this window " "Enter를 누르면 이 창을 닫습니다 ")"; read -r _ || true; fi' EXIT
    # In the output, not sent to /dev/null: after a reboot nothing is running, and when the server cannot start
    # (Docker off, the port taken) its reason is what has to be seen, in the terminal or in the shortcut's
    # message box (the last lines of this output). The first start also builds the image for minutes; in a
    # terminal, the dots `up` prints say that it is still going.
    wait_down
    brought_up && started=1
  fi
  health >/dev/null || die "$(L "The server is off. Start it first with ./sidenote up, or start both with ./sidenote capture --up." \
                                  "서버가 꺼져 있습니다. ./sidenote up으로 먼저 켜거나 ./sidenote capture --up으로 함께 켜세요.")"
  # Whoever starts the server stops it. The server is a service of its own, and the capture program a client of it,
  # which neither starts nor stops it; this launcher does both. A start that brought the server up for this session
  # hands the program this checkout, whose ./sidenote down the program's Quit in the tray runs too (client/capture.py,
  # server_down_command): the session ends as it began. A server that was already up was started by someone else
  # (./sidenote up, another session), and Quit leaves it to them.
  local ends=()
  if [ "$started" = 1 ]; then ends=($(quit_ends)); fi
  # How it was started, which the panel's Capture connection shows (client/capture.py, who_am_i): from the desktop shortcut's
  # starter (client/launch.pyw, --from-windows) or from a terminal
  local how=(--started terminal)
  if [ "$from_win" = 1 ]; then how=(--started shortcut); fi
  local packages
  packages="$(win_packages)" || die "$(L "The capture packages are not in Windows Python. ./sidenote setup-capture" "Windows Python에 캡처 패키지가 없습니다. ./sidenote setup-capture")"
  # Two capture programs would send every screen twice. Windows' process list says whether one is running;
  # when it cannot be read ("?"), the server says whether one is connected, which is the one that would send.
  local procs; procs="$(capture_running)"
  if [ "$procs" = "?" ]; then
    [ "$(clients)" -gt 0 ] && already_capturing "$up" "$(L "The capture is already running (connected to the server). Quit it from the tray icon or with ./sidenote capture-stop" \
                                         "캡처가 이미 실행 중입니다(서버에 연결됨). 트레이 아이콘에서 끝내거나 ./sidenote capture-stop을 실행하세요")"
    warn "$(L "Could not read the Windows process list. No capture program is connected to the server, so one is started." \
              "Windows 프로세스 목록을 읽지 못했습니다. 서버에 연결된 캡처 프로그램이 없어 시작합니다.")"
  elif [ "$procs" != "0" ]; then
    already_capturing "$up" "$(L "The capture is already running. Quit it from the tray icon or with ./sidenote capture-stop" "캡처가 이미 실행 중입니다. 트레이 아이콘에서 끝내거나 ./sidenote capture-stop을 실행하세요")"
  fi
  ensure_dirs
  rotate_capture_log
  # Windowless by default: the program has a tray icon to open the panel and to end it, so a console
  # window of its own is one more thing on the taskbar for nothing. --console keeps it in this terminal.
  if [ "$console" = 0 ]; then
    # Without its tray icon (no pystray in Windows Python, or --no-tray) the program runs with neither a
    # window nor an icon. That is said before it starts, with the one way left to end it.
    local tray=1
    [ "$packages" = tray ] || tray=0
    for a in ${opts[@]+"${opts[@]}"}; do if [ "$a" = --no-tray ]; then tray=0; fi; done
    if [ "$packages" != tray ]; then
      warn "$(L "Starting without a tray icon: pystray is not in Windows Python ${D}(install: ./sidenote setup-capture)${N}. To end it: ${B}./sidenote capture-stop${N}" \
                "트레이 아이콘 없이 시작합니다: Windows Python에 pystray가 없습니다 ${D}(설치: ./sidenote setup-capture)${N}. 끝낼 때는 ${B}./sidenote capture-stop${N}")"
    elif [ "$tray" = 0 ]; then
      warn "$(L "Starting without a tray icon (--no-tray). To end it: ${B}./sidenote capture-stop${N}" "트레이 아이콘 없이 시작합니다 (--no-tray). 끝낼 때는 ${B}./sidenote capture-stop${N}")"
    fi
    local logwin; logwin="$(wslpath -w "$LOG_PATH/capture.log")"
    local base; base="$(clients)"   # connected before the start, so one elsewhere is not taken for this one
    # setsid --fork, because WSL's interop helper returns only once every Windows process it
    # started has ended, `start /b` or not (measured: 3.1 s for a `start /b` of a 3 s
    # ping). Run plainly, this line sat here for the whole capture session, so the lines below never
    # printed and the shortcut's own console window stayed on the taskbar next to the tray icon.
    # --fork is the part that matters: plain `setsid`, and even `( ... & )`, leave the helper a
    # child of this shell, and a shell whose output is a pipe (`./sidenote capture | tail`) waits
    # for its background children before it exits (measured: 5 s either way, 0.003 s with --fork).
    # With --fork the child exits at once and the helper belongs to init, in a session of its own,
    # so closing the window cannot hang it up either.
    # </dev/null: there is no terminal left to read from once the launcher has moved on.
    # The capture program is a Windows process and outlives the helper regardless (measured: helper
    # killed, program still capturing), so nothing on this side holds it open.
    # ${opts[@]+"${opts[@]}"}: every option one argument, as typed (see the top of this function). WSL puts a value
    # with spaces in quotes for the Windows command line, and cmd.exe and start pass it on whole
    # (measured with a script that only writes down its arguments).
    (cd "$WIN_CWD" && setsid --fork "$CMD_EXE" /c start "" /b pyw -3 -X utf8 "$CLIENT_WIN" \
        --server "ws://127.0.0.1:${PORT}/ingest" --log "$logwin" "${how[@]}" ${opts[@]+"${opts[@]}"} ${ends[@]+"${ends[@]}"} \
        >/dev/null 2>&1 </dev/null) || true
    local n=0
    while [ "$n" -lt 20 ]; do          # about ten seconds at most
      capture_started "$base" && break
      n=$((n + 1)); sleep 0.5
    done
    if ! capture_started "$base"; then
      bad "$(L "The capture program did not start. See what stops it with ./sidenote capture --console." "캡처 프로그램이 시작되지 않았습니다. ./sidenote capture --console로 원인을 확인하세요.")"
      return 1
    fi
    if [ "$tray" = 1 ] && [ ${#ends[@]} -gt 0 ]; then   # the server came up with it, and goes with it (see above)
      ok "$(L "Screen and sound capture started ${D}(no window, a tray icon)${N}" "화면과 소리 캡처를 시작했습니다 ${D}(창 없이, 트레이 아이콘으로)${N}")"
      echo "  $(L "To end it and the server it started: right-click the tray icon > Quit Sidenote, or ${B}./sidenote down${N}" \
                  "끝내기(함께 켠 서버도): 트레이 아이콘 오른쪽 클릭 > Sidenote 끝내기, 또는 ${B}./sidenote down${N}")"
    elif [ "$tray" = 1 ]; then
      ok "$(L "Screen and sound capture started ${D}(no window, a tray icon)${N}" "화면과 소리 캡처를 시작했습니다 ${D}(창 없이, 트레이 아이콘으로)${N}")"
      echo "  $(L "To end it: right-click the tray icon > Quit, or ${B}./sidenote capture-stop${N}" "끝내기: 트레이 아이콘 오른쪽 클릭 > 끝내기, 또는 ${B}./sidenote capture-stop${N}")"
    else
      ok "$(L "Screen and sound capture started ${D}(no window and no tray icon)${N}" "화면과 소리 캡처를 시작했습니다 ${D}(창도 트레이 아이콘도 없이)${N}")"
      echo "  $(L "To end it" "끝내기"): ${B}./sidenote capture-stop${N}"
    fi
    echo "  $(L "Panel" "패널"): ${B}${URL}${N}   $(L "Log" "로그"): $LOG_PATH/capture.log"
    return 0
  fi
  echo "$(L "${B}Starting screen and sound capture${N} ${D}(Ctrl+C ends it. The panel turns the screen and the sound on and off separately)${N}" \
            "${B}화면과 소리 캡처를 시작합니다${N} ${D}(끝내려면 Ctrl+C. 패널에서 화면과 소리를 따로 켜고 끌 수 있습니다)${N}")"
  echo "  $(L "Panel" "패널"): ${B}${URL}${N}   $(L "Log" "로그"): $LOG_PATH/capture.log"
  term_title "Sidenote Capture"
  # The stop on the way out ends a program that Ctrl+C here left running on Windows. A program that ended because
  # another one already captures for this server (CAPTURE_REFUSED, set below) is not this capture ending: the stop
  # would end the one that runs, which nobody asked for, and "Capture ended." would say it of a capture that goes on.
  CAPTURE_REFUSED=0
  trap 'if [ "$CAPTURE_REFUSED" = 0 ]; then cmd_capture_stop quiet || true; fi; term_title ""; if [ "$CAPTURE_REFUSED" = 0 ]; then echo; echo "  $(L "Capture ended." "캡처를 끝냈습니다.")"; fi' EXIT
  trap 'exit 0' INT TERM
  # -X utf8: Windows Python writes a pipe in the ANSI code page (cp949), which turns Korean
  # device names and error messages into mojibake here and in capture.log.
  # sed -u, not tr: tr holds about 4 KB before passing anything on, so lines showed up late and
  # Ctrl+C threw away what it held (also from capture.log).
  # ${opts[@]+"${opts[@]}"}: the options as typed, without --console (see the top of this function).
  # The program's own exit code is kept (the first of the pipe's, which grep's and the others' would hide): 76 is
  # the program saying another one runs for this server (CAPTURE_BUSY in client/capture.py), its two lines printed
  # above. set +e in the subshell, so a pipe that ends in failure does not end it before the code is read.
  local ended=0
  (set +e; cd "$WIN_CWD" || exit 0
   "$CMD_EXE" /c py -3 -X utf8 -u "$CLIENT_WIN" --server "ws://127.0.0.1:${PORT}/ingest" "${how[@]}" ${opts[@]+"${opts[@]}"} \
     ${ends[@]+"${ends[@]}"} 2>&1 | sed -u 's/\r$//' \
     | grep --line-buffered -vE "DeprecationWarning|mss.mss\(\)|^\s*with mss|UNC paths|CMD.EXE|^$" | log_capture
   exit "${PIPESTATUS[0]}") || ended=$?
  if [ "$ended" = 76 ]; then CAPTURE_REFUSED=1; return 1; fi   # as a windowless start that finds one running ends
}

# A Linux desktop: the capture program runs here, from the virtual environment ./sidenote setup-capture makes on Linux,
# reading the X11 screen (mss) and the speaker sound through PulseAudio or PipeWire's PulseAudio (soundcard). The same
# options as on WSL; --up and --console are this launcher's own.
here_py() { printf '%s' "$CAPTURE_VENV/bin/python"; }
# "tray" or "notray" as win_packages prints them, failing when one of the five does not import. Looked up, not
# imported: importing soundcard and pystray connects to the sound server and the display.
here_packages() {
  [ -x "$(here_py)" ] || return 1
  "$(here_py)" -c "import importlib.util as u, sys
if any(u.find_spec(n) is None for n in ('mss', 'soundcard', 'numpy', 'PIL', 'websocket')): sys.exit(1)
print('tray' if u.find_spec('pystray') else 'notray')" 2>/dev/null
}
setup_capture_here() {
  echo "${B}$(L "Installing the capture packages" "캡처 패키지를 설치합니다")${N} ($CAPTURE_VENV)"
  # Without python3-venv, `python3 -m venv` fails halfway and leaves a python with no pip behind; a later run would
  # take that for a finished environment. One that cannot run pip is made again from nothing (--clear).
  if ! "$(here_py)" -m pip --version >/dev/null 2>&1; then
    python3 -m venv --clear "$CAPTURE_VENV" && "$(here_py)" -m pip --version >/dev/null 2>&1 \
      || die "$(L "Could not make a virtual environment with pip. Install python3-venv (on Ubuntu: sudo apt install python3-venv) and run ./sidenote setup-capture again." \
                  "pip가 든 가상 환경을 만들지 못했습니다. python3-venv를 설치한 뒤(Ubuntu: sudo apt install python3-venv) ./sidenote setup-capture를 다시 실행하세요.")"
  fi
  local source=()
  if [ -n "$(setting SIDENOTE_WHEELS "")" ]; then source=(--no-index --find-links "$(setting SIDENOTE_WHEELS "")"); fi   # no internet here: docs/air-gapped.md
  "$(here_py)" -m pip install -q ${source[@]+"${source[@]}"} -r client/requirements.txt 2>&1 | tail -3
}
cmd_capture_here() {
  local a up=0 console=0 opts=() packages ends=()
  for a in "$@"; do
    case "$a" in
      --up) up=1 ;;
      --console) console=1 ;;
      *) opts+=("$a"); if [ "$a" = --once ]; then console=1; fi ;;
    esac
  done
  packages="$(here_packages)" || { setup_capture_here; packages="$(here_packages)"; } \
    || die "$(L "The capture packages did not install. ./sidenote setup-capture shows why." "캡처 패키지가 설치되지 않았습니다. ./sidenote setup-capture로 원인을 확인하세요.")"
  for a in ${opts[@]+"${opts[@]}"}; do
    case "$a" in --list-monitors|--help|-h) "$(here_py)" -X utf8 -u client/capture.py ${opts[@]+"${opts[@]}"}; return 0 ;; esac
  done
  [ "$ON_MAC" = 1 ] || [ -n "${DISPLAY:-}" ] || die "$(L "No X11 display here (DISPLAY is not set). The capture program reads an X11 screen: run it in the desktop session." \
                                    "X11 화면이 없습니다(DISPLAY가 비어 있음). 캡처 프로그램은 X11 화면을 읽으니 데스크톱 세션에서 실행하세요.")"
  # whoever starts the server stops it: a start that brought it up hands this checkout on (see cmd_capture)
  if [ "$up" = 1 ]; then wait_down; brought_up && ends=(--stop-server-on-quit "$PWD"); fi
  health >/dev/null || die "$(L "The server is off. Start it first with ./sidenote up, or start both with ./sidenote capture --up." \
                                  "서버가 꺼져 있습니다. ./sidenote up으로 먼저 켜거나 ./sidenote capture --up으로 함께 켜세요.")"
  # with --up the panel opens and it ends well, as on WSL (already_capturing): "start everything" finds it started
  [ "$(capture_running)" = 0 ] || already_capturing "$up" "$(L "The capture is already running. Quit it from the tray icon or with ./sidenote capture-stop" \
                                                              "캡처가 이미 실행 중입니다. 트레이 아이콘에서 끝내거나 ./sidenote capture-stop을 실행하세요")"
  if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    warn "$(L "A Wayland session: the screen is read through X11 (XWayland), which may show only X11 windows. If the panel shows a blank screen, log in to an X11 session." \
              "Wayland 세션입니다: 화면을 X11(XWayland)로 읽어 X11 창만 보일 수 있습니다. 패널에 빈 화면이 보이면 X11 세션으로 로그인하세요.")"
  fi
  ensure_dirs
  rotate_capture_log
  local cmd=("$(here_py)" -X utf8 -u client/capture.py --server "ws://127.0.0.1:${PORT}/ingest" --started terminal)
  if [ "$console" = 1 ]; then
    echo "$(L "${B}Starting screen and sound capture${N} ${D}(Ctrl+C ends it)${N}" "${B}화면과 소리 캡처를 시작합니다${N} ${D}(끝내려면 Ctrl+C)${N}")"
    ${cmd[@]+"${cmd[@]}"} ${opts[@]+"${opts[@]}"} ${ends[@]+"${ends[@]}"} 2>&1 | log_capture || true
    return 0
  fi
  local base; base="$(clients)"
  # setsid --fork: a session of its own, so closing this terminal does not end it (see the WSL start above)
  if command -v setsid >/dev/null; then
    setsid --fork ${cmd[@]+"${cmd[@]}"} --log "$LOG_PATH/capture.log" ${opts[@]+"${opts[@]}"} ${ends[@]+"${ends[@]}"} \
      >/dev/null 2>&1 </dev/null || true
  else   # macOS has no setsid: nohup, in the background, keeps it past this terminal
    nohup ${cmd[@]+"${cmd[@]}"} --log "$LOG_PATH/capture.log" ${opts[@]+"${opts[@]}"} ${ends[@]+"${ends[@]}"} \
      >/dev/null 2>&1 </dev/null &
  fi
  local n=0
  while [ "$n" -lt 20 ]; do
    capture_started "$base" && break
    n=$((n + 1)); sleep 0.5
  done
  capture_started "$base" || { bad "$(L "The capture program did not start. See what stops it with ./sidenote capture --console." "캡처 프로그램이 시작되지 않았습니다. ./sidenote capture --console로 원인을 확인하세요.")"; return 1; }
  if [ "$packages" = tray ]; then
    ok "$(L "Screen and sound capture started ${D}(a tray icon, where the desktop shows them)${N}" "화면과 소리 캡처를 시작했습니다 ${D}(트레이 아이콘은 데스크톱의 알림 영역에)${N}")"
  else
    ok "$(L "Screen and sound capture started ${D}(no tray icon)${N}" "화면과 소리 캡처를 시작했습니다 ${D}(트레이 아이콘 없이)${N}")"
  fi
  echo "  $(L "To end it" "끝내기"): ${B}./sidenote capture-stop${N}   $(L "Panel" "패널"): ${B}${URL}${N}   $(L "Log" "로그"): $LOG_PATH/capture.log"
}

cmd_llm() {   # the local LLM: pull, list, logs
  if ! own_llm; then
    die "$(L "The local model is served by $LOCAL_URL (SIDENOTE_LOCAL_URL): its models are that server's, pulled and listed there" \
             "이 PC의 모델은 $LOCAL_URL 서버가 맡습니다(SIDENOTE_LOCAL_URL): 모델 받기와 목록은 그 서버에서 합니다")"
  fi
  docker_up
  case "${1:-}" in
    pull)
      if offline; then die "$(L "With SIDENOTE_OFFLINE=1 a model comes with the bundle, not from the internet: docs/air-gapped.md" \
                                "SIDENOTE_OFFLINE=1이면 모델은 묶음으로 가져옵니다: docs/air-gapped.md")"; fi
      shift; local models=("$@")
      if [ ${#models[@]} -eq 0 ]; then
        # a GPU that could not be read is not a GPU that is too small: only the second is the no-GPU case
        local names; names="$(models_to_pull)" \
          || die "$(L "Could not read this PC's GPU (server/hardware.py). Name the model: ./sidenote llm pull gemma4:e4b" \
                      "이 PC의 GPU를 읽지 못했습니다(server/hardware.py). 모델 이름을 적으세요: ./sidenote llm pull gemma4:e4b")"
        if [ -z "$names" ]; then
          no_fit warn   # the words install, doctor and status use for the same case
          return 0
        fi
        models=(); while IFS= read -r m; do [ -n "$m" ] && models+=("$m"); done <<<"$names"   # not mapfile: bash 3.2 has none
      fi
      # sidenote-<model> is <model> with a larger batch (compose.yaml: llm-pull), made right after the pull.
      echo "$(L "${B}Downloading the local model${N}: ${models[*]} ${D}(a few GB to tens of GB; only this download container uses the internet)${N}" \
                "${B}이 PC의 모델을 받습니다${N}: ${models[*]} ${D}(수 GB에서 수십 GB, 인터넷은 이 받기 컨테이너만 씁니다)${N}")"
      docker compose --profile tools run --rm --no-deps llm-pull ${models[@]+"${models[@]}"} 2>&1 | grep -vE "^\s*$|pulling [0-9a-f]{12}" | sed 's/^/  /'
      # an if, not &&: with the server down the pull still succeeded (set -e would end on the failed test)
      if health >/dev/null; then echo "  $(L "The server picks up the model within 20 seconds." "서버가 20초 안에 모델을 반영합니다.")"; fi ;;
    list) llm_list ;;
    rm) shift; llm_rm "$@" ;;
    logs) docker compose logs -f --tail 60 llm ;;
    *) die "$(L "Usage: ./sidenote llm pull [model ...] | list | rm model ... [--yes] | logs   (model now: $LOCAL_MODEL, while the GPU is busy: $BUSY_MODEL)" \
                "사용법: ./sidenote llm pull [모델 ...] | list | rm 모델 ... [--yes] | logs   (지금 모델: $LOCAL_MODEL, GPU가 바쁠 때: $BUSY_MODEL)")" ;;
  esac
}

# The local model server's models, as `ollama list` prints them: asked of the running llm container, or else of an Ollama
# started for the question in the tools container, over the same volume (nothing is downloaded either way)
llm_list() {
  if docker ps --format '{{.Names}}' | grep -qx sidenote-llm; then docker exec sidenote-llm ollama list
  else docker compose --profile tools run --rm --no-deps --entrypoint sh llm-pull -c 'ollama serve >/dev/null 2>&1 & i=0; until ollama list >/dev/null 2>&1; do i=$((i + 1)); [ "$i" -lt 120 ] || exit 1; sleep 0.5; done; ollama list'; fi
}
# `ollama rm` of each model named, in the same two places: one at a time, so the first that fails says which
llm_remove() {
  local m
  if docker ps --format '{{.Names}}' | grep -qx sidenote-llm; then
    for m in "$@"; do docker exec sidenote-llm ollama rm "$m" || return 1; done
  else   # the names reach sh as its arguments ("$@" there), never as part of the script's text
    docker compose --profile tools run --rm --no-deps --entrypoint sh llm-pull -c 'ollama serve >/dev/null 2>&1 & i=0; until ollama list >/dev/null 2>&1; do i=$((i + 1)); [ "$i" -lt 120 ] || exit 1; sleep 0.5; done; for m in "$@"; do ollama rm "$m" || exit 1; done' sh "$@"
  fi
}
# ./sidenote llm rm MODEL ... [--yes]: a downloaded model taken off the PC, with the tuned copy Sidenote makes of it
# (sidenote-MODEL, compose.yaml: llm-pull), which shares its files: the one without the other frees nothing. Named either
# way, the two go together. The sizes are shown and a yes is asked first; a model that is not there is said, and ends 1.
llm_rm() {
  local usage yes=0 asked=() a
  usage="$(L "Usage: ./sidenote llm rm model ... [--yes]" "사용법: ./sidenote llm rm 모델 ... [--yes]")"
  for a in "$@"; do
    case "$a" in
      --yes) yes=1 ;;
      -*) die "$usage" ;;   # an option this command does not have: said, nothing removed
      *) asked+=("$a") ;;
    esac
  done
  [ ${#asked[@]} -gt 0 ] || die "$usage"
  local listed; listed="$(llm_list 2>&1)" \
    || die "$(L "Could not list the models: $(tail -1 <<<"$listed")" "모델 목록을 읽지 못했습니다: $(tail -1 <<<"$listed")")"
  # Each name asked for, and its pair: the base model and sidenote-<base>, each as listed (":latest" when pulled
  # without a tag), with its size from the same line (SIZE is two words: "9.6 GB")
  local gone=() bases=() missing=() shown="" m base cand line name hit g dup
  for m in "${asked[@]}"; do
    base="${m#sidenote-}"
    hit=0
    for cand in "$base" "sidenote-$base"; do
      line="$(awk -v n="$cand" 'NR > 1 && ($1 == n || $1 == n ":latest") { print $1 "|" $3 " " $4; exit }' <<<"$listed")"
      [ -n "$line" ] || continue
      hit=1
      name="${line%%|*}"
      dup=0; for g in ${gone[@]+"${gone[@]}"}; do if [ "$g" = "$name" ]; then dup=1; fi; done
      if [ "$dup" = 1 ]; then continue; fi   # asked for twice, under both names
      gone+=("$name")
      shown="$shown    $name  ${D}${line#*|}${N}"$'\n'
    done
    if [ "$hit" = 1 ]; then bases+=("$base"); else missing+=("$m"); fi
  done
  for m in ${missing[@]+"${missing[@]}"}; do
    bad "$(L "Not on this PC: $m  (./sidenote llm list shows what is)" "이 PC에 없는 모델입니다: $m  (있는 모델은 ./sidenote llm list)")"
  done
  [ ${#gone[@]} -gt 0 ] || exit 1
  echo "$(L "${B}Models to remove${N}" "${B}지울 모델${N}")"
  printf '%s' "$shown"
  if [ "$yes" != 1 ]; then
    # No terminal to answer at: the line that removes them without the question
    [ -t 0 ] || die "$(L "Asked with no terminal to answer at. To remove them: ./sidenote llm rm ${asked[*]} --yes" \
                         "답할 터미널이 없습니다. 지우려면: ./sidenote llm rm ${asked[*]} --yes")"
    if ! ask_yes "$(L "Remove them?" "지울까요?")"; then
      echo "  $(L "Nothing removed." "아무것도 지우지 않았습니다.")"
      exit 1
    fi
  fi
  llm_remove "${gone[@]}" >/dev/null || die "$(L "Ollama did not remove them. ./sidenote llm list shows what is left." "Ollama가 지우지 못했습니다. 남은 모델은 ./sidenote llm list로 확인하세요.")"
  ok "$(L "Removed: ${gone[*]}" "지웠습니다: ${gone[*]}")"
  # The one set for solving or for a busy GPU (with "auto", the ones this PC's GPU picks) is downloaded again by llm pull
  local wanted=" $LOCAL_MODEL $BUSY_MODEL " picked
  if [ "$LOCAL_MODEL" = auto ] || [ "$BUSY_MODEL" = auto ]; then
    picked="$(models_to_pull 2>/dev/null | tr '\n' ' ')" || picked=""
    wanted="$wanted $picked "
  fi
  for base in ${bases[@]+"${bases[@]}"}; do
    case "$wanted" in
      *" $base "*|*" sidenote-$base "*)
        echo "  $(L "$base is the model set for solving here: ./sidenote llm pull downloads it again." \
                    "이 PC에서 풀이에 쓰도록 정한 모델입니다($base). ./sidenote llm pull로 다시 받습니다.")" ;;
    esac
  done
  [ ${#missing[@]} -eq 0 ] || exit 1
}

cmd_gpu() {   # give the GPU back while you need it yourself, and take it again
  running || die "$(L "The server is off. ./sidenote up" "서버가 꺼져 있습니다. ./sidenote up")"
  docker exec -e SIDENOTE_LANG="$UI_LANG" sidenote python -m server.control gpu "$1"
}

cmd_open() {
  health >/dev/null || die "$(L "The server is off. Run ./sidenote up first" "서버가 꺼져 있습니다. 먼저 ./sidenote up을 실행하세요")"
  local opened=1
  if [ "$ON_MAC" = 1 ]; then open "$URL" >/dev/null 2>&1 || opened=0
  elif [ "$ON_WSL" = 0 ]; then xdg-open "$URL" >/dev/null 2>&1 || opened=0
  else (cd "$WIN_CWD" && "$CMD_EXE" /c start "" "$URL" >/dev/null 2>&1) || opened=0; fi
  if [ "$opened" = 1 ]; then ok "$(L "Opened in the browser: $URL" "브라우저에서 열었습니다: $URL")"
  else warn "$(L "Could not open the browser. Open it yourself: $URL" "브라우저를 열지 못했습니다. 직접 여세요: $URL")"; fi
}

cmd_install() {   # everything a first run needs, in the order it needs it
  # One command instead of four in the right order. Every step is skipped when it is already done,
  # so running it again after a change is safe and says what it did rather than redoing it.
  # --with-models: pull the models too. Named apart from cmd_llm's own `models` list, which shellcheck
  # would otherwise take for this one.
  local with_models=0 need_model=0
  # an option it does not know is said, before anything is done: one mistyped was dropped without a word and the install ran without it
  local a
  for a in "$@"; do
    case "$a" in
      --with-models) with_models=1 ;;
      *) die "$(L "Unknown option: $a (./sidenote install [--with-models])" "알 수 없는 옵션입니다: $a (./sidenote install [--with-models])")" ;;
    esac
  done
  echo "$(L "${B}Installing Sidenote${N} ${D}(steps already done are skipped)${N}" "${B}Sidenote를 설치합니다${N} ${D}(이미 끝난 단계는 건너뜁니다)${N}")"
  echo
  echo "${B}1/4${N} $(L "Server" "서버")"
  if health >/dev/null; then ok "$(L "Already running" "이미 실행 중")"; else cmd_up; fi
  echo
  if [ "$ON_WSL" = 0 ]; then echo "${B}2/4${N} $(L "Capture packages" "캡처 패키지")"
  else echo "${B}2/4${N} $(L "Windows capture packages" "Windows 캡처 패키지")"; fi
  # Done only when the tray icon's pystray is there too: it joined client/requirements.txt after the
  # first setups, and a check of the five capture packages alone skipped this step on those for good. pip
  # installs what is missing and leaves what is there as it is.
  # A step that cannot be done is said and the others still run, so doctor at the end lists all that is left: without
  # Windows Python, cmd.exe's "'py' is not recognized" used to end the install here, with no word of python.org.
  local packages="" winpy=1 winp=""
  if [ "$ON_WSL" = 1 ]; then winp="$(win_problem)"; fi   # Windows out of reach: said instead of "no Python"
  if [ "$ON_WSL" = 1 ] && { [ -n "$winp" ] || ! win py -3 --version >/dev/null; }; then winpy=0; fi
  if [ "$ON_WSL" = 0 ]; then packages="$(here_packages)" || packages=""
  elif [ "$winpy" = 1 ]; then packages="$(win_packages 2>/dev/null)" || packages=""; fi
  if [ -n "$winp" ]; then   # its first clause: the whole of it, with what to do, is in the checks at the end
    bad "${winp%%:*} ${D}($(L "what to do: in the checks below" "할 일은 아래 점검에"))${N}"
  elif [ "$winpy" = 0 ]; then
    bad "$(L "No Python for Windows (py). Install it from python.org, then ./sidenote setup-capture" \
             "Windows용 Python(py) 없음: python.org에서 설치한 뒤 ./sidenote setup-capture")"
  elif [ "$packages" = tray ]; then
    ok "$(L "Already installed" "이미 설치됨")"
  else
    # in a subshell, so a setup that stops (die) ends this step and not the install
    ( cmd_setup_capture ) || bad "$(L "The capture packages did not install (see above)" "캡처 패키지 설치 실패 (위 메시지 참고)")"
  fi
  echo
  echo "${B}3/4${N} $(L "Local model" "이 PC의 모델")"
  if [ "$ANALYZER" != local ]; then
    ok "$(L "Agent only (SIDENOTE_ANALYZER=$ANALYZER): no model to download" "에이전트만 사용 (SIDENOTE_ANALYZER=$ANALYZER): 받을 모델 없음")"
  elif ! own_llm; then
    ok "$(L "Served by $LOCAL_URL (SIDENOTE_LOCAL_URL): no model to download here" "$LOCAL_URL 서버가 맡음 (SIDENOTE_LOCAL_URL): 여기서 받을 모델 없음")"
  elif [ "$with_models" = 1 ]; then
    cmd_llm pull
  elif [ -n "$(cmd_llm list 2>/dev/null | grep -E "gemma4|${LOCAL_MODEL%%:*}" || true)" ]; then
    ok "$(L "Already downloaded" "이미 받아 둠")"
  else
    # Tens of gigabytes: never started without being asked for, only pointed at. With no GPU that fits there is
    # nothing to point at, and the line llm pull would print says so; a GPU that could not be read is not that case.
    local want read=1
    want="$(models_to_pull)" || read=0
    want="${want%%$'\n'*}"
    if [ "$read" = 1 ] && [ -z "$want" ]; then
      no_fit warn
    else
      local which=""
      [ -z "$want" ] || which=" ${D}($(L "the model for this GPU: ${want}, a few GB to tens of GB" "이 GPU에 맞는 모델: ${want}, 수 GB에서 수십 GB"))${N}"
      need_model=1
      warn "$(L "Not downloaded yet: ${B}./sidenote llm pull${N}" "아직 받지 않음: ${B}./sidenote llm pull${N}")$which"
      if [ "$AGENT" = off ]; then echo "     $(L "Until then nothing solves: the agent is off (SIDENOTE_AGENT=off)." "받기 전까지는 풀 엔진 없음: 에이전트도 꺼 둠 (SIDENOTE_AGENT=off)")"
      else echo "     $(L "Until then a signed-in agent solves every problem." "받기 전까지는 로그인한 에이전트가 모든 문제를 풂")"; fi
    fi
  fi
  echo
  echo "${B}4/4${N} $(L "Desktop shortcut" "바탕화면 바로가기")"
  if [ "$ON_WSL" = 0 ]; then
    ok "$(L "Made on WSL only. Here ${B}./sidenote capture --up${N} starts the server and the capture together" \
            "WSL에서만 만듦. 여기서는 ${B}./sidenote capture --up${N}이 서버와 캡처를 함께 시작")"
  elif [ "$winpy" = 0 ]; then
    if [ -n "$winp" ]; then warn "$(L "Skipped: Windows cannot be reached from WSL (step 2)" "건너뜀: WSL에서 Windows를 쓸 수 없음 (2단계)")"
    else warn "$(L "Skipped: the shortcut runs Python for Windows (step 2)" "건너뜀: 바로가기는 Windows용 Python으로 실행 (2단계)")"; fi
  else
    ( cmd_shortcut ) || true   # a shortcut that cannot be made says why; doctor still runs
  fi
  echo
  ENGINE_SOFT=1
  local rc=0
  cmd_doctor || rc=$?
  install_next "$need_model"
  return "$rc"
}

# What is left after an install, in the README's order: the model, the agent's login where it has none (optional beside a
# local model), and the start. Whatever failed above is doctor's to say, with its status.
install_next() {
  local login=""
  case "$AGENT" in
    claude-code) [ -n "$(claude_login)" ] || login="./sidenote login" ;;
    codex) [ -n "$(codex_login)" ] || login="./sidenote login codex" ;;
    anthropic-api) [ -n "$(setting ANTHROPIC_API_KEY "")" ] || login="ANTHROPIC_API_KEY in .env" ;;
  esac
  echo
  echo "${B}$(L "Next" "다음 할 일")${N}"
  if [ "$1" = 1 ]; then echo "  ${B}./sidenote llm pull${N}        $(L "the local model for this GPU" "이 GPU에 맞는 모델 받기")"; fi
  if [ -n "$login" ]; then echo "  ${B}${login}${N}   $(L "the agent's login, for the hard problems" "어려운 문제를 맡길 에이전트 로그인")"; fi
  if [ "$ON_WSL" = 1 ] && [ -n "$(win_problem)" ]; then
    echo "  $(L "In a Windows terminal, once (the capture packages and the desktop shortcut):" "Windows 터미널에서 한 번 (캡처 패키지와 바탕화면 바로가기):")"
    echo "    ${B}$(win_setup_command)${N}"
    echo "  $(L "Then the desktop shortcut starts the server and the capture" "그다음 바탕화면 바로가기가 서버와 캡처를 함께 시작")"
  else
    echo "  ${B}./sidenote capture --up${N}    $(L "start the server and the capture" "서버와 캡처 시작")"
  fi
}

cmd_version() {   # what is actually installed and running, in one place
  # The question behind this is always the same: which of these were updated. Each line is read
  # from the thing itself, not from a file that says what it should be.
  # The labels are padded by hand: Korean letters take two columns in a terminal, which printf's
  # own width does not know, so %-14s would leave a ragged column.
  row() { printf '  %s%s %s\n' "$1" "$(printf '%*s' $(( 18 - $2 )) '')" "$2$3"; }
  say() { printf '  %s\n' "$1"; }
  # This code's version, from the one place that holds it, read as text (nothing is imported); left out if it is not there
  local version; version="$(sed -n 's/^VERSION = "\([^"]*\)".*$/\1/p' server/version.py 2>/dev/null | head -1)" || true
  echo "${B}Sidenote${version:+ $version}${N}"
  local commit; commit="$(git -C "$PWD" log -1 --format='%h %cd' --date=short 2>/dev/null || true)"
  # Each label as it prints, the padding included: English pads to 16 columns as the Korean does.
  printf '  %s%s\n' "$(L 'Source          ' '소스            ')" "${commit:-$(L "(not a git repository)" "(git 저장소 아님)")}"
  local img; img="$(docker image inspect sidenote:local --format '{{slice .Id 7 19}}  {{slice .Created 0 10}}' 2>/dev/null || true)"
  printf '  %s%s\n' "$(L 'Server image    ' '서버 이미지     ')" "${img:-$(L "not built yet" "아직 빌드하지 않음")}"
  printf '  %s%s\n' "$(L 'Panel build     ' '패널 빌드       ')" \
    "$(curl -fsS --max-time 3 "$URL/health" 2>/dev/null | json 'd.get("build") or "-"' 2>/dev/null || L "server off" "서버 꺼짐")"
  local cv; cv="$(claude_version)"   # empty when this PC has no Claude Code, shown as "-"
  printf "  Claude Code     %s $(L "(this PC) / %s (container)" "(이 PC) / %s (컨테이너)")\n" "${cv:--}" \
    "$(docker exec sidenote claude --version 2>/dev/null | awk '{print $1}' || echo '-')"
  local xv; xv="$(codex_version)"
  printf "  Codex           %s $(L "(this PC) / %s (container)" "(이 PC) / %s (컨테이너)")\n" "${xv:--}" \
    "$(docker exec sidenote codex --version 2>/dev/null | awk '{print $2}' || echo '-')"
  if own_llm; then
    printf '  %s%s\n' "$(L 'Model server    ' '모델 서버       ')" "ollama/ollama:$(setting SIDENOTE_OLLAMA_VERSION 0.40.5)"
  else
    printf '  %s%s\n' "$(L 'Model server    ' '모델 서버       ')" "$LOCAL_URL (SIDENOTE_LOCAL_URL)"
  fi
  printf '  %s%s\n' "$(L 'Search engine   ' '검색 엔진       ')" "searxng/searxng:$(setting SIDENOTE_SEARXNG_VERSION 2026.10.7-6671d89be)"
  # only from a model server that is up: asking with it down started a container, and could pull its image, for a version
  if ! own_llm; then
    :   # the models are that server's own
  elif docker ps --format '{{.Names}}' 2>/dev/null | grep -qx sidenote-llm; then
    printf '  %s%s\n' "$(L 'Models pulled   ' '받아 둔 모델    ')" \
      "$(cmd_llm list 2>/dev/null | tail -n +2 | awk '$1 ~ /^sidenote-/ {print $1}' | paste -sd" " - || echo '-')"
  else
    printf '  %s%s\n' "$(L 'Models pulled   ' '받아 둔 모델    ')" "$(L "- (the model server is off, ./sidenote llm list)" "- (모델 서버 꺼짐, ./sidenote llm list)")"
  fi
  printf '  %s%s\n' "$(L 'Log folder      ' '로그 폴더       ')" "$LOG_PATH"
}

# ---- the history and settings in the log folder: uninstall --data, backup, restore ----
# What Sidenote writes in the log folder ($LOG_PATH), by name: the history (with the two files SQLite keeps beside it),
# the panel's settings and the screen and sound switches (each with the temporary file it is saved through), what the
# server measured and noted (.pace, .speed, .spend, .account, .restart and their temporary files, stall.txt, the
# folder's write test, .ended), the copy of the history a backup has the server make (.backup.sqlite), and the live
# logs. Their rotated copies and the frames kept with SIDENOTE_DEBUG_FRAMES are found by their patterns
# (remove_own_files). Anything else in the folder is not Sidenote's, and stays.
SIDENOTE_FILES="history.sqlite history.sqlite-wal history.sqlite-shm .settings.json .settings.tmp .switches.json .switches.tmp
.pace.json .pace.tmp .speed.json .speed.tmp .spend.json .spend.tmp .account.json .restart.npz .restart.npz.tmp.npz stall.txt
.write-test .ended .backup.sqlite server.log events.jsonl capture.log"
# What a backup holds, and the only names a restore takes from one: the history (with its write-ahead log when it was
# copied as a file, with the server off), the settings, the switches, and the line that says what made the backup
BACKUP_NAMES="history.sqlite history.sqlite-wal .settings.json .switches.json sidenote-backup.txt"
# A backup's copy of the history made one file (cmd_backup): its -wal merged in (SQLite merges it as it opens the copy, and
# takes it away as it closes it), and Recently deleted taken out, the file rebuilt then; prints how many went (0 for a
# history with none, or from before answers could be deleted)
LEAVE_DELETED_OUT='import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
if "deleted" not in [r[1] for r in db.execute("PRAGMA table_info(answers)")]:
    db.execute("PRAGMA journal_mode=DELETE")
    db.close()
    print(0)
    sys.exit()
n = db.execute("SELECT COUNT(*) FROM answers WHERE deleted IS NOT NULL").fetchone()[0]
if n:
    db.execute("DELETE FROM answers WHERE deleted IS NOT NULL")
    db.commit()
    db.execute("PRAGMA wal_checkpoint(TRUNCATE)")
    db.execute("VACUUM")
db.execute("PRAGMA journal_mode=DELETE")
db.close()
print(n)'
# What a restore moves aside before the backup's files go in: the history with both files SQLite keeps beside it (a -wal
# or -shm of the old history left beside the new one would be read as part of it), the settings and the switches
RESTORE_ASIDE="history.sqlite history.sqlite-wal history.sqlite-shm .settings.json .switches.json"

# The size of a file or a folder as people read it, from du -sk, which GNU and BSD print alike (their -h does not)
size_of() {
  local kb; kb="$(du -sk "$1" 2>/dev/null | awk 'NR == 1 { print $1 }')" || true   # a file du may not read: the rest is counted
  awk -v k="${kb:-0}" 'BEGIN { if (k < 1024) printf "%d KB", k; else if (k < 1048576) printf "%.1f MB", k / 1024; else printf "%.1f GB", k / 1048576 }'
}

# A path typed on the command line, read from the folder it was typed in (this script works from its own, CALLER_PWD)
from_caller() { case "$1" in /*) printf '%s' "$1" ;; *) printf '%s/%s' "$CALLER_PWD" "$1" ;; esac; }

# Removes from folder $1 the names after it, each one by itself: a file, or a link (never what it points to). A folder
# under one of the names is left as it is.
remove_named() {
  local d="$1" n; shift
  for n in "$@"; do
    if [ -f "$d/$n" ] || [ -L "$d/$n" ]; then rm -f -- "$d/$n" 2>/dev/null || true; fi   # one that will not go stays, and is listed after
  done
}

# uninstall --data: what Sidenote wrote in the log folder goes, each file by its name (SIDENOTE_FILES), the rotated logs and
# the kept frames by their patterns, and the folders backup and restore make there by theirs, each emptied of the names
# it holds and then removed with rmdir. The log folder goes the same way, last: rmdir removes a folder only when it is
# empty, so the folder stays, with anything in it that is not Sidenote's. Nothing is removed with whatever it holds.
remove_own_files() {
  local d="$LOG_PATH" f sub
  [ -d "$d" ] || return 0
  # shellcheck disable=SC2086  # split on purpose: the names hold no spaces and no pattern characters
  remove_named "$d" $SIDENOTE_FILES
  for f in "$d"/server.log.[0-9]* "$d"/events.jsonl.[0-9]* "$d"/capture.log.[0-9]* "$d"/none_*.png; do
    if [ -f "$f" ] || [ -L "$f" ]; then rm -f -- "$f" 2>/dev/null || true; fi   # (a pattern that matched nothing is no file)
  done
  for sub in "$d"/before-restore-* "$d"/.restore.* "$d"/.backup.*; do
    if [ ! -d "$sub" ] || [ -L "$sub" ]; then continue; fi   # (.backup.sqlite is a file, and went above)
    # shellcheck disable=SC2086
    remove_named "$sub" $RESTORE_ASIDE $BACKUP_NAMES
    rmdir -- "$sub" 2>/dev/null || true
  done
  rmdir -- "$d" 2>/dev/null || true
}

# The command that takes the desktop shortcut and its icon away from Windows itself (client/launch.pyw --remove), for a
# WSL that cannot start Windows programs, worded as the setup command is (win_setup_command)
win_remove_command() {
  local launch; launch="$(wslpath -w "$PWD/client/launch.pyw" 2>/dev/null)" || launch="$PWD/client/launch.pyw"
  printf 'py -3 "%s" --remove' "$launch"
}

cmd_uninstall() {   # take back everything this project put on the PC
  # Listed first, removed only on --yes: volumes hold the models (tens of GB), and nothing here is worth losing to a
  # typed command. The history, the settings and the logs in the log folder stay unless --data says otherwise: installing
  # again goes on with them.
  local purge=0 data=0 a
  for a in "$@"; do
    case "$a" in
      --yes) purge=1 ;;
      --data) data=1 ;;
      *) die "$(L "Unknown option: $a (./sidenote uninstall [--yes] [--data])" "알 수 없는 옵션입니다: $a (./sidenote uninstall [--yes] [--data])")" ;;
    esac
  done
  local ollama search size="" datum again="./sidenote uninstall --yes"
  ollama="ollama/ollama:$(setting SIDENOTE_OLLAMA_VERSION 0.40.5)"
  search="searxng/searxng:$(setting SIDENOTE_SEARXNG_VERSION 2026.10.7-6671d89be)"
  if [ -d "$LOG_PATH" ]; then size=" ($(size_of "$LOG_PATH"))"; fi
  datum="$(L "History, settings and logs: " "기록, 설정, 로그: ")$LOG_PATH$size"
  if [ "$data" = 1 ]; then again="$again --data"; fi
  echo "${B}$(L "What Sidenote made on this PC" "Sidenote가 이 PC에 만든 것")${N}"
  echo "  $(L "Removed with --yes:" "--yes로 지우는 것:")"
  echo "    $(L "Containers: " "컨테이너: ")$(docker ps -a --filter name=sidenote --format '{{.Names}}' | paste -sd' ' - || true)"
  echo "    $(L "Images:     " "이미지:   ")sidenote:local, sidenote-runner:local, $ollama, $ollama-rocm, $search"
  echo "    $(L "Volumes:    " "볼륨:     ")$(docker volume ls --format '{{.Name}}' | grep '^sidenote_' | paste -sd' ' - || true)"
  echo "      ${D}$(L "(the models are in the volume sidenote_llm-models: tens of GB, downloaded again once removed)" "(모델은 볼륨 sidenote_llm-models 안에 있습니다: 수십 GB, 지우면 다시 받아야 합니다)")${N}"
  # the shortcut is made on WSL only, on the Windows desktop; the capture packages of a Linux desktop are in a venv here
  if [ "$ON_WSL" = 1 ]; then echo "    $(L "Shortcut:   Sidenote Capture.lnk on the Windows desktop, and its icon" "바로가기: Windows 바탕화면의 Sidenote Capture.lnk와 그 아이콘")"; fi
  if [ -d "$CAPTURE_VENV" ]; then echo "    $(L "Capture packages: " "캡처 패키지: ")$CAPTURE_VENV"; fi
  if [ "$data" = 1 ]; then echo "    $datum"; fi
  echo "  $(L "Kept:" "남기는 것:")"
  if [ "$data" != 1 ]; then
    echo "    $datum"
    echo "      ${D}$(L "(installing again goes on with them. A copy: ./sidenote backup. Removed too with --data)" "(다시 설치하면 이어서 씁니다. 사본은 ./sidenote backup, 함께 지우려면 --data)")${N}"
  fi
  # ~/.claude and ~/.codex are mounted into the server, but they are Claude Code's and Codex's own: their login and
  # settings on this PC, which those CLIs keep using after Sidenote is gone
  echo "    $(L "~/.claude and ~/.codex: the login folders Claude Code and Codex use on this PC too" "~/.claude, ~/.codex: 이 PC의 Claude Code와 Codex도 쓰는 로그인 폴더")"
  # the capture packages on Windows went into a Python this project does not own, beside whatever else uses their libraries
  if [ "$ON_WSL" = 1 ]; then echo "    $(L "The capture packages in Windows Python (client/requirements.txt lists them)" "Windows Python의 캡처 패키지 (목록은 client/requirements.txt)")"; fi
  if [ "$purge" != 1 ]; then
    echo
    warn "$(L "Nothing removed. To remove it: ${B}$again${N}" "아무것도 지우지 않았습니다. 지우려면 ${B}$again${N}")"
    return 0
  fi
  echo
  cmd_capture_stop quiet || true          # the capture program first: it is the only thing outside docker
  # The shortcut and its icon, on the Windows side: removed from here where WSL can start Windows programs, and named
  # with the command that removes them from Windows where it cannot (interop off, WSL 1, no Windows drive). cmd_shortcut
  # ends the script (die) where there is no WSL, which stopped the removal here on Linux: it is not asked there.
  local shortcut=none   # removed, failed, out-of-reach; none on a Linux desktop or a Mac
  if [ "$ON_WSL" = 1 ]; then
    if [ -n "$(win_problem)" ]; then shortcut=out-of-reach
    elif ( cmd_shortcut --remove >/dev/null 2>&1 ); then shortcut=removed
    else shortcut=failed; fi
  fi
  local rc=0
  docker compose --profile '*' down -v --remove-orphans 2>&1 | sed 's/^/  /' || rc=$?
  docker image rm -f sidenote:local sidenote-runner:local >/dev/null 2>&1 || true
  # Not forced, one at a time: these two are other people's images that another project on this PC may be running, which
  # Docker then refuses, and the one it refuses is no reason to stop or to leave the rest.
  local image
  for image in "$ollama" "$ollama-rocm" "$search"; do docker image rm "$image" >/dev/null 2>&1 || true; done
  local venv=0; if [ -d "$CAPTURE_VENV" ]; then rm -rf "$CAPTURE_VENV" && venv=1; fi
  if [ "$rc" = 0 ]; then
    local parts; parts="$(L "the containers, images and volumes" "컨테이너, 이미지, 볼륨")"
    if [ "$shortcut" = removed ]; then parts="$parts$(L ", the shortcut and its icon" ", 바로가기와 아이콘")"; fi
    if [ "$venv" = 1 ]; then parts="$parts$(L ", the capture packages" ", 캡처 패키지")"; fi
    ok "$(L "Removed $parts." "지웠습니다: $parts")"
  else
    warn "$(L "Could not remove the containers and volumes (Docker may be off). Start Docker and run this again." \
              "컨테이너와 볼륨을 지우지 못했습니다(Docker가 꺼져 있을 수 있습니다). Docker를 켠 뒤 다시 실행하세요.")"
  fi
  case "$shortcut" in
    failed) warn "$(L "The shortcut could not be reached: delete Sidenote Capture.lnk from the Windows desktop yourself." \
                      "바로가기에는 접근하지 못했습니다: Windows 바탕화면의 Sidenote Capture.lnk를 직접 지우세요.")" ;;
    out-of-reach)   # the command on a line of its own, nothing after it: copied whole
      echo "  $(L "WSL cannot start Windows programs here, so the desktop shortcut and its icon stay. In a Windows terminal this removes them:" \
                  "여기서는 WSL이 Windows 프로그램을 실행할 수 없어 바탕화면 바로가기와 아이콘이 남아 있습니다. Windows 터미널에서 이 명령으로 지웁니다:")"
      echo "      $(win_remove_command)" ;;
  esac
  if [ "$data" != 1 ]; then
    echo "  $(L "History, settings and logs kept: " "기록, 설정, 로그는 남겼습니다: ")$LOG_PATH$size"
    echo "  ${D}$(L "(installing again goes on with them. A copy: ./sidenote backup. To remove them too: ./sidenote uninstall --yes --data)" \
                    "(다시 설치하면 이어서 씁니다. 사본은 ./sidenote backup, 함께 지우려면 ./sidenote uninstall --yes --data)")${N}"
  elif running; then   # still up (Docker refused the down): its files are open, and it would write them again
    warn "$(L "The server is still running, so the history, settings and logs stay. ./sidenote down, then $again" \
              "서버가 아직 실행 중이라 기록, 설정, 로그는 남겼습니다. ./sidenote down 뒤에 $again")"
  elif [ ! -d "$LOG_PATH" ]; then
    ok "$(L "No history, settings or logs: $LOG_PATH is not there" "기록, 설정, 로그가 없습니다: $LOG_PATH 폴더가 없습니다")"
  else
    remove_own_files
    if [ ! -d "$LOG_PATH" ]; then
      ok "$(L "Removed the history, settings and logs, and their folder: $LOG_PATH" "기록, 설정, 로그와 그 폴더를 지웠습니다: $LOG_PATH")"
    else   # something in it is not Sidenote's, or would not go: named, and the folder left with it
      # (awk, not head: head ends early, and with pipefail the ls it cut off would fail the whole line)
      local left; left="$(ls -A "$LOG_PATH" 2>/dev/null | awk 'NR <= 6' | paste -sd' ' -)" || left=""
      ok "$(L "Removed the history, settings and logs in $LOG_PATH" "$LOG_PATH의 기록, 설정, 로그를 지웠습니다")"
      echo "  $(L "The folder stays, with what is still in it: $left" "폴더는 남았습니다. 그 안에 남은 것: $left")"
    fi
  fi
}

# ---- backup and restore ----
# The copy of the history the server's container makes while the server writes it: SQLite's own backup, which reads the
# database whole and consistent however it is being written, into the log folder (the container's /data/logs) for the
# archive. Made in the container, where the database is open: a copy of the file taken from outside could catch it
# halfway through a write.
SQLITE_BACKUP='import os, sqlite3
os.umask(0o077)
src, dst = "/data/logs/history.sqlite", "/data/logs/.backup.sqlite"
if os.path.exists(dst):
    os.remove(dst)
a = sqlite3.connect(src, timeout=30)
b = sqlite3.connect(dst)
a.backup(b)
b.close()
a.close()'

# ./sidenote backup [FILE]: the history and the settings in one file, to keep, or to take to another PC (restore puts them
# back). A tar.gz with plain names: history.sqlite, .settings.json and .switches.json (each when it is there) and
# sidenote-backup.txt (what made it, and when). It holds the answers and, with Keep what is heard, what people said: it
# is this user's alone (umask 077), and a file already there is never written over.
cmd_backup() {
  local usage; usage="$(L "Usage: ./sidenote backup [file]   (by default ./sidenote-backup-<date>-<time>.tar.gz, in this folder)" \
                          "사용법: ./sidenote backup [파일]   (기본은 이 폴더의 ./sidenote-backup-<날짜>-<시각>.tar.gz)")"
  [ $# -le 1 ] || die "$usage"
  case "${1:-}" in -*) die "$usage" ;; esac   # an option where the file's name goes: this command has none
  local file; file="$(from_caller "${1:-sidenote-backup-$(date +%Y%m%d-%H%M%S).tar.gz}")"
  if [ -e "$file" ] || [ -L "$file" ]; then
    die "$(L "$file is there already, and a backup writes over no file. Name another one." "$file 파일이 이미 있습니다. 백업은 있는 파일에 덮어쓰지 않으니 다른 이름을 적으세요.")"
  fi
  [ -d "$(dirname "$file")" ] || die "$(L "No such folder: $(dirname "$file")" "그런 폴더가 없습니다: $(dirname "$file")")"
  if [ ! -f "$LOG_PATH/history.sqlite" ] && [ ! -f "$LOG_PATH/.settings.json" ]; then
    die "$(L "Nothing to back up yet: no history and no settings in $LOG_PATH" "아직 백업할 것이 없습니다: $LOG_PATH에 기록도 설정도 없습니다")"
  fi
  umask 077   # everything made from here on, the archive too, is this user's alone
  # A link among the files is refused: the server's container can write the log folder, and a link it left there (to a
  # file of this PC's user) would have put that file in the backup. The copies below follow none either (cp -P)
  local n
  for n in history.sqlite history.sqlite-wal .settings.json .switches.json; do
    if [ -L "$LOG_PATH/$n" ]; then
      die "$(L "$LOG_PATH/$n is a link, not a file of Sidenote's: no backup is made. Remove it and back up again." \
               "$LOG_PATH/$n 항목이 링크라 Sidenote의 파일이 아닙니다: 백업하지 않았습니다. 지운 뒤 다시 백업하세요.")"
    fi
  done
  # The archive is put together in a folder inside the log folder: the server's copy of the history is made in the log
  # folder (the one the container sees), and moving it from there is a rename, not a second copy. Whatever happens, that
  # folder and the server's copy go again, and an archive begun and not finished with them (backup_cleanup).
  BACKUP_STAGE="$(mktemp -d "$LOG_PATH/.backup.XXXXXX")" || die "$(L "Could not make a folder in $LOG_PATH" "$LOG_PATH에 폴더를 만들지 못했습니다")"
  BACKUP_FILE=""
  trap backup_cleanup EXIT
  local held=() n out
  if [ -f "$LOG_PATH/history.sqlite" ]; then
    if running; then   # open in the server, and written now and then: the server's own copy (SQLITE_BACKUP)
      rm -f -- "$LOG_PATH/.backup.sqlite"   # one an earlier backup left when it was ended
      out="$(docker exec sidenote python -c "$SQLITE_BACKUP" 2>&1)" && [ -f "$LOG_PATH/.backup.sqlite" ] \
        || die "$(L "The server could not copy the history: $(tail -1 <<<"$out")" "서버가 기록을 복사하지 못했습니다: $(tail -1 <<<"$out")")"
      mv -- "$LOG_PATH/.backup.sqlite" "$BACKUP_STAGE/history.sqlite"
    else   # nothing has it open: the file as it is, and its write-ahead log, which holds the latest answers until merged in
      cp -P -- "$LOG_PATH/history.sqlite" "$BACKUP_STAGE/history.sqlite"
      if [ -f "$LOG_PATH/history.sqlite-wal" ]; then
        cp -P -- "$LOG_PATH/history.sqlite-wal" "$BACKUP_STAGE/history.sqlite-wal"
        held+=(history.sqlite-wal)
      fi
    fi
    held=(history.sqlite ${held[@]+"${held[@]}"})
  fi
  for n in .settings.json .switches.json; do
    if [ -f "$LOG_PATH/$n" ]; then cp -P -- "$LOG_PATH/$n" "$BACKUP_STAGE/$n"; held+=("$n"); fi
  done
  # The copy of the history made one file, and Recently deleted left out of it: deleting an answer was asked for, and a
  # backup taken to another PC or handed on carried it for its days. In the copy only: its -wal merged in, the deleted
  # answers gone and the file rebuilt (VACUUM), so nothing of them is left in its pages
  local left=0
  if [ -f "$BACKUP_STAGE/history.sqlite" ]; then
    left="$(python3 -c "$LEAVE_DELETED_OUT" "$BACKUP_STAGE/history.sqlite" 2>/dev/null)" \
      || die "$(L "Could not leave Recently deleted out of the backup" "백업에서 최근 삭제를 빼지 못했습니다")"
    case "$left" in ''|*[!0-9]*) die "$(L "Could not leave Recently deleted out of the backup" "백업에서 최근 삭제를 빼지 못했습니다")" ;; esac
    rm -f -- "$BACKUP_STAGE/history.sqlite-wal" "$BACKUP_STAGE/history.sqlite-shm"   # in the history now
    local keep=() h
    for h in ${held[@]+"${held[@]}"}; do [ "$h" = history.sqlite-wal ] || keep+=("$h"); done
    held=(${keep[@]+"${keep[@]}"})
  fi
  # what made it and when: this code's version, read as cmd_version reads it, and the time in UTC
  local version; version="$(sed -n 's/^VERSION = "\([^"]*\)".*$/\1/p' server/version.py 2>/dev/null | head -1)" || true
  printf 'sidenote %s %s\n' "${version:-unknown}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$BACKUP_STAGE/sidenote-backup.txt"
  held+=(sidenote-backup.txt)
  # The archive's file made with noclobber first, so one that appeared under the name meanwhile is not written over; from
  # then on the file is this backup's, removed again should the archive not be finished
  ( set -C; : > "$file" ) 2>/dev/null \
    || die "$(L "$file is there already, and a backup writes over no file. Name another one." "$file 파일이 이미 있습니다. 백업은 있는 파일에 덮어쓰지 않으니 다른 이름을 적으세요.")"
  BACKUP_FILE="$file"
  tar -czf - -C "$BACKUP_STAGE" ${held[@]+"${held[@]}"} > "$file" || die "$(L "Could not write $file" "$file 파일을 쓰지 못했습니다")"
  BACKUP_FILE=""   # finished: it stays
  ok "$(L "Backed up: $file ($(size_of "$file"))" "백업했습니다: $file ($(size_of "$file"))")"
  echo "  $(L "It holds: " "담은 것: ")${held[*]}"
  if [ "$left" -gt 0 ]; then
    echo "  ${D}$(L "Recently deleted is left out of it: $left" "최근 삭제는 넣지 않았습니다: ${left}개")${N}"
  fi
  echo "  ${D}$(L "(to put it back: ./sidenote restore $file)" "(되돌리려면: ./sidenote restore $file)")${N}"
}
backup_cleanup() {   # backup's temporary files, by name, whatever ended it
  rm -f -- "$LOG_PATH/.backup.sqlite" 2>/dev/null || true   # the server's copy: never left in the folder
  if [ -n "${BACKUP_STAGE:-}" ] && [ -d "$BACKUP_STAGE" ]; then
    # shellcheck disable=SC2086
    remove_named "$BACKUP_STAGE" $BACKUP_NAMES
    rmdir -- "$BACKUP_STAGE" 2>/dev/null || true
  fi
  if [ -n "${BACKUP_FILE:-}" ]; then rm -f -- "$BACKUP_FILE" 2>/dev/null || true; fi   # begun here and not finished
}

# Why a file is no Sidenote backup, or nothing when it is one. tar reads it; every entry is a plain file under one of the
# names a backup has (no folder, no link, no path: nothing a restore could write outside its own folder, nor through a
# link), none twice; sidenote-backup.txt is among them, and the history or the settings.
backup_problem() {
  local list types n m known
  list="$(tar -tzf "$1" 2>/dev/null)" || { L "tar cannot read it" "tar로 읽을 수 없음"; return 0; }
  [ -n "$list" ] || { L "it is empty" "비어 있음"; return 0; }
  while IFS= read -r n; do
    known=0
    for m in $BACKUP_NAMES; do if [ "$n" = "$m" ]; then known=1; fi; done   # the whole name, nothing about it in part
    if [ "$known" = 0 ]; then L "it holds a name a backup does not have: $n" "백업에 없는 이름이 들어 있음: $n"; return 0; fi
  done <<<"$list"
  if [ -n "$(sort <<<"$list" | uniq -d)" ]; then L "it holds a name twice" "같은 이름이 두 번 들어 있음"; return 0; fi
  if ! grep -qx 'sidenote-backup.txt' <<<"$list"; then L "it has no sidenote-backup.txt" "sidenote-backup.txt가 없음"; return 0; fi
  if ! grep -qx -e 'history.sqlite' -e '.settings.json' <<<"$list"; then L "it holds neither a history nor settings" "기록도 설정도 없음"; return 0; fi
  # the kind of each entry, the first letter of its mode as tar lists it (GNU and BSD alike): "-" for a plain file alone
  types="$(tar -tvzf "$1" 2>/dev/null | cut -c1 | sort -u | tr -d '\n')" || types=""
  if [ "$types" != "-" ]; then L "it holds a link or a folder" "링크나 폴더가 들어 있음"; return 0; fi
  return 0
}

# Waits for the server to answer after a start, as up does: up to four minutes, a dot a second. Fails when the
# container stops or the time runs out.
wait_health() {
  local t0=$SECONDS dots=0
  until health >/dev/null; do
    if ! running || (( SECONDS - t0 > 240 )); then
      if [ "$dots" = 1 ]; then echo; fi
      return 1
    fi
    printf '.'; dots=1; sleep 1
  done
  if [ "$dots" = 1 ]; then echo; fi
  return 0
}

# ./sidenote restore FILE [--yes]: a backup's history and settings put in place of the ones there. Those are kept, moved
# into before-restore-<date>-<time> in the log folder (each kept until uninstall --data), and a running server is stopped for
# the swap and started again after it, so no file changes under it. A server that was off stays off.
cmd_restore() {
  local usage file="" yes=0 a
  usage="$(L "Usage: ./sidenote restore file [--yes]" "사용법: ./sidenote restore 파일 [--yes]")"
  for a in "$@"; do
    case "$a" in
      --yes) yes=1 ;;
      -*) die "$usage" ;;
      *) if [ -n "$file" ]; then die "$usage"; fi; file="$a" ;;
    esac
  done
  [ -n "$file" ] || die "$usage"
  file="$(from_caller "$file")"
  [ -f "$file" ] || die "$(L "No such file: $file" "그런 파일이 없습니다: $file")"
  local why; why="$(backup_problem "$file")"
  [ -z "$why" ] || die "$(L "Not a Sidenote backup ($why): $file. Nothing changed." "Sidenote 백업이 아닙니다($why): $file. 바꾼 것은 없습니다.")"
  # "sidenote <version> <time>", as backup wrote it; printed to the terminal, so no control character of a file from elsewhere
  local made; made="$(tar -xzOf "$file" sidenote-backup.txt 2>/dev/null | head -1 | LC_ALL=C tr -d '\000-\010\013-\037\177' | cut -c1-120)" || made=""
  echo "${B}$(L "Restoring" "복원합니다")${N}: $file ${D}(${made:-sidenote-backup.txt})${N}"
  echo "  $(L "It replaces the history and settings in $LOG_PATH. What is there now is kept, in a before-restore folder beside them." \
              "$LOG_PATH의 기록과 설정을 백업의 것으로 바꿉니다. 지금 있는 것은 그 옆 before-restore 폴더에 남깁니다.")"
  if [ "$yes" != 1 ]; then
    # no terminal to answer at: the line that restores without the question
    [ -t 0 ] || die "$(L "Asked with no terminal to answer at. To restore it: ./sidenote restore $file --yes" \
                         "답할 터미널이 없습니다. 복원하려면: ./sidenote restore $file --yes")"
    if ! ask_yes "$(L "Restore it?" "복원할까요?")"; then
      echo "  $(L "Nothing changed." "바꾼 것은 없습니다.")"
      exit 1
    fi
  fi
  [ -d "$LOG_PATH" ] || mkdir -p -m 700 "$LOG_PATH"   # a PC where the server never ran has none yet
  umask 077
  # Out of the archive first, into a folder inside the log folder, before anything there changes: on the same file system,
  # so each file then goes into place with a rename. The folder goes again whatever happens, and a server stopped here is
  # started again (restore_cleanup).
  RESTORE_TMP="$(mktemp -d "$LOG_PATH/.restore.XXXXXX")" || die "$(L "Could not make a folder in $LOG_PATH. Nothing changed." "$LOG_PATH에 폴더를 만들지 못했습니다. 바꾼 것은 없습니다.")"
  RESTORE_STOPPED=0
  trap restore_cleanup EXIT
  tar --no-same-owner -xzf "$file" -C "$RESTORE_TMP" 2>/dev/null \
    || die "$(L "Could not unpack $file. Nothing changed." "$file 파일을 풀지 못했습니다. 바꾼 것은 없습니다.")"
  # What came out is what was listed, each a plain file (backup_problem read the list; this reads the files)
  local n count=0
  for n in $BACKUP_NAMES; do
    if [ -L "$RESTORE_TMP/$n" ] || { [ -e "$RESTORE_TMP/$n" ] && [ ! -f "$RESTORE_TMP/$n" ]; }; then
      die "$(L "Not a Sidenote backup ($n is not a plain file): $file. Nothing changed." "Sidenote 백업이 아닙니다($n 항목이 일반 파일이 아님): $file. 바꾼 것은 없습니다.")"
    fi
    if [ -f "$RESTORE_TMP/$n" ]; then count=$((count + 1)); fi
  done
  if [ "$(ls -A "$RESTORE_TMP" | wc -l | tr -d ' ')" != "$count" ]; then
    die "$(L "Not a Sidenote backup (more came out of it than it lists): $file. Nothing changed." "Sidenote 백업이 아닙니다(목록에 없는 것이 나옴): $file. 바꾼 것은 없습니다.")"
  fi
  local was_up=0 out
  if running; then
    was_up=1
    echo "  $(L "Stopping the server for the swap" "바꾸는 동안 서버를 멈춥니다")"
    out="$(docker compose stop server 2>&1)" \
      || die "$(L "Could not stop the server: $(tail -1 <<<"$out"). Nothing changed." "서버를 멈추지 못했습니다: $(tail -1 <<<"$out"). 바꾼 것은 없습니다.")"
    RESTORE_STOPPED=1
  fi
  # The files that came out, checked again now that the server is stopped: they lay in the log folder, which its container
  # can write, between the first look and the stop, and a link put in their place would have been moved in and made 600
  for n in $BACKUP_NAMES; do
    if [ -L "$RESTORE_TMP/$n" ] || { [ -e "$RESTORE_TMP/$n" ] && [ ! -f "$RESTORE_TMP/$n" ]; }; then
      die "$(L "Not a Sidenote backup ($n is not a plain file): $file. Nothing changed." "Sidenote 백업이 아닙니다($n 항목이 일반 파일이 아님): $file. 바꾼 것은 없습니다.")"
    fi
  done
  # Named for the time; a second restore within the same second gets -2, -3 after it
  local stamp before i=1; stamp="$LOG_PATH/before-restore-$(date +%Y%m%d-%H%M%S)"; before="$stamp"
  until mkdir -m 700 -- "$before" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -le 9 ] || die "$(L "Could not make $before. Nothing changed." "$before 폴더를 만들지 못했습니다. 바꾼 것은 없습니다.")"
    before="$stamp-$i"
  done
  # What is there now goes aside, then the backup's files go in. A step that fails undoes the ones before it: what was
  # moved in is removed (the archive still has it), what was moved aside is moved back.
  local moved=() placed=() failed="" err=""
  for n in $RESTORE_ASIDE; do
    if [ -e "$LOG_PATH/$n" ] || [ -L "$LOG_PATH/$n" ]; then
      if ! err="$(mv -- "$LOG_PATH/$n" "$before/$n" 2>&1)"; then failed="$n"; break; fi
      moved+=("$n")
    fi
  done
  if [ -z "$failed" ]; then
    for n in $BACKUP_NAMES; do                       # the backup's files, by the one list of them
      if [ "$n" = sidenote-backup.txt ] || [ ! -f "$RESTORE_TMP/$n" ]; then continue; fi
      if ! err="$(mv -- "$RESTORE_TMP/$n" "$LOG_PATH/$n" 2>&1)"; then failed="$n"; break; fi
      placed+=("$n")
      if ! err="$(chmod 600 "$LOG_PATH/$n" 2>&1)"; then failed="$n"; break; fi   # the history is this user's alone
    done
  fi
  if [ -n "$failed" ]; then
    local back=1
    for n in ${placed[@]+"${placed[@]}"}; do rm -f -- "$LOG_PATH/$n" || back=0; done
    for n in ${moved[@]+"${moved[@]}"}; do mv -- "$before/$n" "$LOG_PATH/$n" || back=0; done
    if [ "$back" = 1 ]; then
      rmdir -- "$before" 2>/dev/null || true
      die "$(L "Could not put $failed in place ($(tail -1 <<<"$err")). What was there is back in place: nothing changed." \
               "$failed 파일을 제자리에 두지 못했습니다($(tail -1 <<<"$err")). 있던 것을 제자리로 돌려 두었습니다: 바꾼 것은 없습니다.")"
    fi
    die "$(L "Could not put $failed in place ($(tail -1 <<<"$err")), nor all that was there back: it is in $before" \
             "$failed 파일을 제자리에 두지 못했고($(tail -1 <<<"$err")), 있던 것도 다 돌려 두지 못했습니다: $before 폴더에 있습니다")"
  fi
  # The problems the server remembered across its restarts, by the ids of the answers that were there: not these
  rm -f -- "$LOG_PATH/.restart.npz" "$LOG_PATH/.restart.npz.tmp.npz"
  # The folder of what was there: none when nothing was. Each one stays, until ./sidenote uninstall --data takes them:
  # one taken by the next restore was a history with no other copy (the right backup after a wrong one, say)
  local kept=1
  if [ -z "$(ls -A "$before")" ]; then kept=0; rmdir -- "$before"; fi
  local started=0
  if [ "$was_up" = 1 ]; then
    RESTORE_STOPPED=0   # started here, and not again by restore_cleanup
    echo "  $(L "Starting the server again" "서버를 다시 시작합니다")"
    if docker compose start server >/dev/null 2>&1 && wait_health; then started=1; fi
  fi
  ok "$(L "Restored from $file: " "복원했습니다: $file, ")${placed[*]:-}"
  if [ "$kept" = 1 ]; then echo "  $(L "What was there before: " "전에 있던 것: ")$before"
  else echo "  $(L "Nothing was there before." "전에 있던 것은 없었습니다.")"; fi
  if [ "$was_up" = 0 ]; then echo "  $(L "The server is off. ./sidenote up starts it with these." "서버는 꺼져 있습니다. ./sidenote up으로 켜면 이것으로 시작합니다.")"
  elif [ "$started" = 1 ]; then echo "  $(L "The server was started again." "서버를 다시 시작했습니다.")"
  else warn "$(L "The server did not start again. ./sidenote up starts it, and says why if it cannot." "서버가 다시 시작되지 않았습니다. ./sidenote up으로 시작하면 안 될 때 그 이유를 보여 줍니다.")"; fi
}
restore_cleanup() {   # restore's temporary folder, by the names it may hold, and the server it stopped, whatever ended it
  if [ -n "${RESTORE_TMP:-}" ] && [ -d "$RESTORE_TMP" ]; then
    # shellcheck disable=SC2086
    remove_named "$RESTORE_TMP" $BACKUP_NAMES
    rmdir -- "$RESTORE_TMP" 2>/dev/null || true
  fi
  if [ "${RESTORE_STOPPED:-0}" = 1 ]; then   # stopped for the swap and not started again yet: started now
    RESTORE_STOPPED=0
    docker compose start server >/dev/null 2>&1 || true
  fi
}

cmd_shortcut() {   # a Desktop shortcut that starts the capture program, so it takes one click
  local distro="$DISTRO"
  # a Windows shortcut, which runs this checkout through wsl.exe: there is none to make on a Linux desktop
  [ -n "$distro" ] || die "$(L "The desktop shortcut is a Windows one, made from WSL. Here ./sidenote capture --up starts the server and the capture." \
                               "바탕화면 바로가기는 WSL에서 만드는 Windows용입니다. 여기서는 ./sidenote capture --up이 서버와 캡처를 함께 시작합니다.")"
  need_win   # before PowerShell is asked anything, --remove too: without Windows it ended with no word
  local name="Sidenote Capture.lnk"
  local old_names=("Sidenote 캡처.lnk")   # names this command used before
  # || "": a PowerShell that fails ended the script here (pipefail) before the line below could say what was wrong
  local desktop; desktop="$(winps "[Environment]::GetFolderPath('Desktop')" | tr -d '\r' | head -1)" || desktop=""
  [ -n "$desktop" ] || die "$(L "Could not find the Windows desktop folder." "Windows 바탕화면 경로를 찾지 못했습니다.")"
  desktop="$(ps_quote "$desktop")"   # a path can hold a quote; PowerShell wants it doubled
  local lnk="$desktop\\$name"
  if [ "${1:-}" = "--remove" ]; then
    local gone=0 f
    for f in "$name" ${old_names[@]+"${old_names[@]}"}; do
      if [ -n "$(winps "if (Test-Path -LiteralPath '$desktop\\$f') { 'y' }")" ]; then
        winps "Remove-Item -LiteralPath '$desktop\\$f' -ErrorAction SilentlyContinue" >/dev/null || true
        ok "$(L "Shortcut removed: $f" "바로가기를 지웠습니다: $f")"
        gone=$((gone + 1))
      fi
    done
    [ "$gone" = 0 ] && echo "  $(L "No shortcut on the desktop to remove." "바탕화면에 지울 바로가기가 없습니다.")"
    # and the icon it wore, with its folder when that holds nothing else (the app keeps its data in the same folder)
    winps "\$d = Join-Path \$env:LOCALAPPDATA 'Sidenote';
           Remove-Item -LiteralPath (Join-Path \$d 'sidenote.ico') -ErrorAction SilentlyContinue;
           if ((Test-Path -LiteralPath \$d) -and -not (Get-ChildItem -LiteralPath \$d -Force)) { Remove-Item -LiteralPath \$d -ErrorAction SilentlyContinue }" >/dev/null || true
    return 0
  fi
  # Nothing this shortcut starts has a window: pyw.exe, the Python launcher that opens no console, runs
  # client/launch.pyw, and that runs `./sidenote capture --up` here through wsl.exe without a console window
  # either (the top of launch.pyw says how). The shortcut used to start wsl.exe itself, and wsl.exe opens a
  # console window for the launcher: it came up on every start, though a start needs no terminal, and it was
  # where a failure was shown. launch.pyw shows a failure in a message box instead, with
  # the last lines the launcher printed, and says so when a second click comes while a start is still going.
  # --up starts the server first when it is not running: after a reboot nothing is.
  # pyw.exe by its full path: the shortcut runs with Explorer's PATH, which need not be the one seen here.
  local pyw; pyw="$(winps "(Get-Command pyw.exe -ErrorAction SilentlyContinue).Source" | head -1)"
  # Without it the shortcut would have nothing to run, and a double click would do nothing at all.
  [ -n "$pyw" ] || die "$(L "No Python launcher (pyw.exe) on Windows, so no shortcut can be made. Install Python for Windows from python.org, then ./sidenote setup-capture and ./sidenote shortcut" \
                             "Windows에 Python 런처(pyw.exe)가 없어 바로가기를 만들 수 없습니다. python.org에서 Windows용 Python을 설치한 뒤 ./sidenote setup-capture와 ./sidenote shortcut을 실행하세요")"
  local launch; launch="$(wslpath -w "$PWD/client/launch.pyw")"   # this checkout's copy, read from WSL's share
  # The two paths in double quotes for the Windows command line, so one with spaces stays one argument; the
  # distribution name has none (WSL allows letters, digits, '.', '_' and '-'). capture.py's path must not be in
  # here: capture and capture-stop find the capture program by it. The single quotes of PowerShell's own strings
  # below are doubled inside them (ps_quote).
  # --port: the start's window asks the server on the port it runs on (SIDENOTE_PORT), or it waited on 8777 for a server elsewhere
  local args="-3 \"$launch\" --distro $distro --repo \"$PWD\" --port $PORT"
  # Sidenote's icon, the tray's S (client/sidenote.ico), copied to a Windows folder: Explorer reads a shortcut's icon from
  # its file whenever it draws it, and a file inside WSL would wake the distribution for that, or draw blank where it
  # cannot. Should the copy fail, the checkout's own file still serves while WSL runs.
  local ico_src; ico_src="$(wslpath -w "$PWD/client/sidenote.ico")"
  local ico; ico="$(winps "\$d = Join-Path \$env:LOCALAPPDATA 'Sidenote';
         New-Item -ItemType Directory -Force -Path \$d | Out-Null;
         Copy-Item -LiteralPath '$(ps_quote "$ico_src")' -Destination \$d -Force;
         \$f = Join-Path \$d 'sidenote.ico';
         if (Test-Path -LiteralPath \$f) { \$f }" | head -1)"
  [ -n "$ico" ] || ico="$ico_src"
  winps "\$s = (New-Object -ComObject WScript.Shell).CreateShortcut('$lnk');
         \$s.TargetPath = '$(ps_quote "$pyw")';
         \$s.Arguments = '$(ps_quote "$args")';
         \$s.Description = '$(L "Sidenote: start screen and sound capture (quit from the tray icon)" "Sidenote: 화면과 소리 캡처 시작 (끄기는 트레이 아이콘에서)")';
         \$s.IconLocation = '$(ps_quote "$ico"),0';
         \$s.Save()" >/dev/null
  if [ -n "$(winps "if (Test-Path -LiteralPath '$lnk') { 'y' }")" ]; then
    ok "$(L "Desktop shortcut made: $name" "바탕화면에 바로가기를 만들었습니다: $name")"
    local f
    for f in ${old_names[@]+"${old_names[@]}"}; do   # one left over from when this command used another name
      if [ -n "$(winps "if (Test-Path -LiteralPath '$desktop\\$f') { 'y' }")" ]; then
        winps "Remove-Item -LiteralPath '$desktop\\$f' -ErrorAction SilentlyContinue" >/dev/null || true
        ok "$(L "Removed the shortcut under its old name: $f" "옛 이름의 바로가기를 지웠습니다: $f")"
      fi
    done
    echo "  $(L "A double click starts the server and the capture with no window, and a tray icon appears in the notification area." \
                "두 번 클릭하면 창 없이 서버와 캡처가 함께 시작되고, 알림 영역에 트레이 아이콘이 나타납니다.")"
    echo "  ${D}$(L "(the first time and after an update, building the server image takes a few minutes. A start that fails says why in a message box)" \
                    "(처음과 업데이트 뒤에는 서버 이미지 빌드에 몇 분 걸립니다. 시작하지 못하면 그 이유를 메시지 상자로 알려 줍니다)")${N}"
    echo "  $(L "Quit from the tray icon. To remove the shortcut: ./sidenote shortcut --remove" "끝내기는 트레이 아이콘에서. 바로가기 삭제: ./sidenote shortcut --remove")"
  else
    die "$(L "Could not make the shortcut." "바로가기를 만들지 못했습니다.")"
  fi
}

# ./sidenote setup-capture (setup-windows is its older name): the capture program's packages, into Windows Python on WSL
# (pip --user) and into the virtual environment .venv-capture on a Linux desktop
cmd_setup_capture() {
  if [ "$ON_WSL" = 0 ]; then setup_capture_here; return; fi
  # Asked first, as capture does: without it cmd.exe's own "'py' is not recognized" was all that was said
  need_win
  win py -3 --version >/dev/null || die "$(L "No Python (py) on Windows. Install it from python.org, then ./sidenote setup-capture" \
                                              "Windows에 Python(py)이 없습니다. python.org에서 설치한 뒤 ./sidenote setup-capture를 실행하세요")"
  local req; req="$(wslpath -w "$PWD/client/requirements.txt")"
  echo "${B}$(L "Installing the capture packages into Windows Python" "Windows Python에 캡처 패키지를 설치합니다")${N} ($req)"
  local source=()
  if [ -n "$(setting SIDENOTE_WHEELS "")" ]; then source=(--no-index --find-links "$(wslpath -w "$(setting SIDENOTE_WHEELS "")")"); fi   # no internet here: docs/air-gapped.md
  (cd "$WIN_CWD" && "$CMD_EXE" /c py -3 -m pip install --user ${source[@]+"${source[@]}"} -r "$req" 2>&1 | tr -d '\r' | tail -3)
}

cmd_doctor() {
  echo "${B}$(L "Checks" "점검")${N}"
  local v
  FAILS=0
  if ! command -v docker >/dev/null; then bad "$(L "docker not installed" "docker 설치 안 됨")"
  elif v="$(docker version --format '{{.Server.Version}}' 2>/dev/null)" && [ -n "$v" ]; then
    ok "docker $v"
    # Compose beside it: the plugin is a package of its own, and compose.yaml needs 2.24 (compose_why says what to install)
    local cwhy
    if cwhy="$(compose_why)"; then
      v="$(docker compose version --short 2>/dev/null || true)"
      ok "docker compose ${v#v}"
    else bad "$cwhy"; fi
  else local why; why="$(docker_why)" || true; bad "${why:-$(L "Cannot connect to Docker" "Docker에 연결할 수 없음")}"; fi
  docker image inspect sidenote:local >/dev/null 2>&1 && ok "$(L "Image sidenote:local" "이미지 sidenote:local")" \
    || warn "$(L "No image (./sidenote up builds it)" "이미지 없음 (./sidenote up이 빌드)")"
  local how usable=1
  if [ "$ANALYZER" = local ]; then
    ok "$(L "Solving: the local model ($LOCAL_MODEL) and the agent ($AGENT)" "풀이: 이 PC의 모델($LOCAL_MODEL)과 에이전트($AGENT)")"
    local gpu; gpu="$(python3 - <<'PY' 2>/dev/null
import sys
sys.path.insert(0, "server")
import hardware
gpu = hardware.best([g for g in hardware.detect() if g.vendor != "apple"])   # none a container can use on a Mac
print(f"{gpu.name}, {gpu.memory_gb:.0f} GB ({gpu.vendor})" if gpu else "")
PY
)"
    # what auto would pull (nothing when no GPU has room for the smallest model, ? when the GPU could not be read), and
    # whether the server's local model answers all the same: one set by name, or one pulled anyway for the CPU
    local file="${COMPOSE_FILE#compose.yaml:}" fit answers=0
    fit="$(models_to_pull 2>/dev/null || echo "?")"
    [ "$(health | json '((d.get("engines") or {}).get("local") or {}).get("ok", False)' 2>/dev/null)" = True ] && answers=1
    if [ -n "$gpu" ]; then ok "GPU: $gpu ${D}($file)${N}"
    elif [ "$LOCAL_MODEL" != auto ] || [ "$answers" = 1 ]; then
      warn "$(L "GPU: no NVIDIA or AMD GPU found, so the local model runs on the CPU, slowly" "GPU: NVIDIA나 AMD GPU 없음, 이 PC의 모델은 CPU에서 느리게 실행") ${D}($file)${N}"
    else warn "$(L "GPU: no NVIDIA or AMD GPU found" "GPU: NVIDIA나 AMD GPU 없음") ${D}($file)${N}"; fi
    # auto, nothing fits and no model answers anyway: the no-GPU line, as llm pull says it
    if [ "$LOCAL_MODEL" = auto ] && [ -z "$fit" ] && [ "$answers" = 0 ]; then usable=0; no_fit warn; fi
  fi
  # With the local LLM, the agent is the second engine: without a login the local model solves everything. With no
  # local model to fall back on, a missing login leaves nothing to solve.
  local nologin=bad; [ "$ANALYZER" = local ] && [ "$usable" = 1 ] && nologin=warn
  [ "$ENGINE_SOFT" = 1 ] && nologin=warn
  case "$AGENT" in
    codex)
      how="$(codex_login)"
      if [ -n "$how" ]; then ok "Codex $(codex_version): $(L "signed in ($how), and the server uses this login" "로그인됨 ($how), 서버도 이 로그인 사용")"
      else "$nologin" "$(L "Codex not signed in (./sidenote login codex)" "Codex 로그인 안 됨 (./sidenote login codex)")"; fi ;;
    claude-code)
      how="$(claude_login)"
      if [ "$ON_MAC" = 1 ] && [ -n "$how" ]; then   # the token in .env: the server needs no Claude Code of the Mac's own
        if running && ! token_served; then "$nologin" "$(L "Claude Code: the server started before the token in .env (./sidenote login)" "Claude Code: 서버가 .env의 토큰보다 먼저 시작됨 (./sidenote login)")"
        else ok "Claude Code$(v="$(claude_version)"; [ -z "$v" ] || printf ' %s' "$v"): $(L "signed in ($how), and the server uses this login" "로그인됨 ($how), 서버도 이 로그인 사용")"; fi
      elif ! command -v claude >/dev/null; then "$nologin" "$(L "Claude Code (claude) not installed on this PC (install it first)" "Claude Code(claude) 설치 안 됨 (먼저 설치)")"
      elif [ -n "$how" ]; then ok "Claude Code $(claude_version): $(L "signed in ($how), and the server uses this login" "로그인됨 ($how), 서버도 이 로그인 사용")"
      else "$nologin" "$(L "Claude Code not signed in (./sidenote login)" "Claude Code 로그인 안 됨 (./sidenote login)")"; fi ;;
    anthropic-api)
      if [ -n "$(setting ANTHROPIC_API_KEY "")" ]; then ok "$(L "Anthropic API: key set (.env)" "Anthropic API: 키 있음 (.env)")"
      else "$nologin" "$(L "Anthropic API: no ANTHROPIC_API_KEY in .env" "Anthropic API: .env에 ANTHROPIC_API_KEY 없음")"; fi ;;
    off) warn "$(L "Agent: off (SIDENOTE_AGENT=off), the local model solves alone" "에이전트: 꺼 둠 (SIDENOTE_AGENT=off), 이 PC의 모델만 풂")" ;;
  esac
  if [ "$ON_WSL" = 0 ]; then
    local here; here="$(here_packages)" || here=""
    case "$here" in
      tray|notray) ok "$(L "Capture packages installed" "캡처 패키지 설치됨") ${D}($CAPTURE_VENV)${N}" ;;
      *) bad "$(L "Capture packages missing (./sidenote setup-capture)" "캡처 패키지 없음 (./sidenote setup-capture)")" ;;
    esac
    [ "$ON_MAC" = 1 ] || [ -n "${DISPLAY:-}" ] || warn "$(L "No X11 display in this shell (DISPLAY): start the capture from the desktop session" "이 셸에 X11 화면 없음 (DISPLAY): 캡처는 데스크톱 세션에서 시작")"
  elif [ -n "$(win_problem)" ]; then
    # set up from Windows (launch.pyw --setup): a capture program connected now, or one that connected before (its log)
    if [ "$(clients)" -gt 0 ] 2>/dev/null || grep -qs '\[conn\] connected' "$LOG_PATH/capture.log"; then
      ok "$(L "Capture: set up from Windows ${D}(WSL cannot start Windows programs here: the desktop shortcut starts it)${N}" \
              "캡처: Windows 쪽에서 설정함 ${D}(여기서는 WSL이 Windows 프로그램을 실행할 수 없어 바탕화면 바로가기로 시작)${N}")"
    else bad "$(win_problem)"; fi
  elif win py -3 --version >/dev/null; then
    ok "Windows Python: $(win py -3 --version | tail -1)"
    local packages; packages="$(win_packages)" || packages=""   # "tray", "notray", or nothing when one is missing
    case "$packages" in
      tray) ok "$(L "Capture packages installed" "캡처 패키지 설치됨")" ;;
      # The program runs without pystray, only with no icon: windowless it then has neither a window nor an icon.
      notray) ok "$(L "Capture packages installed" "캡처 패키지 설치됨")"
              warn "$(L "No tray icon package (pystray): it runs without an icon (./sidenote setup-capture)" "트레이 아이콘 패키지(pystray) 없음: 아이콘 없이 실행됨 (./sidenote setup-capture)")" ;;
      *) bad "$(L "Capture packages missing (./sidenote setup-capture)" "캡처 패키지 없음 (./sidenote setup-capture)")" ;;
    esac
  else
    bad "$(L "No Windows Python (py) (install Python for Windows from python.org, then ./sidenote setup-capture)" \
             "Windows Python(py) 없음 (python.org에서 Windows용 Python 설치 뒤 ./sidenote setup-capture)")"
  fi
  if [ -d "$LOG_PATH" ]; then
    local used days unit=days; used="$(du -sh "$LOG_PATH" 2>/dev/null | cut -f1)"
    # The days as the server reads them (server/config.py env_float, server/telemetry.py KEEP_DAYS): whatever Python
    # reads as a number (+30, 1e2, 7., .5), the default for what it does not and for inf and nan, and at least a day.
    # A pattern of its own here called those four 14 days while the server kept 30, 100, 7 and 1.
    days="$(python3 - "$(setting SIDENOTE_LOG_DAYS "")" <<'DAYS' 2>/dev/null || echo 14
import math, sys
raw = sys.argv[1].strip()
try:
    days = float(raw) if raw else 14.0
except ValueError:
    days = 14.0
if not math.isfinite(days):
    days = 14.0
days = max(1.0, days)
print(int(days) if days == int(days) else round(days, 1))
DAYS
)"
    [ "$days" != 1 ] || unit=day                                        # "kept 1 day"
    ok "$(L "Log folder: $LOG_PATH ($used, ${LOG_MAX_MB} MB × $((LOG_FILES + 1)) files, kept ${days} ${unit})" \
            "로그 폴더: $LOG_PATH ($used, 파일당 ${LOG_MAX_MB} MB × $((LOG_FILES + 1))개, ${days}일 보관)")"
  fi
  cmd_status
  (( FAILS == 0 ))
}

cmd_help() {   # the same text in each language, English first
  if [ "$UI_LANG" != ko ]; then
    cat <<EOF
${B}Sidenote${N}: solves the problems on your screen and in its sound in real time, with the local model and a cloud agent (Claude Code, Codex), and writes the answers in a panel.

  Start here: ./sidenote install, then ./sidenote llm pull, then ./sidenote capture --up

  ${B}Start and stop${N}
    ./sidenote install        First install: server, capture packages, shortcut, checks (--with-models adds the models)
    ./sidenote version        Versions of the installed parts
    ./sidenote up             Start the server (builds the image the first time). In use, it waits until idle, then restarts
    ./sidenote up --now       Restart at once, without waiting
    ./sidenote capture        Start the screen and sound capture: in Windows Python on WSL, on this desktop on Linux or a Mac.
                              It runs with a tray icon, and this command returns at once.
                              To end it: Quit in the tray icon, or ./sidenote capture-stop
                              Options: --up (starts the server first)   --monitor 2   --list-monitors
                                    --stitch (joins a long problem as you scroll)   --no-auto-stitch (never joins by itself)
                                    (the monitor and scroll joining are also in Solver settings in the panel)
                                    --no-audio   --audio-device "part of the device name"   --no-tray (no tray icon)
                                    --console (runs in this terminal, Ctrl+C ends it)   --once (sends one screen and ends)
                                    --no-auto-update (does not restart itself when new code is deployed)
    ./sidenote capture-restart  Restart the capture program now, into capture.py as it is (after a deploy it restarts by itself when quiet)
    ./sidenote open           Open the panel in the browser  ($URL)
    ./sidenote down           Stop everything
    ./sidenote restart        Restart the server (enough after changing .env or the code). In use, it waits until idle
                              (--now: at once)

  ${B}First time${N}
    ./sidenote login [codex]  Check the agent's login (Claude Code, or Codex with codex. Uses this PC's own login; on a Mac, a token in .env)
    ./sidenote setup-capture  Install the capture packages: into Windows Python on WSL, into .venv-capture on Linux or a Mac
                              (setup-windows is the same command)
    ./sidenote shortcut       On WSL, make a Windows desktop shortcut that starts the capture (--remove removes it)
    ./sidenote llm pull       Download the model that fits this PC's GPU, or the ones named (a few GB to tens of GB)
    ./sidenote llm list|logs  Downloaded models, the model server's log
    ./sidenote llm rm MODEL   Remove a downloaded model, with its tuned copy (asks first; --yes does not)

  ${B}History and settings${N}
    ./sidenote backup [FILE]  Copy the history and settings into one file (by default ./sidenote-backup-<date>-<time>.tar.gz)
    ./sidenote restore FILE   Put a backup's history and settings in place (what was there is kept beside; asks first, --yes does not)

  ${B}Status and logs${N}
    ./sidenote status         Server, local model, agent, capture and code runner status
    ./sidenote stats          Answers, tokens, cost, response times and the last error since the server started (--json)
    ./sidenote events         Recent events (-n 50, --errors for errors and stalls only)
    ./sidenote report         Summary by day and for the whole period (first token by engine, agent cost, GPU busy, example checks) (--days 30, --json)
    ./sidenote logs           Follow the server log
    ./sidenote doctor         Check the install
    ./sidenote capture-stop   End a capture program that is left running
    ./sidenote uninstall      List what was made on this PC and what stays (--yes removes it, --data the history and settings too)
    ./sidenote gpu status     Whether the local model holds the GPU now
    ./sidenote gpu off|on     Free the GPU for other work, and take it back (while off the agent solves everything, and a limit does not load the model again)

  ${B}For maintainers${N}
    ./sidenote qa [server|panel]  Run the suites CI runs, on this PC (the results table: results.md in the output folder)
    SIDENOTE_CI_GATE=1 in .env    up asks GitHub (gh) what CI said of this commit and does not deploy one that failed;
                                  status and doctor show the CI line. Off by default
    ./sidenote up --when-green    With the gate on: wait for CI, and deploy when it passes
    ./sidenote up --no-ci         With the gate on: deploy without asking CI

  Log folder: $LOG_PATH
EOF
    return 0
  fi
  cat <<KOHELP
${B}Sidenote${N}: 화면과 소리 속 문제를 이 PC의 모델과 클라우드 에이전트(Claude Code, Codex)가 실시간으로 풀어 패널에 적어 줍니다.

  처음에는 순서대로: ./sidenote install, ./sidenote llm pull, ./sidenote capture --up

  ${B}시작과 끝${N}
    ./sidenote install        처음 설치: 서버, 캡처 패키지, 바로가기, 점검 (--with-models면 모델까지)
    ./sidenote version        설치된 구성 요소의 버전
    ./sidenote up             서버 시작 (처음에는 이미지 빌드). 사용 중이면 쉴 때까지 기다린 뒤 다시 시작
    ./sidenote up --now       기다리지 않고 바로 다시 시작
    ./sidenote capture        화면과 소리 캡처 시작: WSL에서는 Windows Python으로, Linux와 맥에서는 이 데스크톱에서 실행.
                              트레이 아이콘으로 실행되고 이 명령은 바로 끝남.
                              끝내기: 트레이 아이콘의 끝내기, 또는 ./sidenote capture-stop
                              옵션: --up (서버부터 시작)   --monitor 2   --list-monitors
                                    --stitch (긴 문제를 스크롤하며 이어 붙임)   --no-auto-stitch (자동으로 이어 붙이지 않음)
                                    (모니터와 스크롤 이어 붙이기는 패널의 풀이 설정에서도 변경)
                                    --no-audio   --audio-device "장치 이름 일부"   --no-tray (트레이 아이콘 없음)
                                    --console (이 터미널에서 실행, Ctrl+C로 끝냄)   --once (화면 한 장만 보내고 끝냄)
                                    --no-auto-update (새 코드를 배포해도 자동으로 다시 시작하지 않음)
    ./sidenote capture-restart  캡처 프로그램을 지금의 capture.py로 바로 다시 시작 (배포 뒤에는 한가할 때 자동으로 다시 시작)
    ./sidenote open           패널을 브라우저로 열기  ($URL)
    ./sidenote down           모두 멈추기
    ./sidenote restart        서버 다시 시작 (.env나 코드를 바꾼 뒤에도 이것으로 충분). 사용 중이면 쉴 때까지 기다림
                              (--now: 바로)

  ${B}처음 한 번${N}
    ./sidenote login [codex]  에이전트 로그인 확인 (Claude Code, codex를 붙이면 Codex. 이 PC의 로그인을 그대로 사용, 맥은 .env의 토큰)
    ./sidenote setup-capture  캡처 패키지 설치: WSL에서는 Windows Python에, Linux와 맥에서는 .venv-capture에
                              (setup-windows도 같은 명령)
    ./sidenote shortcut       WSL에서 캡처를 시작하는 Windows 바탕화면 바로가기 만들기 (--remove로 삭제)
    ./sidenote llm pull       이 PC의 GPU에 맞는 모델 받기, 이름을 적으면 그 모델 (수 GB에서 수십 GB)
    ./sidenote llm list|logs  받아 둔 모델, 모델 서버 로그
    ./sidenote llm rm 모델    받아 둔 모델과 그 조정본 지우기 (먼저 묻고, --yes면 묻지 않음)

  ${B}기록과 설정${N}
    ./sidenote backup [파일]  기록과 설정을 파일 하나로 복사 (기본: ./sidenote-backup-<날짜>-<시각>.tar.gz)
    ./sidenote restore 파일   백업의 기록과 설정으로 바꾸기 (있던 것은 옆에 남김. 먼저 묻고, --yes면 묻지 않음)

  ${B}상태와 로그${N}
    ./sidenote status         서버, 이 PC의 모델, 에이전트, 캡처, 코드 실행기 상태
    ./sidenote stats          서버를 켠 뒤의 답 수, 토큰, 비용, 응답 시간, 마지막 오류 (--json)
    ./sidenote events         최근 이벤트 (-n 50, --errors는 오류와 멈춘 일만)
    ./sidenote report         날짜별 요약과 기간 전체 (엔진별 첫 토큰, 에이전트 비용, GPU 바쁨, 예제 검사) (--days 30, --json)
    ./sidenote logs           서버 로그 실시간 보기
    ./sidenote doctor         설치 점검
    ./sidenote capture-stop   남아 있는 캡처 프로그램 끄기
    ./sidenote uninstall      이 PC에 만든 것과 남기는 것 목록 (--yes를 붙이면 삭제, --data면 기록과 설정까지)
    ./sidenote gpu status     이 PC의 모델이 지금 GPU를 쓰는지 보기
    ./sidenote gpu off|on     다른 작업을 위해 GPU 비우기, 다시 쓰기 (끈 동안은 에이전트가 모두 풀고, 한도에 닿아도 모델을 다시 올리지 않음)

  ${B}개발자용${N}
    ./sidenote qa [server|panel]  CI가 실행하는 테스트 묶음을 이 PC에서 실행 (결과표: 출력 폴더의 results.md)
    .env의 SIDENOTE_CI_GATE=1     up이 GitHub(gh)에 이 커밋의 CI 결과를 묻고 실패한 커밋은 배포하지 않음.
                                  status와 doctor에 CI 줄 표시. 기본은 꺼짐
    ./sidenote up --when-green    CI 검사를 켰을 때: CI 결과를 기다렸다가 통과하면 배포
    ./sidenote up --no-ci         CI 검사를 켰을 때: CI를 묻지 않고 배포

  로그 폴더: $LOG_PATH
KOHELP
}

case "${1:-help}" in
  install) shift; cmd_install "$@" ;;
  version|--version) cmd_version ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  backup) shift; cmd_backup "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  up|start) shift
    for a in "$@"; do
      case "$a" in
        --now) UP_NOW=1 ;;
        --no-ci) UP_NO_CI=1 ;;
        --when-green) UP_WHEN_GREEN=1 ;;
        *) die "$(L "Unknown option: $a (./sidenote up [--now] [--no-ci] [--when-green])" "알 수 없는 옵션입니다: $a (./sidenote up [--now] [--no-ci] [--when-green])")" ;;
      esac
    done
    # Asked of a deploy, before its build, and only with the gate on; a restart or an install has its own reasons and
    # is not held up. --when-green asks for CI by name: without the gate that is refused, not deployed unchecked.
    if ci_gate_on; then ci_gate
    elif [ "${UP_WHEN_GREEN:-0}" = 1 ] && [ "${UP_NO_CI:-0}" != 1 ]; then
      die "$(L "--when-green waits for CI, and the CI check is off. Turn it on with SIDENOTE_CI_GATE=1 in .env" \
               "--when-green은 CI 결과를 기다리는데 CI 검사가 꺼져 있습니다. .env에 SIDENOTE_CI_GATE=1을 적어 켜세요")"
    fi
    cmd_up ;;
  qa) shift; cmd_qa "$@" ;;
  down|stop) cmd_down ;;
  restart) running || die "$(L "The server is off. ./sidenote up" "서버가 꺼져 있습니다. ./sidenote up")"
    case "${2:-}" in   # in use, it waits until idle as up does (wait_idle); --now restarts at once
      "") ;;
      --now) UP_NOW=1 ;;
      *) die "$(L "Unknown option: $2 (./sidenote restart [--now])" "알 수 없는 옵션입니다: $2 (./sidenote restart [--now])")" ;;
    esac
    # Not held up: a restart has its own reasons. But it builds what is here, and with the gate on says so if that has failed
    if ci_gate_on; then
      case "$(ci_state)" in
        failure|cancelled|timed_out|startup_failure)
          warn "$(L "This commit failed CI. Restarting with the code as it is." "이 커밋은 CI를 통과하지 못했습니다. 지금 코드로 다시 시작합니다.")" ;;
      esac
    fi
    cmd_up recreate ;;
  status) cmd_status ;;
  stats) shift
    running || die "$(L "The server is off. ./sidenote up (what happened while it was off: ./sidenote events)" "서버가 꺼져 있습니다. ./sidenote up (꺼져 있던 동안의 이벤트는 ./sidenote events)")"
    in_image stats "$@" ;;
  events) shift; in_image events "$@" ;;
  report) shift; in_image report "$@" ;;
  logs) cmd_logs ;;
  login) cmd_login "${2:-}" ;;
  capture) shift; cmd_capture "$@" ;;
  capture-stop) cmd_capture_stop ;;
  capture-restart) cmd_capture_restart ;;
  open) cmd_open ;;
  llm) shift; cmd_llm "$@" ;;
  gpu) shift; cmd_gpu "${1:-status}" ;;
  doctor) cmd_doctor ;;
  setup-capture|setup-windows) cmd_setup_capture ;;   # setup-windows: the name it had when capture ran on Windows only
  shortcut) shift; cmd_shortcut "$@" ;;
  help|-h|--help) cmd_help ;;
  *) printf '%s%s: %s%s\n\n' "$R" "$(L "Unknown command" "알 수 없는 명령입니다")" "$1" "$N" >&2; cmd_help; exit 1 ;;
esac
